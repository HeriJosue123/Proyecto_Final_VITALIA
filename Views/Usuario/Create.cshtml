@model VITALIA.Models.Usuario

@{
    ViewData["Title"] = "Registrar Usuario";
}

<div class="animate-fade-up py-4 d-flex justify-content-center">
    <div style="width: 100%; max-width: 680px;" class="px-3">

        <!-- Tarjeta Principal -->
        <div class="card border-0 rounded-4 shadow-sm overflow-hidden bg-white">

            <!-- Encabezado -->
            <div class="p-4 text-white d-flex justify-content-between align-items-start" style="background: linear-gradient(135deg, #14828a 0%, #093437 100%);">
                <div class="d-flex align-items-center gap-3">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white text-dark shadow-sm flex-shrink-0" style="width: 44px; height: 44px; color: #14828a !important;">
                        <i class="bi bi-person-plus fs-5"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-1">Registrar Nuevo Usuario</h4>
                        <p class="text-white-50 small mb-0">Ingrese las credenciales y el rol para el nuevo miembro del sistema</p>
                    </div>
                </div>
                <a asp-action="Index" class="btn btn-sm btn-light text-dark rounded-pill px-3 py-2 fw-semibold shadow-sm text-decoration-none text-nowrap ms-3">
                    ← Volver a Usuarios
                </a>
            </div>

            <!-- Cuerpo del Formulario -->
            <div class="card-body p-4 p-md-5">

                <form asp-action="Create" method="post" id="formUsuario" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 small" role="alert"></div>

                    <!-- CAMPO: CORREO ELECTRÓNICO -->
                    <div class="mb-4">
                        <label asp-for="Correo" class="fw-bold text-dark text-uppercase mb-1 d-block text-start" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                            <i class="bi bi-envelope me-1" style="color: #14828a;"></i> CORREO ELECTRÓNICO
                        </label>
                        <input asp-for="Correo" type="email" class="form-control rounded-3 shadow-none" placeholder="ejemplo@vitalia.com" autocomplete="off" style="border-color: #cbd5e1; padding: 0.6rem 0.8rem; font-size: 0.95rem;" />
                        <span asp-validation-for="Correo" class="text-danger small ms-1 d-block mt-1"></span>
                    </div>

                    <!-- CAMPO: CONTRASEÑA CON BOTÓN VER/OCULTAR Y VALIDACIÓN -->
                    <div class="mb-4">
                        <label class="fw-bold text-dark text-uppercase mb-1 d-block text-start" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                            <i class="bi bi-key me-1" style="color: #14828a;"></i> CONTRASEÑA
                        </label>
                        <div class="input-group">
                            <input type="password" name="Contrasena" id="passwordInput" class="form-control shadow-none" placeholder="••••••••" style="border-color: #cbd5e1; border-top-left-radius: 0.5rem; border-bottom-left-radius: 0.5rem; padding: 0.6rem 0.8rem; font-size: 0.95rem;" />
                            <button class="btn btn-outline-secondary px-3 shadow-none" type="button" id="togglePasswordBtn" style="border-color: #cbd5e1; border-top-right-radius: 0.5rem; border-bottom-right-radius: 0.5rem;">
                                <i class="bi bi-eye" id="toggleIcon"></i>
                            </button>
                        </div>
                        <span id="passwordError" class="text-danger small ms-1 d-block mt-1"></span>
                    </div>

                    <!-- CAMPO: ROL DEL SISTEMA -->
                    <div class="mb-4">
                        <label asp-for="IdRol" class="fw-bold text-dark text-uppercase mb-1 d-block text-start" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                            <i class="bi bi-shield-check me-1" style="color: #14828a;"></i> ROL DEL SISTEMA
                        </label>
                        <select asp-for="IdRol" class="form-select rounded-3 shadow-none" asp-items="ViewBag.IdRol" style="border-color: #cbd5e1; padding: 0.6rem 0.8rem; font-size: 0.95rem;">
                            <option value="">-- Seleccione un rol --</option>
                        </select>
                        <span asp-validation-for="IdRol" class="text-danger small ms-1 d-block mt-1"></span>
                    </div>

                    <!-- BOTONES DE ACCIÓN -->
                    <div class="d-flex gap-2 pt-4 mt-4 border-top">
                        <a asp-action="Index" class="btn btn-light rounded-3 py-2.5 px-4 fw-semibold text-secondary flex-grow-1 text-center text-decoration-none">
                            Cancelar
                        </a>
                        <button type="submit" class="btn text-white fw-bold rounded-3 py-2.5 px-4 shadow-sm flex-grow-1 d-flex align-items-center justify-content-center gap-2" style="background: linear-gradient(135deg, #14828a 0%, #093437 100%); transition: all 0.2s ease;">
                            <i class="bi bi-save-fill"></i> Guardar Usuario
                        </button>
                    </div>
                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (window.jQuery && $.validator) {
                $.extend($.validator.messages, {
                    required: "Este campo es obligatorio.",
                    email: "Ingrese un correo electrónico válido."
                });
            }

            const togglePasswordBtn = document.getElementById('togglePasswordBtn');
            if (togglePasswordBtn) {
                togglePasswordBtn.addEventListener('click', function () {
                    const passwordInput = document.getElementById('passwordInput');
                    const toggleIcon = document.getElementById('toggleIcon');
                    if (passwordInput.type === 'password') {
                        passwordInput.type = 'text';
                        toggleIcon.classList.remove('bi-eye');
                        toggleIcon.classList.add('bi-eye-slash');
                    } else {
                        passwordInput.type = 'password';
                        toggleIcon.classList.remove('bi-eye-slash');
                        toggleIcon.classList.add('bi-eye');
                    }
                });
            }

            const correoInput = document.getElementById('Correo');
            const correoError = document.querySelector('[data-valmsg-for="Correo"]');

            const passwordInput = document.getElementById('passwordInput');
            const passwordError = document.getElementById('passwordError');

            const rolSelect = document.getElementById('IdRol');
            const rolError = document.querySelector('[data-valmsg-for="IdRol"]');

            const formUsuario = document.getElementById('formUsuario');

            function validarCorreo() {
                if (!correoInput) return true;
                const val = correoInput.value.trim();
                const regexCorreo = /^[^\s\x40]+[^\s\x40]*\x40[^\s\x40]+\.[^\s\x40]+$/;

                if (val.length === 0) {
                    if (correoError) correoError.textContent = "El correo electrónico es obligatorio.";
                    correoInput.classList.add("is-invalid");
                    return false;
                } else if (!regexCorreo.test(val)) {
                    if (correoError) correoError.textContent = "Ingrese una dirección de correo válida (ej. usuario\x40vitalia.com).";
                    correoInput.classList.add("is-invalid");
                    return false;
                } else {
                    if (correoError) correoError.textContent = "";
                    correoInput.classList.remove("is-invalid");
                    return true;
                }
            }

            function validarContrasena() {
                if (!passwordInput) return true;
                const val = passwordInput.value;
                let faltantes = [];

                // REGLA: MÍNIMO 8 CARACTERES
                if (val.length < 8) {
                    faltantes.push("mínimo 8 caracteres");
                }
                if (!/[A-Z]/.test(val)) {
                    faltantes.push("una letra mayúscula (A-Z)");
                }
                if (!/[0-9]/.test(val)) {
                    faltantes.push("un número (0-9)");
                }
                if (!/[!\x40#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?*]/.test(val)) {
                    faltantes.push("un carácter especial (ej. *, #, $)");
                }

                if (val.length === 0) {
                    if (passwordError) passwordError.textContent = "La contraseña es obligatoria.";
                    passwordInput.classList.add("is-invalid");
                    return false;
                } else if (faltantes.length > 0) {
                    if (passwordError) passwordError.textContent = "La contraseña debe incluir: " + faltantes.join(", ") + ".";
                    passwordInput.classList.add("is-invalid");
                    return false;
                } else {
                    if (passwordError) passwordError.textContent = "";
                    passwordInput.classList.remove("is-invalid");
                    return true;
                }
            }

            function validarRol() {
                if (!rolSelect) return true;
                const val = rolSelect.value;
                if (!val) {
                    if (rolError) rolError.textContent = "Debe seleccionar un rol del sistema.";
                    rolSelect.classList.add("is-invalid");
                    return false;
                } else {
                    if (rolError) rolError.textContent = "";
                    rolSelect.classList.remove("is-invalid");
                    return true;
                }
            }

            if (correoInput) {
                correoInput.addEventListener('input', validarCorreo);
                correoInput.addEventListener('blur', validarCorreo);
            }

            if (passwordInput) {
                passwordInput.addEventListener('input', validarContrasena);
                passwordInput.addEventListener('blur', validarContrasena);
            }

            if (rolSelect) {
                rolSelect.addEventListener('change', validarRol);
                rolSelect.addEventListener('blur', validarRol);
            }

            if (formUsuario) {
                formUsuario.addEventListener('submit', function (e) {
                    const okCorreo = validarCorreo();
                    const okPass = validarContrasena();
                    const okRol = validarRol();

                    if (!okCorreo || !okPass || !okRol) {
                        e.preventDefault();
                    }
                });
            }
        });
    </script>
}