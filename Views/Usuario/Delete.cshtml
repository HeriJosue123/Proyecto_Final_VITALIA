@model VITALIA.Models.Usuario

@{
    ViewData["Title"] = "Eliminar Usuario";
}

<!-- Contenedor ajustado con altura fija relativa a la ventana para centrado exacto -->
<div class="d-flex justify-content-center align-items-center w-100 animate-fade-up" style="height: 85vh;">
    <div style="width: 100%; max-width: 500px;">

        <!-- Tarjeta Principal de Eliminación -->
        <div class="card border-0 rounded-4 shadow-sm overflow-hidden bg-white">
            
            <!-- Encabezado Rojo -->
            <div class="py-3 px-4 text-center text-white" style="background: linear-gradient(135deg, #dc3545 0%, #a71d2a 100%);">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white text-danger shadow-sm mb-2" style="width: 44px; height: 44px;">
                    <i class="bi bi-person-x-fill fs-5"></i>
                </div>
                <h5 class="fw-bold mb-1">Confirmar Eliminación</h5>
                <p class="text-white small mb-0 opacity-90 fw-medium" style="font-size: 0.85rem;">¿Desea eliminar permanentemente este usuario?</p>
            </div>

            <div class="card-body p-3">
                
                <!-- Advertencia -->
                <div class="p-3 px-3 rounded-3 mb-3 d-flex align-items-center gap-2" style="background-color: #fff5f5; border-left: 4px solid #dc3545;">
                    <i class="bi bi-exclamation-octagon-fill text-danger fs-6 flex-shrink-0"></i>
                    <div class="small text-danger-emphasis fw-medium" style="font-size: 0.80rem;">
                        <strong>Atención:</strong> Esta acción deshabilitará o eliminará definitivamente las credenciales de acceso de esta cuenta.
                    </div>
                </div>

                <!-- Correo Electrónico -->
                <div class="bg-light p-3 rounded-3 mb-3 border border-light-subtle">
                    <span class="text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.6px;">
                        CORREO ELECTRÓNICO
                    </span>
                    <span class="fs-6 fw-bold text-dark d-block lh-base">@Model.Correo</span>
                </div>

                <!-- Grilla de Detalle -->
                <div class="row g-2 mb-3">
                    <!-- Rol Asignado -->
                    <div class="col-6">
                        <div class="p-2 px-3 rounded-3 bg-body-tertiary h-100">
                            <span class="text-uppercase fw-bold text-muted d-block mb-2" style="font-size: 0.62rem; letter-spacing: 0.5px;">ROL ASIGNADO</span>
                            <div class="fw-bold text-dark lh-sm" style="font-size: 0.85rem;">
                                <i class="bi bi-person-badge me-1 text-muted"></i>@(Model.IdRolNavigation?.NombreRol ?? "Sin Rol")
                            </div>
                        </div>
                    </div>

                    <!-- Estado Actual -->
                    <div class="col-6">
                        <div class="p-2 px-3 rounded-3 bg-body-tertiary h-100">
                            <span class="text-uppercase fw-bold text-muted d-block mb-2" style="font-size: 0.62rem; letter-spacing: 0.5px;">ESTADO ACTUAL</span>
                            @if (Model.Estado == true)
                            {
                                <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle fw-semibold px-2 py-1" style="font-size: 0.75rem;">
                                    <i class="bi bi-check-circle-fill me-1"></i>Activo
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle fw-semibold px-2 py-1" style="font-size: 0.75rem;">
                                    <i class="bi bi-dash-circle-fill me-1"></i>Inactivo
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Botones de Acción (Formulario corregido) -->
                <form action="@Url.Action("Delete", "Usuario", new { id = Model.IdUsuario })" method="post" class="pt-1">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="IdUsuario" />

                    <div class="row g-2">
                        <div class="col-6">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-3 py-2 fw-semibold w-100 d-flex align-items-center justify-content-center border-2 transition-all" style="font-size: 0.85rem;">
                                <i class="bi bi-x-circle fs-6 me-2"></i> Cancelar
                            </a>
                        </div>
                        <div class="col-6">
                            <button type="submit" class="btn btn-danger rounded-3 py-2 fw-bold shadow-sm w-100 d-flex align-items-center justify-content-center transition-all" style="background-color: #dc3545; font-size: 0.85rem;">
                                <i class="bi bi-trash-fill fs-6 me-2"></i> Confirmar
                            </button>
                        </div>
                    </div>
                </form>

            </div>
        </div>

    </div>
</div>

<style>
    /* Congela la pantalla completa evitando cualquier tipo de scroll */
    body {
        overflow: hidden !important;
    }
    
    .transition-all {
        transition: all 0.2s ease-in-out;
    }
    .transition-all:hover {
        transform: translateY(-1px);
    }
</style>