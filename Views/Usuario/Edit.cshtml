@model VITALIA.Models.Usuario

@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="animate-fade-up py-4 d-flex justify-content-center">
    <div style="width: 100%; max-width: 680px;" class="px-3">

        <!-- Tarjeta Principal con Encabezado Verde Integrado (Estilo Editar Alerta) -->
        <div class="card border-0 rounded-4 shadow-sm overflow-hidden bg-white">
            
            <!-- Encabezado Estilo Bloque Verde (De borde a borde) -->
            <div class="p-4 text-white d-flex align-items-center justify-content-between flex-wrap gap-3" style="background: linear-gradient(135deg, #14828a 0%, #093437 100%);">
                <div class="d-flex align-items-center gap-3">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white text-dark shadow-sm" style="width: 44px; height: 44px; color: #14828a !important;">
                        <i class="bi bi-person-gear fs-5"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0">Editar Usuario</h4>
                        <p class="text-white-50 small mb-0">Modifique la información, contraseña y permisos de la cuenta</p>
                    </div>
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-sm btn-light text-dark rounded-pill px-3 py-1.5 fw-semibold shadow-sm text-decoration-none">
                        ← Volver a Usuarios
                    </a>
                </div>
            </div>

            <!-- Cuerpo del Formulario -->
            <div class="card-body p-4">
                
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm rounded-3 mb-3 small" role="alert"></div>

                    <input type="hidden" asp-for="IdUsuario" />

                    <!-- CAMPO: CORREO ELECTRÓNICO -->
                    <div class="mb-4">
                        <label asp-for="Correo" class="form-label fw-bold text-dark small text-uppercase tracking-wider mb-2 d-block text-start">
                            <i class="bi bi-envelope text-primary me-1"></i> Correo Electrónico
                        </label>
                        <input asp-for="Correo" type="email" class="form-control form-control-lg rounded-3 fs-6 shadow-none" required style="border-color: #cbd5e1; padding: 0.75rem 1rem;" />
                        <span asp-validation-for="Correo" class="text-danger small ms-1"></span>
                    </div>

                    <!-- CAMPO: NUEVA CONTRASEÑA -->
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark small text-uppercase tracking-wider mb-2 d-block text-start">
                            <i class="bi bi-key text-primary me-1"></i> Nueva Contraseña <span class="text-muted fw-normal text-lowercase">(opcional)</span>
                        </label>
                        <div class="input-group">
                            <input type="password" name="NuevaContrasena" id="passwordInput" class="form-control form-control-lg fs-6 shadow-none" placeholder="Dejar en blanco para mantener la actual" style="border-color: #cbd5e1; border-top-left-radius: 0.5rem; border-bottom-left-radius: 0.5rem; padding: 0.75rem 1rem;" />
                            <button class="btn btn-outline-secondary px-3 shadow-none" type="button" id="togglePasswordBtn" style="border-color: #cbd5e1; border-top-right-radius: 0.5rem; border-bottom-right-radius: 0.5rem;">
                                <i class="bi bi-eye" id="toggleIcon"></i>
                            </button>
                        </div>
                    </div>

                    <!-- CAMPO: ROL DEL SISTEMA -->
                    <div class="mb-4">
                        <label asp-for="IdRol" class="form-label fw-bold text-dark small text-uppercase tracking-wider mb-2 d-block text-start">
                            <i class="bi bi-shield-check text-primary me-1"></i> Rol del Sistema
                        </label>
                        <select asp-for="IdRol" class="form-select form-select-lg rounded-3 fs-6 shadow-none" asp-items="ViewBag.IdRol" required style="border-color: #cbd5e1; padding: 0.75rem 1rem;"></select>
                        <span asp-validation-for="IdRol" class="text-danger small ms-1"></span>
                    </div>

                    <!-- CAMPO: ESTADO DE CUENTA -->
                    <div class="mb-4 p-3 rounded-3 bg-light border border-light-subtle">
                        <div class="form-check form-switch d-flex align-items-center justify-content-between ps-0">
                            <label class="form-check-label fw-bold text-dark small text-uppercase tracking-wider mb-0" for="switchEstado">
                                Estado de la Cuenta
                            </label>
                            <input class="form-check-input ms-auto shadow-none" type="checkbox" asp-for="Estado" id="switchEstado" style="width: 2.8em; height: 1.4em; cursor: pointer;">
                        </div>
                    </div>

                    <!-- BOTÓN DE GUARDAR CAMBIOS (Idéntico al de Editar Alerta) -->
                    <div class="pt-2">
                        <button type="submit" class="btn text-white fw-bold rounded-3 py-3 w-100 shadow-sm d-flex align-items-center justify-content-center gap-2" style="background: linear-gradient(135deg, #14828a 0%, #093437 100%); transition: all 0.2s ease;">
                            <i class="bi bi-check-circle-fill"></i> Guardar Cambios
                        </button>
                    </div>
                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('togglePasswordBtn').addEventListener('click', function () {
            const passwordInput = document.getElementById('passwordInput');
            const toggleIcon = document.getElementById('toggleIcon');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.classList.remove('bi-eye');
                toggleIcon.classList.add('bi-eye-slash');
            } else {
                passwordInput.type = 'password';
                toggleIcon.classList.remove('bi-eye-slash');
                toggleIcon.classList.add('bi-eye');
            }
        });
    </script>
}

<style>
    .form-check-input:checked {
        background-color: #14828a;
        border-color: #14828a;
    }
</style>