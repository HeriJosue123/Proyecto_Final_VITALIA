@model VITALIA.Models.Usuario

@{
    ViewData["Title"] = "Detalles de Usuario";
}

<div class="animate-fade-up py-4 d-flex justify-content-center">
    <div style="width: 100%; max-width: 680px;" class="px-3">

        <!-- Tarjeta Principal con Encabezado Verde Integrado -->
        <div class="card border-0 rounded-4 shadow-sm overflow-hidden bg-white">
            
            <!-- Encabezado Estilo Bloque Verde (De borde a borde) -->
            <div class="p-4 text-white d-flex align-items-center justify-content-between flex-wrap gap-3" style="background: linear-gradient(135deg, #14828a 0%, #093437 100%);">
                <div class="d-flex align-items-center gap-3">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white text-dark shadow-sm flex-shrink-0" style="width: 44px; height: 44px; color: #14828a !important;">
                        <i class="bi bi-person-gear fs-5"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h4 class="fw-bold mb-0">Detalles de Usuario</h4>
                            <span class="badge bg-white bg-opacity-25 text-white border border-white border-opacity-25 rounded-pill px-3 py-1" style="font-size: 0.75rem;">
                                ID: #@Model.IdUsuario
                            </span>
                        </div>
                        <p class="text-white-50 small mb-0">Información de la cuenta de acceso al sistema</p>
                    </div>
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-sm btn-light text-dark rounded-pill px-3 py-1.5 fw-semibold shadow-sm text-decoration-none">
                        ← Volver a Usuarios
                    </a>
                </div>
            </div>

            <!-- Cuerpo de la Tarjeta -->
            <div class="card-body p-4 p-md-5">

                <!-- Bloque Principal de Correo de la Cuenta -->
                <div class="p-3 rounded-3 bg-light border border-light-subtle mb-4">
                    <span class="text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                        CORREO ELECTRÓNICO DE ACCESO
                    </span>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-envelope-at fs-5" style="color: #14828a;"></i>
                        <span class="fw-bold text-dark fs-5 mb-0">@Model.Correo</span>
                    </div>
                </div>

                <!-- Grilla de Detalle de 2 Columnas -->
                <div class="row g-3 mb-4">
                    <!-- Rol Asignado -->
                    <div class="col-sm-6">
                        <div class="p-3 rounded-3 bg-light border border-light-subtle h-100">
                            <span class="text-uppercase fw-bold text-muted d-block mb-2" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                ROL ASIGNADO
                            </span>
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-shield-check fs-5" style="color: #14828a;"></i>
                                <span class="fw-bold text-dark fs-6">
                                    @(Model.IdRolNavigation?.NombreRol ?? "Sin Rol Asignado")
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Estado de la Cuenta -->
                    <div class="col-sm-6">
                        <div class="p-3 rounded-3 bg-light border border-light-subtle h-100">
                            <span class="text-uppercase fw-bold text-muted d-block mb-2" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                ESTADO DE CUENTA
                            </span>
                            <div>
                                @if (Model.Estado == true)
                                {
                                    <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle fw-semibold px-3 py-1 rounded-pill" style="font-size: 0.85rem;">
                                        <i class="bi bi-check-circle-fill me-1"></i> Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle fw-semibold px-3 py-1 rounded-pill" style="font-size: 0.85rem;">
                                        <i class="bi bi-dash-circle-fill me-1"></i> Inactivo
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Botones de Acción Balanceados a Ancho Completo -->
                <div class="d-flex gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light rounded-3 py-2.5 px-4 fw-semibold text-secondary flex-grow-1 text-center text-decoration-none">
                        Cerrar
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.IdUsuario" class="btn text-white fw-bold rounded-3 py-2.5 px-4 shadow-sm flex-grow-1 d-flex align-items-center justify-content-center gap-2" style="background: linear-gradient(135deg, #14828a 0%, #093437 100%); transition: all 0.2s ease;">
                        <i class="bi bi-pencil-square"></i> Editar Cuenta
                    </a>
                </div>

            </div>
        </div>

    </div>
</div>