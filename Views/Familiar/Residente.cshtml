@model VITALIA.Models.ViewModels.FamiliarFichaViewModel
@{
    var r = Model.Residente;
    ViewData["Title"] = r.Nombre + " " + r.Apellido;
    var iniciales = string.Concat((r.Nombre + " " + r.Apellido).Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));

    string ColorPrioridad(string p) => p switch
    {
        "Urgente" => "bg-danger-subtle text-danger-emphasis border-danger-subtle",
        "Programada" => "bg-info-subtle text-info-emphasis border-info-subtle",
        _ => "bg-secondary-subtle text-secondary-emphasis border-secondary-subtle"
    };
    string ColorEstado(string e) => e switch
    {
        "Pendiente" => "bg-warning-subtle text-warning-emphasis border-warning-subtle",
        "En Proceso" => "bg-primary-subtle text-primary-emphasis border-primary-subtle",
        _ => "bg-success-subtle text-success border-success-subtle"
    };
    var diasBitacora = Model.Atenciones.GroupBy(a => a.FechaHora.Date);
}

<div class="vitalia-banner d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="rounded-circle bg-white fw-bold d-flex align-items-center justify-content-center flex-shrink-0"
             style="width: 56px; height: 56px; color: #0d3c3d; font-size: 1.2rem;">@iniciales</div>
        <div>
            <h3 class="fw-bold mb-1">@r.Nombre @r.Apellido</h3>
            <p class="text-muted mb-0">@r.CodigoUnico · @Model.Edad años · Hab. @r.NumHabitacion · Usted es su @Model.Parentesco.ToLower()</p>
        </div>
    </div>
    <div class="d-flex gap-2">
        @* UC-11: exportar el historial del residente a PDF *@
        <a asp-action="ExportarPdf" asp-route-id="@r.IdResidente" class="btn text-nowrap">
            <i class="bi bi-file-earmark-pdf me-1"></i> Descargar historial en PDF
        </a>
        <a asp-action="Index" class="btn text-nowrap">← Volver</a>
    </div>
</div>

<div class="alert alert-light border small rounded-3 mb-4">
    <i class="bi bi-eye me-1"></i> Esta ficha es de <strong>solo lectura</strong>. Si algún dato no es correcto, comuníquelo al personal de VITALIA.
</div>

<div class="row g-4">
    @* Columna izquierda: datos, salud y equipo *@
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-person-vcard me-1 text-primary"></i> Datos generales</h6>
            <div class="row g-3 small">
                <div class="col-6">
                    <div class="text-muted text-uppercase fw-bold" style="font-size: .65rem;">Nacimiento</div>
                    <div class="fw-semibold text-dark">@r.FechaNacimiento.ToString("dd/MM/yyyy")</div>
                </div>
                <div class="col-6">
                    <div class="text-muted text-uppercase fw-bold" style="font-size: .65rem;">Tipo de sangre</div>
                    <div class="fw-semibold text-dark">@(r.TipoSangre ?? "No registrado")</div>
                </div>
                <div class="col-6">
                    <div class="text-muted text-uppercase fw-bold" style="font-size: .65rem;">Habitación</div>
                    <div class="fw-semibold text-dark">@r.NumHabitacion</div>
                </div>
                <div class="col-6">
                    <div class="text-muted text-uppercase fw-bold" style="font-size: .65rem;">Contacto de emergencia</div>
                    <div class="fw-semibold text-dark">@r.ContactoEmergencia</div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-heart-pulse me-1 text-danger"></i> Salud</h6>
            <div class="small mb-3">
                <div class="text-muted text-uppercase fw-bold" style="font-size: .65rem;">Alergias</div>
                <div class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(r.Alergias) ? "Ninguna registrada" : r.Alergias)</div>
            </div>
            <div class="small">
                <div class="text-muted text-uppercase fw-bold" style="font-size: .65rem;">Antecedentes / observaciones</div>
                <div class="text-dark bg-light rounded-3 p-2 mt-1">@(string.IsNullOrWhiteSpace(r.Observaciones) ? "Sin observaciones" : r.Observaciones)</div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-people me-1 text-success"></i> Personal que lo atiende</h6>
            @if (Model.Equipo.Any())
            {
                foreach (var e in Model.Equipo)
                {
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="rounded-circle text-white d-flex align-items-center justify-content-center flex-shrink-0 @(e.Tipo == "Médico" ? "bg-primary" : "bg-success")" style="width: 40px; height: 40px;">
                            <i class="bi @(e.Tipo == "Médico" ? "bi-clipboard2-pulse" : "bi-person-heart")"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark small">@e.Nombre</div>
                            <small class="text-muted" style="font-size: .75rem;">@e.Cargo · @e.Tipo.ToLower() desde @e.Desde.ToString("dd/MM/yyyy")</small>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="small text-muted mb-0">Todavía no tiene personal asignado.</p>
            }
        </div>
    </div>

    @* Columna derecha: alertas y bitácora *@
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-bell me-1 text-warning"></i> Alertas y tareas activas</h6>
            @if (Model.AlertasActivas.Any())
            {
                foreach (var a in Model.AlertasActivas)
                {
                    <div class="border rounded-3 p-3 mb-2">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                            <div class="fw-bold text-dark">@a.Titulo</div>
                            <div class="d-flex gap-1">
                                <span class="badge border rounded-pill @ColorPrioridad(a.Prioridad)">@a.Prioridad</span>
                                <span class="badge border rounded-pill @ColorEstado(a.Estado)">@a.Estado</span>
                            </div>
                        </div>
                        <div class="small text-muted mt-1">@a.Descripcion</div>
                        <div class="small text-muted mt-2" style="font-size: .75rem;">
                            <i class="bi bi-calendar-event me-1"></i>@a.FechaProgramada.ToString("dd/MM/yyyy HH:mm")
                            @if (a.Responsable != null)
                            {
                                <span class="ms-2"><i class="bi bi-person me-1"></i>@a.Responsable</span>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="small text-muted mb-0">No hay alertas activas.</p>
            }

            @if (Model.AlertasAtendidas.Any())
            {
                <details class="mt-3">
                    <summary class="small fw-semibold text-muted">Ver alertas ya atendidas (@Model.AlertasAtendidas.Count)</summary>
                    <div class="mt-2">
                        @foreach (var a in Model.AlertasAtendidas)
                        {
                            <div class="border rounded-3 p-3 mb-2 bg-light">
                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                                    <div class="fw-semibold text-dark small">@a.Titulo</div>
                                    <span class="badge border rounded-pill @ColorEstado(a.Estado)">@a.Estado</span>
                                </div>
                                <div class="small text-muted mt-1">@a.Descripcion</div>
                                <div class="text-muted mt-1" style="font-size: .72rem;"><i class="bi bi-calendar-check me-1"></i>@a.FechaProgramada.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        }
                    </div>
                </details>
            }
        </div>

        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-capsule me-1" style="color: #14828a;"></i> Medicamentos que recibe</h6>
            @if (!Model.MedicamentosDisponibles)
            {
                <p class="small text-muted mb-0">La información de medicamentos todavía no está disponible.</p>
            }
            else if (Model.Medicamentos.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0 small">
                        <thead class="text-muted" style="font-size: .7rem;">
                            <tr>
                                <th class="fw-bold text-uppercase">Fecha</th>
                                <th class="fw-bold text-uppercase">Medicamento</th>
                                <th class="fw-bold text-uppercase text-center">Cantidad</th>
                                <th class="fw-bold text-uppercase">Entregado por</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in Model.Medicamentos)
                            {
                                <tr>
                                    <td class="text-nowrap">@m.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@m.Medicamento</div>
                                        @if (!string.IsNullOrWhiteSpace(m.Presentacion))
                                        {
                                            <div class="text-muted" style="font-size: .72rem;">@m.Presentacion</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(m.Observaciones))
                                        {
                                            <div class="text-muted fst-italic" style="font-size: .72rem;">@m.Observaciones</div>
                                        }
                                    </td>
                                    <td class="text-center">@m.Cantidad</td>
                                    <td class="text-nowrap">@m.EntregadoPor</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="small text-muted mb-0">Todavía no hay entregas de medicamentos registradas.</p>
            }
        </div>

        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-journal-medical me-1 text-primary"></i> Bitácora de atenciones</h6>
            @if (Model.Atenciones.Any())
            {
                foreach (var dia in diasBitacora)
                {
                    <div class="text-uppercase fw-bold text-muted mt-3 mb-2" style="font-size: .7rem; letter-spacing: .5px;">
                        @(dia.Key == DateTime.Today ? "Hoy" : dia.Key == DateTime.Today.AddDays(-1) ? "Ayer" : dia.Key.ToString("dddd dd 'de' MMMM yyyy"))
                    </div>
                    foreach (var a in dia)
                    {
                        <div class="d-flex gap-3 mb-3">
                            <div class="text-muted small text-nowrap pt-1" style="width: 48px;">@a.FechaHora.ToString("HH:mm")</div>
                            <div class="flex-grow-1 border-start ps-3">
                                <span class="badge bg-primary-subtle text-primary-emphasis rounded-pill">@a.Tipo</span>
                                <div class="small text-dark mt-1">@a.Observaciones</div>
                                <div class="text-muted" style="font-size: .72rem;"><i class="bi bi-person me-1"></i>Atendido por @a.AtendidoPor</div>
                                @if (a.MotivoCorreccion != null)
                                {
                                    <div class="small mt-1 text-warning-emphasis"><i class="bi bi-pencil-square me-1"></i>Registro corregido: @a.MotivoCorreccion</div>
                                }
                            </div>
                        </div>
                    }
                }
            }
            else
            {
                <p class="small text-muted mb-0">Todavía no hay atenciones registradas.</p>
            }
        </div>
    </div>
</div>
