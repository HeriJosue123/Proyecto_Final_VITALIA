@model VITALIA.Models.ViewModels.RespaldoViewModel
@{
    ViewData["Title"] = "Generar Respaldo";
}

<div class="container mt-3">
    <!-- Botón Volver -->
    <a asp-action="Index" class="text-decoration-none text-muted fw-medium d-inline-flex align-items-center mb-4 transition-all" style="font-size: 0.9rem;">
        <i class="bi bi-arrow-left me-2"></i> Volver a Respaldos
    </a>

    <!-- Encabezado -->
    <div class="text-center mb-4 animate-fade-up">
        <div class="d-inline-flex align-items-center justify-content-center rounded-circle text-white mb-3 shadow-sm" style="width: 56px; height: 56px; background-color: var(--vitalia-primary);">
            <i class="bi bi-hdd-fill fs-3"></i>
        </div>
        <h3 class="fw-bold text-dark mb-1">Generar Nuevo Respaldo</h3>
        <p class="text-muted small">Cree una copia de seguridad de la base de datos del sistema</p>
    </div>

    <!-- Tarjeta Principal -->
    <div class="card border-0 rounded-4 shadow-sm mx-auto animate-fade-up" style="max-width: 550px; border-top: 4px solid var(--vitalia-primary) !important; animation-delay: 0.1s;">
        <div class="card-body p-4 p-md-5">
            
            <div class="d-flex align-items-center gap-3 p-3 mb-4 rounded-3" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                <i class="bi bi-info-circle-fill fs-4" style="color: var(--vitalia-primary);"></i>
                <p class="mb-0 small text-secondary fw-medium">
                    Al confirmar, el sistema generará un archivo <strong>.bak</strong> con toda la información actual. Este proceso es seguro y puede tardar unos segundos.
                </p>
            </div>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>
                
                <hr class="border-light-subtle my-4" />

                <div class="row g-3">
                    <div class="col-sm-6">
                        <a asp-action="Index" class="btn btn-light w-100 fw-semibold py-2 rounded-3 text-secondary border">
                            Cancelar
                        </a>
                    </div>
                    <div class="col-sm-6">
                        <button type="submit" class="btn btn-primary w-100 fw-semibold py-2 rounded-3 shadow-sm d-flex justify-content-center align-items-center">
                            <i class="bi bi-check-circle-fill me-2"></i> Generar Respaldo
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>