@model IEnumerable<VITALIA.Models.ViewModels.RespaldoViewModel>
@{
    ViewData["Title"] = "Respaldos";
}<div class="vitalia-banner mb-4 animate-fade-up">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="mb-1 fw-bold text-white">Copias de Seguridad</h2>
            <p class="mb-0 text-white-50">Lista de respaldos generados del sistema.</p>
        </div>
        <a asp-action="Create" class="btn btn-light px-4 shadow-sm rounded-pill fw-semibold text-primary">
            <i class="bi bi-plus-circle-fill me-2"></i> Nuevo Respaldo
        </a>
    </div></div>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4 animate-fade-up">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}<div class="vitalia-card-pro p-0 overflow-hidden animate-fade-up" style="animation-delay: 0.1s;">
    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-hdd text-muted" style="font-size: 3rem;"></i>
            <h5 class="mt-3 fw-bold">No hay respaldos</h5>
            <p class="small mb-0">Genere su primera copia de seguridad utilizando el botón superior.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 py-3 text-muted small text-uppercase fw-bold">Nombre de Archivo</th>
                        <th class="py-3 text-muted small text-uppercase fw-bold">Fecha de Creación</th>
                        <th class="py-3 text-muted small text-uppercase fw-bold">Tamaño</th>
                        <th class="pe-4 py-3 text-end text-muted small text-uppercase fw-bold">Acciones</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 py-3 text-primary fw-semibold">
                                <i class="bi bi-file-earmark-zip text-secondary me-2"></i>@item.NombreArchivo
                            </td>
                            <td class="py-3">@item.FechaCreacion.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td class="py-3"><span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-semibold">@item.Tamaño</span></td>
                            <td class="pe-4 py-3 text-end">
                                <div class="d-inline-flex justify-content-end align-items-center gap-2">
                                    <a asp-action="Download" asp-route-id="@item.NombreArchivo" class="btn btn-sm rounded-3 px-3 py-1 fw-semibold text-nowrap" style="color: #14828a; border: 1px solid #14828a; background-color: transparent;">
                                        <i class="bi bi-download me-1"></i>Descargar
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.NombreArchivo" class="btn btn-sm btn-outline-danger rounded-3 px-3 py-1 fw-semibold text-nowrap">
                                        <i class="bi bi-trash me-1"></i>Eliminar
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }</div>