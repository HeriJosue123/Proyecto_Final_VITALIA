@{
    ViewData["Title"] = "Panel de Farmacia";
}

<div class="container-fluid px-4 py-3">
    <!-- Banner de Bienvenida exclusivo para Farmacia -->
    <div class="vitalia-banner mb-4 animate-fade-up">
        <div class="row align-items-center">
            <div class="col-md-8">
                <span class="badge bg-white text-dark mb-2 px-3 py-1 rounded-pill fw-bold">Módulo de Farmacia y Stock</span>
                <h2 class="fw-bold mb-1">Panel de Control Farmacéutico</h2>
                <p class="mb-0 text-muted">Gestión de medicamentos, control de lotes y existencias del centro gerontológico VITALIA.</p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <!-- Botón directo para descargar el respaldo en PDF que ya creamos -->
                <a asp-controller="Farmacia" asp-action="RespaldoMedicamentosPdf" class="btn btn-light shadow-sm">
                    <i class="bi bi-file-earmark-pdf-fill me-2 text-danger"></i> Descargar Respaldo PDF
                </a>
            </div>
        </div>
    </div>

    <!-- Tarjetas de Acceso Rápido / Resumen -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="vitalia-card-pro p-4 h-100 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-uppercase fw-bold text-muted small d-block mb-1">Catálogo General</span>
                    <h4 class="fw-bold text-dark mb-2">Inventario de Medicamentos</h4>
                    <p class="text-muted small mb-3">Consulte los medicamentos activos, stock disponible y fechas de vencimiento de los lotes.</p>
                    <a asp-controller="Farmacia" asp-action="Index" class="btn btn-primary btn-sm px-3">
                        <i class="bi bi-capsule me-1"></i> Ver Catálogo Completo
                    </a>
                </div>
                <div class="p-3 rounded-4 bg-light text-primary fs-2">
                    <i class="bi bi-box-seam"></i>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="vitalia-card-pro p-4 h-100 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-uppercase fw-bold text-muted small d-block mb-1">Registro de Lotes</span>
                    <h4 class="fw-bold text-dark mb-2">Agregar Nuevo Lote</h4>
                    <p class="text-muted small mb-3">Ingrese nuevos suministros o lotes al sistema manteniendo el control de entradas.</p>
                    <a asp-controller="Farmacia" asp-action="Create" class="btn btn-outline-primary btn-sm px-3">
                        <i class="bi bi-plus-circle me-1"></i> Registrar Suministro
                    </a>
                </div>
                <div class="p-3 rounded-4 bg-light text-success fs-2">
                    <i class="bi bi-clipboard-plus"></i>
                </div>
            </div>
        </div>
    </div>
</div>