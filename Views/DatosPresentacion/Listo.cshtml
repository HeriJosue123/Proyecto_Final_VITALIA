@model VITALIA.Data.ResultadoPresentacion
@{
    ViewData["Title"] = "Datos de presentación cargados";
    var cuentas = ViewBag.Cuentas as List<(string Correo, string Nombre, string Rol)> ?? new();
}

<div class="vitalia-banner mb-4 animate-fade-up">
    <h2 class="mb-1 fw-bold text-white"><i class="bi bi-check-circle-fill me-2"></i>Datos de presentación cargados</h2>
    <p class="mb-0 text-white-50">Ya está todo listo. Esta opción ya no aparecerá en el menú.</p>
</div>

<div class="alert alert-success shadow-sm border-0 rounded-3 mb-4">
    Se cargaron @Model.Residentes residentes, @Model.Personal personas del personal, @Model.Familiares familiares,
    @Model.Medicamentos medicamentos, @Model.Atenciones atenciones, @Model.Alertas alertas, @Model.Entregas entregas de medicamentos
    y @Model.Rrhh registros de RRHH (contratos, nóminas, permisos y personal externo).
</div>

@if (Model.Avisos.Count > 0)
{
    <div class="alert alert-warning shadow-sm border-0 rounded-3 mb-4">
        <i class="bi bi-exclamation-triangle-fill me-2"></i><strong>Algunos datos no se cargaron porque ya existía algo con el mismo código:</strong>
        <ul class="mb-0 mt-2">
            @foreach (var aviso in Model.Avisos)
            {
                <li>@aviso</li>
            }
        </ul>
    </div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="vitalia-card-pro p-0 overflow-hidden">
            <div class="p-4 pb-2">
                <h5 class="fw-bold mb-1" style="color: #14828a;"><i class="bi bi-key-fill me-2"></i>Cuentas para la presentación</h5>
                <p class="small text-muted mb-0">Todas con la contraseña por defecto de VITALIA. Anótelas antes de salir de esta página.</p>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 small text-uppercase text-muted">Correo</th>
                            <th class="pe-4 small text-uppercase text-muted">Rol</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in cuentas)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-semibold small">@c.Correo</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">@c.Nombre</div>
                                </td>
                                <td class="pe-4"><span class="badge bg-light text-dark border rounded-pill">@c.Rol</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="vitalia-card-pro p-4">
            <h5 class="fw-bold mb-3" style="color: #14828a;"><i class="bi bi-hdd-fill me-2"></i>Falta un detalle</h5>
            <p class="small mb-3">
                La pantalla de <strong>Respaldos</strong> muestra archivos de copia de seguridad, no datos de la base.
                Para que también tenga algo, cree uno con <strong>Nuevo respaldo</strong>.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Respaldos" asp-action="Create" class="btn btn-outline-secondary rounded-pill px-3 fw-semibold">
                    <i class="bi bi-hdd me-1"></i> Ir a Respaldos
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn text-white rounded-pill px-3 fw-semibold" style="background-color: #14828a;">
                    <i class="bi bi-house-fill me-1"></i> Ir al inicio
                </a>
            </div>
        </div>
    </div>
</div>
