@model VITALIA.Models.Medicamento

@{
    ViewData["Title"] = "Detalles del Medicamento";
    int totalStock = Model.LoteMedicamentos?.Sum(l => l.Stock) ?? 0;
}

<div class="animate-fade-up py-4 d-flex justify-content-center">
    <div style="width: 100%; max-width: 680px;" class="px-3">

        <div class="card border-0 rounded-4 shadow-sm overflow-hidden bg-white">
            
            <!-- Encabezado Turquesa VITALIA -->
            <div class="p-4 text-white d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #14828a 0%, #093437 100%);">
                <div class="d-flex align-items-center gap-3">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white shadow-sm flex-shrink-0" style="width: 44px; height: 44px;">
                        <i class="bi bi-capsule fs-5" style="color: #14828a !important;"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0">Detalles del Medicamento</h4>
                        <p class="text-white-50 small mb-0">Ficha técnica e inventario de lotes en existencia</p>
                    </div>
                </div>
                <a asp-action="Index" class="btn btn-sm btn-light text-dark rounded-pill px-3 py-2 fw-semibold shadow-sm text-decoration-none text-nowrap ms-3">
                    ← Volver a Farmacia
                </a>
            </div>

            <div class="card-body p-4">
                
                <!-- CÓDIGO Y NOMBRE DEL MEDICAMENTO -->
                <div class="bg-light p-3 rounded-3 mb-3 border border-light-subtle d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 0.68rem; letter-spacing: 0.6px;">
                            MEDICAMENTO
                        </span>
                        <h5 class="fw-bold text-dark mb-0">@Model.Nombre</h5>
                    </div>
                    <span class="badge bg-dark text-white font-monospace fs-6 px-3 py-2 rounded-3 shadow-sm">
                        <i class="bi bi-barcode me-1"></i>@Model.Codigo
                    </span>
                </div>

                <!-- PRESENTACIÓN Y ESTADO -->
                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <div class="p-3 rounded-3 bg-body-tertiary h-100 border">
                            <span class="text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 0.68rem; letter-spacing: 0.6px;">PRESENTACIÓN</span>
                            <div class="fw-bold text-dark" style="font-size: 0.92rem;">
                                <i class="bi bi-box-seam me-1 text-primary"></i>@(string.IsNullOrEmpty(Model.Presentacion) ? "Sin especificar" : Model.Presentacion)
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 rounded-3 bg-body-tertiary h-100 border text-center">
                            <span class="text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 0.68rem; letter-spacing: 0.6px;">ESTADO</span>
                            @if (Model.Estado == true)
                            {
                                <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle fw-semibold px-2.5 py-1.5" style="font-size: 0.8rem;">
                                    <i class="bi bi-check-circle-fill me-1"></i>Activo
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle fw-semibold px-2.5 py-1.5" style="font-size: 0.8rem;">
                                    <i class="bi bi-dash-circle-fill me-1"></i>Inactivo
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <!-- DESCRIPCIÓN -->
                <div class="p-3 rounded-3 mb-4 border bg-body-tertiary">
                    <span class="text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 0.68rem; letter-spacing: 0.6px;">DESCRIPCIÓN / INDICACIONES</span>
                    <p class="text-dark small mb-0 lh-base">@(string.IsNullOrEmpty(Model.Descripcion) ? "No hay descripción registrada para este fármaco." : Model.Descripcion)</p>
                </div>

                <!-- LOTES Y STOCK TOTAL EN EXISTENCIA -->
                <div class="p-3.5 rounded-3 mb-4 border bg-light" style="padding: 1.1rem !important;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fw-bold text-dark text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px; color: #14828a !important;">
                            <i class="bi bi-boxes me-1"></i> LOTES Y STOCK TOTAL EN EXISTENCIA
                        </span>
                        <span class="badge bg-dark rounded-pill px-3 py-1.5 fw-bold" style="font-size: 0.78rem;">
                            @totalStock UNIDADES
                        </span>
                    </div>

                    <div class="table-responsive rounded-3 border bg-white">
                        <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
                            <thead class="table-light">
                                <tr>
                                    <th class="fw-bold text-muted ps-3 py-2.5">N° Lote</th>
                                    <th class="fw-bold text-muted py-2.5">Vencimiento</th>
                                    <th class="fw-bold text-muted text-end pe-3 py-2.5">Stock</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.LoteMedicamentos != null && Model.LoteMedicamentos.Any())
                                {
                                    @foreach (var lote in Model.LoteMedicamentos.OrderBy(l => l.FechaVencimiento))
                                    {
                                        bool porVencer = lote.FechaVencimiento <= DateTime.Now.AddDays(30);
                                        <tr>
                                            <td class="ps-3 py-2.5 fw-semibold text-dark">
                                                <i class="bi bi-tag-fill me-1 text-muted"></i>@lote.NumeroLote
                                            </td>
                                            <td class="py-2.5">
                                                <span class="@(porVencer ? "text-danger fw-bold" : "text-dark")">
                                                    @lote.FechaVencimiento.ToString("dd/MM/yyyy")
                                                    @if (porVencer)
                                                    {
                                                        <i class="bi bi-exclamation-triangle-fill ms-1" title="Próximo a vencer"></i>
                                                    }
                                                </span>
                                            </td>
                                            <td class="pe-3 py-2.5 text-end fw-bold text-primary">
                                                @lote.Stock ud.
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-3">
                                            No hay lotes registrados actualmente.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- BOTONES DE ACCIÓN -->
                <div class="d-flex gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light rounded-3 py-2.5 px-4 fw-semibold text-secondary flex-grow-1 text-center text-decoration-none" style="font-size: 0.92rem;">
                        Cerrar
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.IdMedicamento" class="btn text-white fw-bold rounded-3 py-2.5 px-4 shadow-sm flex-grow-1 d-flex align-items-center justify-content-center gap-2" style="background: linear-gradient(135deg, #14828a 0%, #093437 100%); font-size: 0.92rem;">
                        <i class="bi bi-pencil-square"></i> Editar Medicamento
                    </a>
                </div>

            </div>
        </div>

    </div>
</div>