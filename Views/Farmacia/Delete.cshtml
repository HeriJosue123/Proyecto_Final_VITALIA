@model VITALIA.Models.Medicamento

@{
    ViewData["Title"] = "Eliminar Medicamento";
}

<div class="d-flex justify-content-center align-items-center w-100 animate-fade-up py-4" style="min-height: 80vh;">
    <div style="width: 100%; max-width: 580px;" class="px-3">

        <div class="card border-0 rounded-4 shadow-sm overflow-hidden bg-white">
            
            <!-- Encabezado Rojo -->
            <div class="p-4 text-center text-white" style="background: linear-gradient(135deg, #dc3545 0%, #a71d2a 100%);">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white shadow-sm mb-2" style="width: 48px; height: 48px;">
                    <i class="bi bi-trash-fill fs-4 text-danger"></i>
                </div>
                <h4 class="fw-bold mb-1">Confirmar Eliminación</h4>
                <p class="text-white small mb-0 opacity-90 fw-medium">¿Desea eliminar este medicamento del catálogo?</p>
            </div>

            <!-- Cuerpo del Card (Reducido espacio superior pt-3 para subir el contenido) -->
            <div class="card-body px-4 pb-4 pt-3">
                
                <!-- Advertencia -->
                <div class="p-3 rounded-3 mb-3 d-flex align-items-center gap-3" style="background-color: #fff5f5; border-left: 4px solid #dc3545;">
                    <i class="bi bi-exclamation-octagon-fill text-danger fs-4 flex-shrink-0"></i>
                    <div class="small text-danger-emphasis fw-medium lh-base">
                        <strong>Atención:</strong> Esta acción eliminará permanentemente el registro del catálogo principal de la farmacia.
                    </div>
                </div>

                <!-- Nombre y Código del Medicamento -->
                <div class="bg-light p-3 rounded-3 mb-3 border border-light-subtle d-flex justify-content-between align-items-center gap-3">
                    <div class="py-0.5">
                        <span class="text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 0.7rem; letter-spacing: 0.6px;">
                            MEDICAMENTO
                        </span>
                        <h5 class="fw-bold text-dark mb-0">@Model.Nombre</h5>
                    </div>
                    <span class="badge bg-dark text-white font-monospace fs-6 px-3 py-2 rounded-3 shadow-sm flex-shrink-0">
                        <i class="bi bi-barcode me-2"></i>@Model.Codigo
                    </span>
                </div>

                <!-- Grilla de Detalle -->
                <div class="row g-3 mb-3">
                    <!-- Presentación -->
                    <div class="col-md-7">
                        <div class="p-3 rounded-3 bg-body-tertiary h-100 border">
                            <span class="text-uppercase fw-bold text-muted d-block mb-2" style="font-size: 0.68rem; letter-spacing: 0.5px;">PRESENTACIÓN</span>
                            <div class="fw-bold text-dark d-flex align-items-center" style="font-size: 0.95rem;">
                                <i class="bi bi-box-seam text-primary fs-5" style="margin-right: 12px !important;"></i>
                                <span>@(string.IsNullOrEmpty(Model.Presentacion) ? "Sin especificar" : Model.Presentacion)</span>
                            </div>
                        </div>
                    </div>

                    <!-- Estado Actual -->
                    <div class="col-md-5">
                        <div class="p-3 rounded-3 bg-body-tertiary h-100 border text-center">
                            <span class="text-uppercase fw-bold text-muted d-block mb-2" style="font-size: 0.68rem; letter-spacing: 0.5px;">ESTADO ACTUAL</span>
                            @if (Model.Estado == true)
                            {
                                <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle fw-semibold px-3 py-2" style="font-size: 0.82rem;">
                                    <i class="bi bi-check-circle-fill me-1"></i>Activo
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle fw-semibold px-3 py-2" style="font-size: 0.82rem;">
                                    <i class="bi bi-dash-circle-fill me-1"></i>Inactivo
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Formulario Confirmar -->
                <form asp-action="Delete" asp-controller="Farmacia" method="post" class="pt-3 border-top">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="IdMedicamento" />

                    <div class="row g-3">
                        <div class="col-6">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-3 py-2.5 fw-semibold w-100 d-flex align-items-center justify-content-center border-2 transition-all" style="font-size: 0.92rem;">
                                <i class="bi bi-x-circle me-2"></i> Cancelar
                            </a>
                        </div>
                        <div class="col-6">
                            <button type="submit" class="btn btn-danger rounded-3 py-2.5 fw-bold shadow-sm w-100 d-flex align-items-center justify-content-center transition-all" style="background-color: #dc3545; font-size: 0.92rem;">
                                <i class="bi bi-trash-fill me-2"></i> Confirmar
                            </button>
                        </div>
                    </div>
                </form>

            </div>
        </div>

    </div>
</div>

<style>
    .transition-all {
        transition: all 0.2s ease-in-out;
    }
    .transition-all:hover {
        transform: translateY(-1px);
    }
</style>