@model IEnumerable<VITALIA.Models.Medicamento>

@{
    ViewData["Title"] = "Farmacia - Medicamentos";
}

<div class="animate-fade-up py-4 px-2 px-md-4">
    
    <!-- Alertas / Mensajes de Confirmación (TempData) -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3 alert-dismissible fade show mb-4 d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
            <div class="fw-semibold">@TempData["Mensaje"]</div>
            <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-3 alert-dismissible fade show mb-4 d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
            <div class="fw-semibold">@TempData["Error"]</div>
            <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tarjeta Contenedora Principal -->
    <div class="card border-0 rounded-4 shadow-sm overflow-hidden bg-white">
        
        <!-- Encabezado Turquesa VITALIA -->
        <div class="p-4 text-white d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3" style="background: linear-gradient(135deg, #14828a 0%, #093437 100%);">
            <div class="d-flex align-items-center gap-3">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white shadow-sm flex-shrink-0" style="width: 48px; height: 48px;">
                    <i class="bi bi-capsule fs-4" style="color: #14828a !important;"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0">Catálogo de Medicamentos</h4>
                    <p class="text-white-50 small mb-0">Gestión de fármacos, estado y control de inventario global</p>
                </div>
            </div>

            <a asp-action="Create" class="btn btn-light text-dark rounded-pill px-4 py-2.5 fw-bold shadow-sm d-inline-flex align-items-center gap-2 text-decoration-none">
                <i class="bi bi-plus-lg"></i> Registrar Medicamento
            </a>
        </div>

        <div class="card-body p-4">
            
            <!-- BARRA DE FILTROS Y BÚSQUEDA DINÁMICA -->
            <div class="row g-2.5 mb-3 align-items-center">
                <!-- Buscador por Texto (Nombre, Código o Presentación) -->
                <div class="col-md-5 col-lg-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 rounded-start-3" style="border-color: #cbd5e1;">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" id="inputBuscador" class="form-control bg-light border-start-0 rounded-end-3 shadow-none" placeholder="Buscar por nombre, código o presentación..." style="border-color: #cbd5e1; font-size: 0.9rem;" />
                    </div>
                </div>

                <!-- Filtro por Nivel de Stock -->
                <div class="col-6 col-md-3 col-lg-3">
                    <select id="filtroStock" class="form-select bg-light rounded-3 shadow-none" style="border-color: #cbd5e1; font-size: 0.9rem;">
                        <option value="">Todos los niveles de Stock</option>
                        <option value="normal">Stock Normal (>15)</option>
                        <option value="bajo">Stock Bajo (1 - 15)</option>
                        <option value="agotado">Agotado (0)</option>
                    </select>
                </div>

                <!-- Filtro por Estado -->
                <div class="col-6 col-md-3 col-lg-3">
                    <select id="filtroEstado" class="form-select bg-light rounded-3 shadow-none" style="border-color: #cbd5e1; font-size: 0.9rem;">
                        <option value="">Todos los Estados</option>
                        <option value="activo">Solo Activos</option>
                        <option value="inactivo">Solo Inactivos</option>
                    </select>
                </div>

                <!-- Botón Limpiar Filtros -->
                <div class="col-12 col-md-1 col-lg-1 text-end">
                    <button type="button" id="btnLimpiarFiltros" class="btn btn-outline-secondary w-100 rounded-3 shadow-none p-2" title="Limpiar Filtros">
                        <i class="bi bi-funnel-fill"></i>
                    </button>
                </div>
            </div>

            <!-- Tabla de Medicamentos -->
            <div class="table-responsive rounded-3 border">
                <table class="table table-hover align-middle mb-0" id="tablaMedicamentos" style="font-size: 0.9rem;">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3 py-3 text-uppercase fw-bold text-muted" style="font-size: 0.72rem; letter-spacing: 0.5px;">Código</th>
                            <th class="py-3 text-uppercase fw-bold text-muted" style="font-size: 0.72rem; letter-spacing: 0.5px;">Medicamento</th>
                            <th class="py-3 text-uppercase fw-bold text-muted" style="font-size: 0.72rem; letter-spacing: 0.5px;">Presentación</th>
                            <th class="py-3 text-uppercase fw-bold text-muted text-center" style="font-size: 0.72rem; letter-spacing: 0.5px;">Próx. Vencimiento</th>
                            <th class="py-3 text-uppercase fw-bold text-muted text-center" style="font-size: 0.72rem; letter-spacing: 0.5px;">Stock Total</th>
                            <th class="py-3 text-uppercase fw-bold text-muted text-center" style="font-size: 0.72rem; letter-spacing: 0.5px;">Estado</th>
                            <th class="pe-3 py-3 text-uppercase fw-bold text-muted text-end" style="font-size: 0.72rem; letter-spacing: 0.5px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                int stockTotal = item.LoteMedicamentos?.Sum(l => l.Stock) ?? 0;
                                string estadoTxt = item.Estado == true ? "activo" : "inactivo";
                                string stockCategoria = stockTotal > 15 ? "normal" : (stockTotal > 0 ? "bajo" : "agotado");
                                
                                // Obtener la fecha de vencimiento más próxima (Lote con stock disponible o más antiguo)
                                var proximoLote = item.LoteMedicamentos?.Where(l => l.Stock > 0).OrderBy(l => l.FechaVencimiento).FirstOrDefault()
                                                  ?? item.LoteMedicamentos?.OrderBy(l => l.FechaVencimiento).FirstOrDefault();
                                DateTime? fechaVenc = proximoLote?.FechaVencimiento;
                                bool porVencer = fechaVenc.HasValue && fechaVenc.Value <= DateTime.Now.AddDays(30);

                                <tr data-codigo="@(item.Codigo?.ToLower() ?? "")"
                                    data-nombre="@item.Nombre.ToLower()" 
                                    data-presentacion="@(item.Presentacion?.ToLower() ?? "")"
                                    data-estado="@estadoTxt"
                                    data-stock-status="@stockCategoria">
                                    
                                    <!-- CÓDIGO -->
                                    <td class="ps-3 py-3">
                                        <span class="badge bg-light text-dark border font-monospace fw-bold" style="font-size: 0.8rem;">
                                            <i class="bi bi-barcode me-1 text-muted"></i>@(string.IsNullOrEmpty(item.Codigo) ? "S/C" : item.Codigo)
                                        </span>
                                    </td>

                                    <!-- NOMBRE -->
                                    <td class="py-3">
                                        <div class="fw-bold text-dark fs-6">@item.Nombre</div>
                                        @if (!string.IsNullOrEmpty(item.Descripcion))
                                        {
                                            <div class="text-muted small text-truncate" style="max-width: 220px;">@item.Descripcion</div>
                                        }
                                    </td>

                                    <!-- PRESENTACIÓN -->
                                    <td class="py-3">
                                        <span class="fw-medium text-secondary">
                                            <i class="bi bi-box-seam me-1 text-primary"></i>@(string.IsNullOrEmpty(item.Presentacion) ? "Sin especificar" : item.Presentacion)
                                        </span>
                                    </td>

                                    <!-- PRÓXIMO VENCIMIENTO -->
                                    <td class="py-3 text-center">
                                        @if (fechaVenc.HasValue)
                                        {
                                            <span class="@(porVencer ? "text-danger fw-bold" : "text-dark fw-medium")" style="font-size: 0.85rem;">
                                                <i class="bi bi-calendar-event me-1"></i>@fechaVenc.Value.ToString("dd/MM/yyyy")
                                                @if (porVencer)
                                                {
                                                    <i class="bi bi-exclamation-triangle-fill text-danger ms-1" title="Próximo a vencer"></i>
                                                }
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Sin datos</span>
                                        }
                                    </td>

                                    <!-- STOCK TOTAL -->
                                    <td class="py-3 text-center">
                                        @if (stockTotal > 15)
                                        {
                                            <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle rounded-pill px-3 py-1.5 fw-bold" style="font-size: 0.78rem;">
                                                @stockTotal ud.
                                            </span>
                                        }
                                        else if (stockTotal > 0)
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1.5 fw-bold" style="font-size: 0.78rem;">
                                                @stockTotal ud. (Bajo)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle rounded-pill px-3 py-1.5 fw-bold" style="font-size: 0.78rem;">
                                                0 ud. (Agotado)
                                            </span>
                                        }
                                    </td>

                                    <!-- ESTADO -->
                                    <td class="py-3 text-center">
                                        @if (item.Estado == true)
                                        {
                                            <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle fw-semibold px-2.5 py-1" style="font-size: 0.78rem;">
                                                <i class="bi bi-check-circle-fill me-1"></i>Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle fw-semibold px-2.5 py-1" style="font-size: 0.78rem;">
                                                <i class="bi bi-dash-circle-fill me-1"></i>Inactivo
                                            </span>
                                        }
                                    </td>

                                    <!-- ACCIONES -->
                                    <td class="pe-3 py-3 text-end">
                                        <div class="d-inline-flex align-items-center" style="gap: 8px;">
                                            <a asp-action="Details" asp-route-id="@item.IdMedicamento" class="btn btn-sm btn-light border text-secondary rounded-3 shadow-none px-2.5 py-1.5 btn-action-details" title="Ver Detalles">
                                                <i class="bi bi-eye-fill"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.IdMedicamento" class="btn btn-sm btn-light border text-primary rounded-3 shadow-none px-2.5 py-1.5 btn-action-edit" title="Editar">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            @if (User.IsInRole("Administrador"))
                                            {
                                            <a asp-action="Delete" asp-route-id="@item.IdMedicamento" class="btn btn-sm btn-light border text-danger rounded-3 shadow-none px-2.5 py-1.5 btn-action-delete" title="Eliminar">
                                                <i class="bi bi-trash-fill"></i>
                                            </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-5">
                                    <i class="bi bi-capsule fs-1 d-block mb-2 text-black-50"></i>
                                    No hay medicamentos registrados en el catálogo.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <script>
        const inputBuscador = document.getElementById('inputBuscador');
        const filtroStock = document.getElementById('filtroStock');
        const filtroEstado = document.getElementById('filtroEstado');
        const btnLimpiar = document.getElementById('btnLimpiarFiltros');
        const filas = document.querySelectorAll('#tablaMedicamentos tbody tr');

        function aplicarFiltros() {
            const texto = inputBuscador.value.toLowerCase().trim();
            const stockSeleccionado = filtroStock.value;
            const estadoSeleccionado = filtroEstado.value;

            filas.forEach(fila => {
                if (!fila.hasAttribute('data-nombre')) return;

                const codigo = fila.getAttribute('data-codigo') || '';
                const nombre = fila.getAttribute('data-nombre') || '';
                const presentacion = fila.getAttribute('data-presentacion') || '';
                const estado = fila.getAttribute('data-estado') || '';
                const stock = fila.getAttribute('data-stock-status') || '';

                const coincideTexto = texto === '' || nombre.includes(texto) || codigo.includes(texto) || presentacion.includes(texto);
                const coincideStock = stockSeleccionado === '' || stock === stockSeleccionado;
                const coincideEstado = estadoSeleccionado === '' || estado === estadoSeleccionado;

                if (coincideTexto && coincideStock && coincideEstado) {
                    fila.style.display = '';
                } else {
                    fila.style.display = 'none';
                }
            });
        }

        inputBuscador?.addEventListener('keyup', aplicarFiltros);
        filtroStock?.addEventListener('change', aplicarFiltros);
        filtroEstado?.addEventListener('change', aplicarFiltros);

        btnLimpiar?.addEventListener('click', function() {
            inputBuscador.value = '';
            filtroStock.value = '';
            filtroEstado.value = '';
            aplicarFiltros();
        });
    </script>
}

<style>
    .btn-action-details, 
    .btn-action-edit, 
    .btn-action-delete {
        transition: all 0.2s ease-in-out;
        border-color: #cbd5e1 !important;
    }

    .btn-action-details:hover {
        border-color: #6c757d !important;
        background-color: #f1f5f9 !important;
        color: #475569 !important;
        transform: translateY(-1px);
    }

    .btn-action-edit:hover {
        border-color: #14828a !important;
        background-color: #e6f4f4 !important;
        color: #14828a !important;
        transform: translateY(-1px);
    }

    .btn-action-delete:hover {
        border-color: #dc3545 !important;
        background-color: #fde8e8 !important;
        color: #dc3545 !important;
        transform: translateY(-1px);
    }
</style>