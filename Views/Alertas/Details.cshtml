@model VITALIA.Models.ViewModels.AlertaDetalleViewModel

@{
    ViewData["Title"] = "Detalle de Alerta";

    var badgePrioridad = Model.Prioridad switch
    {
        "Urgente" => "bg-danger-subtle text-danger border border-danger-subtle",
        "Programada" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
        _ => "bg-info-subtle text-info-emphasis border border-info-subtle"
    };
}

<div class="animate-fade-up py-3">
    <!-- NAVEGACIÓN SUPERIOR SEPARADA -->
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-sm bg-white text-muted border rounded-pill px-3 py-1 shadow-sm text-decoration-none fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> Volver a la lista
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-7">
            
            <!-- TARJETA PRINCIPAL DE DETALLES -->
            <div class="card border-0 rounded-4 shadow-sm overflow-hidden bg-white">
                
                <!-- Banner de Encabezado Verde Degradado -->
                <div class="p-4 text-white d-flex align-items-center justify-content-between flex-wrap gap-3" style="background: linear-gradient(135deg, #14828a 0%, #093437 100%);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white text-dark shadow-sm flex-shrink-0" style="width: 48px; height: 48px; color: #14828a !important;">
                            <i class="bi bi-bell-fill fs-4"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                <h4 class="fw-bold mb-0 text-white">@Model.Titulo</h4>
                                <span class="badge bg-white bg-opacity-25 text-white border border-white border-opacity-25 rounded-pill px-2.5 py-1" style="font-size: 0.75rem;">
                                    #@Model.IdAlerta
                                </span>
                            </div>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="badge rounded-pill px-2.5 py-1 @badgePrioridad" style="font-size: 0.75rem;">
                                    @Model.Prioridad
                                </span>
                                <span class="badge bg-light text-dark rounded-pill px-2.5 py-1" style="font-size: 0.75rem;">
                                    Estado: <strong>@Model.Estado</strong>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Cuerpo de la Tarjeta -->
                <div class="card-body p-4 p-md-5">

                    <!-- DESCRIPCIÓN -->
                    <div class="p-3 rounded-3 bg-light border border-light-subtle mb-4">
                        <span class="text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">DESCRIPCIÓN DE LA ALERTA</span>
                        <p class="text-dark fs-6 mb-0 lh-base">@Model.Descripcion</p>
                    </div>

                    <!-- GRILLA DE DETALLES -->
                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <div class="p-3 rounded-3 bg-light border border-light-subtle h-100">
                                <span class="text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">RESIDENTE</span>
                                <span class="fw-bold text-dark fs-6 d-block"><i class="bi bi-person text-primary me-1"></i>@Model.Residente</span>
                                <span class="text-muted small">Expediente: @Model.CodigoResidente</span>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="p-3 rounded-3 bg-light border border-light-subtle h-100">
                                <span class="text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">RESPONSABLE</span>
                                <span class="fw-semibold text-dark fs-6 d-block"><i class="bi bi-person-badge text-primary me-1"></i>@(string.IsNullOrEmpty(Model.Responsable) ? "Sin asignar" : Model.Responsable)</span>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="p-3 rounded-3 bg-light border border-light-subtle h-100">
                                <span class="text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">FECHA PROGRAMADA</span>
                                <span class="fw-semibold text-dark small d-block"><i class="bi bi-calendar-event text-primary me-1"></i>@Model.FechaProgramada.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="p-3 rounded-3 bg-light border border-light-subtle h-100">
                                <span class="text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">CREADA POR</span>
                                <span class="fw-semibold text-dark small d-block"><i class="bi bi-person-circle text-primary me-1"></i>@Model.CreadaPor</span>
                            </div>
                        </div>
                    </div>

                    <!-- HISTORIAL DE ESTADOS -->
                    <div class="mb-4 pt-2">
                        <label class="form-label fw-bold text-dark small text-uppercase tracking-wider mb-2 d-block">
                            <i class="bi bi-clock-history text-primary me-1"></i> Historial de Estados
                        </label>
                        
                        @if (Model.Historial != null && Model.Historial.Any())
                        {
                            <div class="border border-light-subtle rounded-3 p-3 bg-light">
                                @foreach (var item in Model.Historial)
                                {
                                    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2 last-no-border">
                                        <div>
                                            <span class="fw-semibold text-dark small">@item.EstadoAnterior → @item.EstadoNuevo</span>
                                            <small class="text-muted d-block" style="font-size: 0.75rem;">Por: @item.Usuario</small>
                                        </div>
                                        <span class="text-muted small font-monospace">@item.FechaHora.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-3 rounded-3 bg-light text-muted small border border-light-subtle text-center">
                                <i class="bi bi-info-circle me-1"></i> Esta alerta todavía no ha registrado cambios de estado.
                            </div>
                        }
                    </div>

                    <!-- BOTONES DE ACCIÓN BALANCEADOS -->
                    <div class="d-flex gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light rounded-3 py-2.5 px-4 fw-semibold text-secondary flex-grow-1 text-center">
                            Cerrar
                        </a>
                        <a asp-action="Edit" asp-route-id="@Model.IdAlerta" class="btn text-white fw-bold rounded-3 py-2.5 px-4 shadow-sm flex-grow-1 d-flex align-items-center justify-content-center gap-2" style="background: linear-gradient(135deg, #14828a 0%, #093437 100%);">
                            <i class="bi bi-pencil-square"></i> Editar Alerta
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<style>
    .last-no-border:last-child {
        border-bottom: 0 !important;
        padding-bottom: 0 !important;
        margin-bottom: 0 !important;
    }
</style>