@model VITALIA.Models.ViewModels.AlertaDetalleViewModel

@{
    ViewData["Title"] = "Detalle de Alerta";
}

<div class="d-flex justify-content-center py-2">
    <div style="width: 100%; max-width: 720px;">
        
        <!-- Banner Superior de Encabezado -->
        <div class="vitalia-banner d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 p-3 rounded-4" style="background-color: #0b5e58; color: white;">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-2 bg-white bg-opacity-10 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-info-circle-fill fs-4 text-white"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-1 text-white">@Model.Titulo</h3>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-white text-dark fw-semibold px-2 py-1">Alerta #@Model.IdAlerta</span>
                        <span class="badge bg-warning text-dark fw-semibold px-2 py-1">@Model.Prioridad</span>
                        <span class="badge bg-light text-dark fw-semibold px-2 py-1">@Model.Estado</span>
                    </div>
                </div>
            </div>
            <div>
                <a asp-action="Index" class="btn btn-light text-dark fw-semibold rounded-3 px-3 py-2 text-nowrap" style="font-size: 0.85rem;">
                    ← Volver a la lista
                </a>
            </div>
        </div>

        <!-- Tarjeta Principal de Detalles -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            
            <!-- Bloque de Información General -->
            <div class="bg-light p-3 rounded-3 mb-4">
                <div class="mb-3">
                    <label class="form-label fw-bold text-muted small text-uppercase mb-1" style="letter-spacing: 0.5px;">DESCRIPCIÓN</label>
                    <div class="text-dark fs-6">@Model.Descripcion</div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted small text-uppercase mb-1" style="letter-spacing: 0.5px;">RESIDENTE</label>
                        <div class="fw-semibold text-dark">@Model.Residente <span class="text-muted fw-normal">(@Model.CodigoResidente)</span></div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted small text-uppercase mb-1" style="letter-spacing: 0.5px;">RESPONSABLE</label>
                        <div class="fw-semibold text-dark">@(string.IsNullOrEmpty(Model.Responsable) ? "Sin asignar" : Model.Responsable)</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted small text-uppercase mb-1" style="letter-spacing: 0.5px;">FECHA PROGRAMADA</label>
                        <div class="fw-semibold text-dark">@Model.FechaProgramada.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted small text-uppercase mb-1" style="letter-spacing: 0.5px;">CREADA POR</label>
                        <div class="fw-semibold text-dark">@Model.CreadaPor</div>
                    </div>
                </div>
            </div>

            <!-- Historial de Estados -->
            <div class="mb-4">
                <label class="form-label fw-bold text-dark small text-uppercase mb-2" style="letter-spacing: 0.5px;">HISTORIAL DE ESTADOS</label>
                
                @if (Model.Historial != null && Model.Historial.Any())
                {
                    <div class="border rounded-3 p-3 bg-white">
                        @foreach (var item in Model.Historial)
                        {
                            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2 last-no-border">
                                <div>
                                    <span class="fw-semibold text-dark">@item.EstadoAnterior → @item.EstadoNuevo</span>
                                    <small class="text-muted d-block" style="font-size: 0.75rem;">Por: @item.Usuario</small>
                                </div>
                                <span class="text-muted small">@item.FechaHora.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0">Esta alerta todavía no ha cambiado de estado.</p>
                }
            </div>

            <!-- Botones de Acción -->
            <div class="d-flex gap-2 pt-2 border-top">
                <a asp-action="Index" class="btn btn-light border py-2 fw-semibold text-dark rounded-3 flex-fill text-center">
                    Cerrar
                </a>
                <a asp-action="Edit" asp-route-id="@Model.IdAlerta" class="btn text-white py-2 fw-semibold rounded-3 flex-fill text-center d-flex align-items-center justify-content-center gap-2" style="background-color: #0e857c;">
                    <i class="bi bi-pencil-square fs-5"></i> Editar Alerta
                </a>
            </div>

        </div>

    </div>
</div>