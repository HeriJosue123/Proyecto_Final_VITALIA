@model VITALIA.Models.ViewModels.AlertaFormViewModel

@{
    ViewData["Title"] = "Editar Alerta";
}

<div class="d-flex justify-content-center py-2">
    <div style="width: 100%; max-width: 720px;">
        
        <!-- Banner Superior de Encabezado -->
        <div class="vitalia-banner d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 p-3 rounded-4" style="background-color: #0b5e58; color: white;">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-2 bg-white bg-opacity-10 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-pencil-square fs-4 text-white"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0 text-white">Editar Alerta</h3>
                    <p class="mb-0 small text-white-50">
                        Estado actual: <strong class="text-white">@Model.Estado</strong>. El estado se cambia desde el tablero.
                    </p>
                </div>
            </div>
            <div>
                <a asp-action="Index" class="btn btn-light text-dark fw-semibold rounded-3 px-3 py-2 text-nowrap" style="font-size: 0.85rem;">
                    ← Volver a la lista
                </a>
            </div>
        </div>

        <!-- Tarjeta Principal del Formulario -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="IdAlerta" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm rounded-3 mb-3 small" role="alert"></div>

                <partial name="_AlertaFormCampos" model="Model" />

                <!-- BOTÓN GUARDAR CAMBIOS -->
                <div class="mt-4">
                    <button type="submit" class="btn w-100 py-2 fw-semibold text-white rounded-3 d-flex align-items-center justify-content-center gap-2" style="background-color: #0e857c; font-size: 1rem;">
                        <i class="bi bi-check-circle-fill fs-5"></i> Guardar Cambios
                    </button>
                </div>
            </form>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}