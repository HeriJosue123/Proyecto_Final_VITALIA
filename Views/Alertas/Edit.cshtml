@model VITALIA.Models.ViewModels.AlertaFormViewModel

@{
    ViewData["Title"] = "Editar Alerta";
}

<div class="animate-fade-up py-2">
    <!-- NAVEGACIÓN SUPERIOR SEPARADA -->
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-sm bg-white text-muted border rounded-pill px-3 py-1 shadow-sm text-decoration-none fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> Volver a Alertas
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-8">

            <!-- ENCABEZADO CENTRADO -->
            <div class="text-center mb-3">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle text-white shadow-sm mb-2" style="width: 44px; height: 44px; background: linear-gradient(135deg, #14828a, #093437);">
                    <i class="bi bi-pencil-square fs-5"></i>
                </div>
                <h4 class="fw-bold mb-0" style="color: #1a252f;">Editar Alerta</h4>
                <p class="text-muted small mb-0">
                    Estado actual: <strong>@Model.Estado</strong>. El estado se cambia desde el tablero.
                </p>
            </div>

            <!-- TARJETA DEL FORMULARIO -->
            <div class="vitalia-card-pro p-3 p-md-4 position-relative overflow-hidden">
                <div style="position: absolute; top:0; left:0; right:0; height: 4px; background: linear-gradient(90deg, #14828a, #093437);"></div>

                <form asp-action="Edit" asp-route-id="@Model.IdAlerta" method="post" class="mt-1">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm rounded-3 mb-3 small" role="alert"></div>

                    <input type="hidden" asp-for="IdAlerta" />

                    <partial name="_AlertaFormCampos" model="Model" />

                    <!-- BOTONES DE ACCIÓN BALANCEADOS -->
                    <div class="d-flex gap-2 pt-3 mt-1 border-top">
                        <a asp-action="Index" class="btn btn-light rounded-3 py-2 px-4 fw-semibold text-secondary flex-grow-1 text-center">
                            Cancelar
                        </a>
                        <button type="submit" class="btn text-white rounded-3 py-2 px-4 fw-bold shadow-sm flex-grow-1" style="background-color: #14828a; transition: all 0.2s ease;">
                            <i class="bi bi-check-circle-fill me-1"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
