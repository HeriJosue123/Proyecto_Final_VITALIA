@model VITALIA.Models.ViewModels.AlertasTableroViewModel

@{
    ViewData["Title"] = "Alertas y Tareas";
}<style>
    .kanban-col {
        background-color: #f4f7f8;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 1.25rem;
        min-height: 340px;
    }

    .kanban-col-titulo {
        display: flex;
        align-items: center;
        gap: .5rem;
        font-weight: 700;
        margin-bottom: 1.25rem;
        color: #1a252f;
    }

    .kanban-punto {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
    }

    .alerta-card {
        border: 0;
        border-left: 4px solid #6c757d;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        background-color: #ffffff;
    }

    .alerta-card.prio-urgente {
        border-left-color: #dc3545;
    }

    .alerta-card.prio-programada {
        border-left-color: #e09f3e;
    }

    .alerta-card.prio-rutina {
        border-left-color: #14828a;
    }
</style>

<div class="animate-fade-up">
    <!-- Encabezado del módulo -->
    <div class="vitalia-banner p-4 rounded-4 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4" style="background-color: #14828a;">
        <div>
            <h2 class="fw-bold mb-1 text-white">Alertas y Tareas</h2>
            <p class="text-white-50 mb-0">Panel de seguimiento por estado y prioridades del sistema</p>
        </div>
        <a asp-action="Create" class="btn bg-white rounded-pill px-4 py-2 fw-bold shadow-sm text-nowrap" style="color: #14828a;">
            <i class="bi bi-plus-lg me-1"></i> Nueva alerta
        </a>
    </div>

    <!-- Mensajes -->
    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["MensajeError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- Filtros Corregidos -->
    <div class="vitalia-card-pro p-3 bg-white rounded-4 shadow-sm border-0 mb-4">
        <form asp-controller="Alertas" asp-action="Index" method="get" class="d-flex flex-wrap align-items-center gap-2">
            <select name="idResidente" class="form-select form-select-sm rounded-pill border-light-subtle ps-3 pe-4 py-1.5" style="width: auto; min-width: 220px;">
                <option value="">Residente: Todos</option>
                @foreach (var r in Model.Residentes)
                {
                    <option value="@r.Value" selected="@(Model.FiltroResidente?.ToString() == r.Value)">@r.Text</option>
                }
            </select>

            <select name="prioridad" class="form-select form-select-sm rounded-pill border-light-subtle ps-3 pe-4 py-1.5" style="width: auto; min-width: 170px;">
                <option value="">Prioridad: Todas</option>
                @foreach (var p in new[] { "Urgente", "Programada", "Rutina" })
                {
                    <option value="@p" selected="@(Model.FiltroPrioridad == p)">@p</option>
                }
            </select>

            <button type="submit" class="btn btn-sm text-white rounded-pill px-3 py-1.5 fw-semibold ms-1" style="background-color: #14828a;">
                <i class="bi bi-funnel me-1"></i> Filtrar
            </button>
            <a asp-action="Index" class="btn btn-sm btn-link text-muted text-decoration-none fw-semibold">Limpiar</a>

            <small class="text-muted ms-md-auto font-monospace" style="font-size: 0.78rem;">
                <i class="bi bi-info-circle me-1"></i> Flujo: <strong>Pendiente</strong> → <strong>En Proceso</strong> → <strong>Atendida</strong>
            </small>
        </form>
    </div>

    <!-- Tablero por columnas de estado -->
    <div class="row g-4">
        <!-- Columna Pendiente -->
        <div class="col-lg-4">
            <div class="kanban-col">
                <div class="kanban-col-titulo justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <span class="kanban-punto bg-danger"></span> 
                        <span>Pendiente</span>
                    </div>
                    <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-3 py-1">@Model.Pendientes.Count</span>
                </div>
                
                <div class="d-flex flex-column gap-3">
                    @foreach (var t in Model.Pendientes)
                    {
                        <partial name="_AlertaTarjeta" model="t" />
                    }
                    @if (!Model.Pendientes.Any())
                    {
                        <div class="text-center py-4 text-muted small bg-white rounded-3 border border-dashed">
                            <i class="bi bi-check2-circle fs-4 text-muted d-block mb-1 opacity-50"></i>
                            No hay alertas pendientes.
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Columna En Proceso -->
        <div class="col-lg-4">
            <div class="kanban-col">
                <div class="kanban-col-titulo justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <span class="kanban-punto bg-warning"></span> 
                        <span>En Proceso</span>
                    </div>
                    <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-1">@Model.EnProceso.Count</span>
                </div>

                <div class="d-flex flex-column gap-3">
                    @foreach (var t in Model.EnProceso)
                    {
                        <partial name="_AlertaTarjeta" model="t" />
                    }
                    @if (!Model.EnProceso.Any())
                    {
                        <div class="text-center py-4 text-muted small bg-white rounded-3 border border-dashed">
                            <i class="bi bi-clock-history fs-4 text-muted d-block mb-1 opacity-50"></i>
                            No hay alertas en proceso.
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Columna Atendida -->
        <div class="col-lg-4">
            <div class="kanban-col">
                <div class="kanban-col-titulo justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <span class="kanban-punto bg-success"></span> 
                        <span>Atendida</span>
                    </div>
                    <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3 py-1">@Model.Atendidas.Count</span>
                </div>

                <div class="d-flex flex-column gap-3">
                    @foreach (var t in Model.Atendidas)
                    {
                        <partial name="_AlertaTarjeta" model="t" />
                    }
                    @if (!Model.Atendidas.Any())
                    {
                        <div class="text-center py-4 text-muted small bg-white rounded-3 border border-dashed">
                            <i class="bi bi-archive fs-4 text-muted d-block mb-1 opacity-50"></i>
                            Todavía no hay alertas atendidas.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>