@model VITALIA.Models.ViewModels.AlertasTableroViewModel

@{
    ViewData["Title"] = "Alertas y Tareas";
}

<style>
    .kanban-col {
        background-color: #e8eef0;
        border-radius: 14px;
        padding: 1rem;
        min-height: 320px;
    }

    .kanban-col-titulo {
        display: flex;
        align-items: center;
        gap: .5rem;
        font-weight: 700;
        margin-bottom: 1rem;
    }

    .kanban-punto {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
    }

    .alerta-card {
        border: 0;
        border-left: 4px solid #6c757d;
        border-radius: 10px;
    }

        .alerta-card.prio-urgente {
            border-left-color: #dc3545;
        }

        .alerta-card.prio-programada {
            border-left-color: #e09f3e;
        }

        .alerta-card.prio-rutina {
            border-left-color: #0d8abc;
        }
</style>

<!-- Encabezado del módulo -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-0">Alertas y tareas</h3>
        <p class="text-muted small mb-0">Panel de seguimiento por estado</p>
    </div>
    <a asp-action="Create" class="btn btn-vitalia">
        <i class="bi bi-plus-lg me-1"></i> Nueva alerta
    </a>
</div>

<!-- Mensajes -->
@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-1"></i> @TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["MensajeError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<!-- Filtros (RF-016) -->
<form asp-controller="Alertas" asp-action="Index" method="get" class="d-flex flex-wrap align-items-center gap-2 mb-4">
    <select name="idResidente" class="form-select form-select-sm rounded-3" style="width: auto; min-width: 220px;">
        <option value="">Residente: Todos</option>
        @foreach (var r in Model.Residentes)
        {
            <option value="@r.Value" selected="@(Model.FiltroResidente?.ToString() == r.Value)">@r.Text</option>
        }
    </select>

    <select name="prioridad" class="form-select form-select-sm rounded-3" style="width: auto;">
        <option value="">Prioridad: Todas</option>
        @foreach (var p in new[] { "Urgente", "Programada", "Rutina" })
        {
            <option value="@p" selected="@(Model.FiltroPrioridad == p)">@p</option>
        }
    </select>

    <button type="submit" class="btn btn-sm btn-outline-vitalia">Filtrar</button>
    <a asp-action="Index" class="btn btn-sm btn-link text-muted">Limpiar</a>

    <small class="text-muted ms-md-auto">Flujo: Pendiente → En Proceso → Atendida (no se reabre)</small>
</form>

<!-- Tablero por columnas de estado -->
<div class="row g-4">
    <div class="col-lg-4">
        <div class="kanban-col">
            <div class="kanban-col-titulo">
                <span class="kanban-punto bg-danger"></span> Pendiente
                <span class="badge rounded-pill text-bg-light ms-1">@Model.Pendientes.Count</span>
            </div>
            @foreach (var t in Model.Pendientes)
            {
                <partial name="_AlertaTarjeta" model="t" />
            }
            @if (!Model.Pendientes.Any())
            {
                <p class="text-muted small mb-0">No hay alertas pendientes.</p>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="kanban-col">
            <div class="kanban-col-titulo">
                <span class="kanban-punto bg-warning"></span> En Proceso
                <span class="badge rounded-pill text-bg-light ms-1">@Model.EnProceso.Count</span>
            </div>
            @foreach (var t in Model.EnProceso)
            {
                <partial name="_AlertaTarjeta" model="t" />
            }
            @if (!Model.EnProceso.Any())
            {
                <p class="text-muted small mb-0">No hay alertas en proceso.</p>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="kanban-col">
            <div class="kanban-col-titulo">
                <span class="kanban-punto bg-success"></span> Atendida
                <span class="badge rounded-pill text-bg-light ms-1">@Model.Atendidas.Count</span>
            </div>
            @foreach (var t in Model.Atendidas)
            {
                <partial name="_AlertaTarjeta" model="t" />
            }
            @if (!Model.Atendidas.Any())
            {
                <p class="text-muted small mb-0">Todavía no hay alertas atendidas.</p>
            }
        </div>
    </div>
</div>
