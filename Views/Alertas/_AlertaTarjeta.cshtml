@model VITALIA.Models.ViewModels.AlertaTarjetaViewModel

@{
    var claseBadge = Model.Prioridad switch
    {
        "Urgente" => "bg-danger-subtle text-danger-emphasis",
        "Programada" => "bg-warning-subtle text-warning-emphasis",
        _ => "bg-info-subtle text-info-emphasis"
    };
}

<div class="card alerta-card prio-@Model.Prioridad.ToLowerInvariant() shadow-sm mb-3">
    <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
            <h6 class="fw-bold mb-0">@Model.Titulo</h6>
            <span class="badge rounded-pill @claseBadge flex-shrink-0">@Model.Prioridad</span>
        </div>

        <p class="small text-secondary mb-2">@Model.Descripcion</p>

        <div class="small text-muted d-flex flex-column gap-1">
            <span><i class="bi bi-person-fill me-1"></i>@Model.Residente <span class="text-body-tertiary">(@Model.CodigoResidente)</span></span>
            <span><i class="bi bi-person-badge me-1"></i>Responsable: @(Model.Responsable ?? "Sin asignar")</span>
            <span><i class="bi bi-clock me-1"></i>Programada: @Model.FechaProgramada.ToString("dd/MM/yyyy HH:mm")</span>
            <span><i class="bi bi-pencil-square me-1"></i>Creada por: @Model.CreadaPor</span>
        </div>

        @if (Model.Estado == "Pendiente")
        {
            <form asp-controller="Alertas" asp-action="CambiarEstado" method="post" class="mt-3">
                <input type="hidden" name="id" value="@Model.IdAlerta" />
                <input type="hidden" name="estadoEsperado" value="@Model.Estado" />
                <button type="submit" class="btn btn-sm btn-vitalia">Iniciar → En Proceso</button>
            </form>
        }
        else if (Model.Estado == "En Proceso")
        {
            <form asp-controller="Alertas" asp-action="CambiarEstado" method="post" class="mt-3">
                <input type="hidden" name="id" value="@Model.IdAlerta" />
                <input type="hidden" name="estadoEsperado" value="@Model.Estado" />
                <button type="submit" class="btn btn-sm btn-success fw-semibold">
                    <i class="bi bi-check2-circle me-1"></i>Marcar Atendida
                </button>
            </form>
        }
        else
        {
            <div class="mt-3 small">
                <span class="badge bg-success-subtle text-success-emphasis me-1">Cerrada</span>
                @if (Model.FechaCierre.HasValue)
                {
                    <span class="text-muted">
                        Atendida el @Model.FechaCierre.Value.ToString("dd/MM/yyyy HH:mm")
                        por @(Model.CerradaPor ?? "—")
                    </span>
                }
            </div>
        }

        <!-- Acciones CRUD -->
        <div class="d-flex gap-2 mt-3 pt-2 border-top">
            <a asp-controller="Alertas" asp-action="Details" asp-route-id="@Model.IdAlerta"
               class="btn btn-sm btn-outline-secondary flex-fill">
                <i class="bi bi-eye me-1"></i>Ver
            </a>
            @if (Model.Estado != "Atendida")
            {
                <a asp-controller="Alertas" asp-action="Edit" asp-route-id="@Model.IdAlerta"
                   class="btn btn-sm btn-outline-vitalia flex-fill">
                    <i class="bi bi-pencil-square me-1"></i>Editar
                </a>
            }
            @if (Model.Estado == "Pendiente")
            {
                <a asp-controller="Alertas" asp-action="Delete" asp-route-id="@Model.IdAlerta"
                   class="btn btn-sm btn-outline-danger flex-fill">
                    <i class="bi bi-trash me-1"></i>Eliminar
                </a>
            }
        </div>
    </div>
</div>
