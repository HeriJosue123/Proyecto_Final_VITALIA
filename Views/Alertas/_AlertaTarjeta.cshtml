@model VITALIA.Models.ViewModels.AlertaTarjetaViewModel

@{
    var (claseBorde, badgePrioridad) = Model.Prioridad switch
    {
        "Urgente" => ("border-danger", "bg-danger-subtle text-danger border border-danger-subtle"),
        "Programada" => ("border-warning", "bg-warning-subtle text-warning-emphasis border border-warning-subtle"),
        _ => ("border-info", "bg-info-subtle text-info-emphasis border border-info-subtle")
    };
}
<div class="card border-0 border-start border-4 @claseBorde rounded-4 shadow-sm mb-3 bg-white vitalia-card-pro" style="transition: all 0.2s ease-in-out;">
    <div class="card-body p-3.5">

        <!-- Encabezado de Tarjeta -->
        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
            <h6 class="fw-bold text-dark mb-0 fs-6 lh-sm">@Model.Titulo</h6>
            <span class="badge rounded-pill @badgePrioridad px-2.5 py-1 flex-shrink-0" style="font-size: 0.73rem;">
                @Model.Prioridad
            </span>
        </div>

        <!-- Descripción -->
        @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
        {
            <p class="small text-muted mb-3 lh-base" style="font-size: 0.85rem;">
                @Model.Descripcion
            </p>
        }

        <!-- Lista Limpia de Metadatos -->
        <div class="small mb-3 d-flex flex-column gap-2" style="font-size: 0.82rem;">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-person-circle fs-6" style="color: #14828a;"></i>
                <span class="text-secondary">Residente: <strong class="text-dark">@Model.Residente</strong> <span class="text-muted small">(@Model.CodigoResidente)</span></span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-person-badge fs-6" style="color: #14828a;"></i>
                <span class="text-secondary">Responsable: <span class="text-dark fw-semibold">@(Model.Responsable ?? "Sin asignar")</span></span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-calendar-event fs-6" style="color: #14828a;"></i>
                <span class="text-secondary">Programada: <span class="text-dark fw-semibold">@Model.FechaProgramada.ToString("dd/MM/yyyy HH:mm")</span></span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-person-gear fs-6" style="color: #14828a;"></i>
                <span class="text-secondary">Creada por: <span class="text-dark fw-semibold">@Model.CreadaPor</span></span>
            </div>
        </div>

        <!-- Accion Principal de Estado (Botones estéticos mejorados) -->
        @if (Model.Estado == "Pendiente")
        {
            <form asp-controller="Alertas" asp-action="CambiarEstado" method="post" class="mb-3">
                <input type="hidden" name="id" value="@Model.IdAlerta" />
                <input type="hidden" name="estadoEsperado" value="@Model.Estado" />
                <button type="submit" class="btn w-100 text-white fw-bold rounded-pill py-2.5 d-flex align-items-center justify-content-center gap-2 shadow-sm border-0 transition-all" style="background: linear-gradient(135deg, #14828a 0%, #093437 100%); font-size: 0.85rem;">
                    <i class="bi bi-play-circle-fill fs-6"></i>
                    <span>Iniciar → En Proceso</span>
                </button>
            </form>
        }
        else if (Model.Estado == "En Proceso")
        {
            <form asp-controller="Alertas" asp-action="CambiarEstado" method="post" class="mb-3">
                <input type="hidden" name="id" value="@Model.IdAlerta" />
                <input type="hidden" name="estadoEsperado" value="@Model.Estado" />
                <button type="submit" class="btn w-100 text-white fw-bold rounded-pill py-2.5 d-flex align-items-center justify-content-center gap-2 shadow-sm border-0 transition-all" style="background: linear-gradient(135deg, #198754 0%, #105233 100%); font-size: 0.85rem;">
                    <i class="bi bi-check-circle-fill fs-6"></i>
                    <span>Marcar Atendida</span>
                </button>
            </form>
        }
        else
        {
            <!-- Bloque Estético para Alerta Cerrada/Atendida -->
            <div class="mb-3 p-3 rounded-4 bg-success-subtle border border-success-subtle d-flex align-items-start gap-3 shadow-sm">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success text-white flex-shrink-0 mt-0.5" style="width: 26px; height: 26px;">
                    <i class="bi bi-check-lg" style="font-size: 0.85rem;"></i>
                </div>
                <div class="flex-grow-1" style="font-size: 0.81rem; line-height: 1.4;">
                    <div class="fw-bold text-success-emphasis mb-0.5" style="font-size: 0.85rem; letter-spacing: 0.2px;">Alerta Cerrada</div>
                    <div class="text-secondary">
                        Atendida el <span class="fw-semibold text-dark">@(Model.FechaCierre?.ToString("dd/MM/yyyy HH:mm") ?? "—")</span>
                    </div>
                    <div class="text-secondary text-break mt-0.5">
                        Por: <span class="fw-semibold text-dark">@(Model.CerradaPor ?? "—")</span>
                    </div>
                </div>
            </div>
        }

        <!-- Botonera CRUD Limpia y Balanceada -->
        <div class="row g-1.5 pt-2 border-top">
            <div class="col-4">
                <a asp-controller="Alertas" asp-action="Details" asp-route-id="@Model.IdAlerta"
                   class="btn btn-sm btn-light border text-dark rounded-3 w-100 py-1.5 d-flex align-items-center justify-content-center gap-1 fw-semibold" style="font-size: 0.78rem;">
                    <i class="bi bi-eye text-muted"></i> Ver
                </a>
            </div>
            @if (Model.Estado != "Atendida")
            {
                <div class="col-4">
                    <a asp-controller="Alertas" asp-action="Edit" asp-route-id="@Model.IdAlerta"
                       class="btn btn-sm btn-light border rounded-3 w-100 py-1.5 d-flex align-items-center justify-content-center gap-1 fw-semibold" style="font-size: 0.78rem; color: #14828a;">
                        <i class="bi bi-pencil-square"></i> Editar
                    </a>
                </div>
            }
            @if (Model.Estado == "Pendiente")
            {
                <div class="col-4">
                    <a asp-controller="Alertas" asp-action="Delete" asp-route-id="@Model.IdAlerta"
                       class="btn btn-sm btn-light border border-danger-subtle text-danger rounded-3 w-100 py-1.5 d-flex align-items-center justify-content-center gap-1 fw-semibold" style="font-size: 0.78rem;">
                        <i class="bi bi-trash"></i> Eliminar
                    </a>
                </div>
            }
        </div>

    </div>
</div>