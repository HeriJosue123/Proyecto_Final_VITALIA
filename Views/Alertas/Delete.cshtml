@model VITALIA.Models.ViewModels.AlertaDetalleViewModel

@{
    ViewData["Title"] = "Eliminar Alerta";
}

<div class="d-flex justify-content-center align-items-center min-vh-100 py-4 animate-fade-up">
    <div style="width: 100%; max-width: 500px;" class="my-auto">

        <!-- Tarjeta Principal de Eliminación -->
        <div class="card border-0 rounded-4 shadow-sm overflow-hidden bg-white">
            
            <!-- Encabezado Rojo -->
            <div class="py-3 px-4 text-center text-white" style="background: linear-gradient(135deg, #dc3545 0%, #a71d2a 100%);">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white text-danger shadow-sm mb-2" style="width: 44px; height: 44px;">
                    <i class="bi bi-trash3-fill fs-5"></i>
                </div>
                <h5 class="fw-bold mb-1">Confirmar Eliminación</h5>
                <!-- Texto menos opaco y más claro -->
                <p class="text-white small mb-0 opacity-90 fw-medium" style="font-size: 0.85rem;">¿Desea eliminar permanentemente esta alerta?</p>
            </div>

            <div class="card-body p-3">
                
                <!-- Advertencia (Más ancha/gruesa) -->
                <div class="p-3 px-3 rounded-3 mb-3 d-flex align-items-center gap-2" style="background-color: #fff5f5; border-left: 4px solid #dc3545;">
                    <i class="bi bi-exclamation-octagon-fill text-danger fs-6 flex-shrink-0"></i>
                    <div class="small text-danger-emphasis fw-medium" style="font-size: 0.8rem;">
                        <strong>Atención:</strong> Esta acción no se puede deshacer.
                    </div>
                </div>

                <!-- Título de la Alerta (Menos comprimido) -->
                <div class="bg-light p-3 rounded-3 mb-3 border border-light-subtle">
                    <span class="text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.6px;">
                        TÍTULO DE LA ALERTA
                    </span>
                    <span class="fs-6 fw-bold text-dark d-block lh-base">@Model.Titulo</span>
                </div>

                <!-- Grilla de Detalle -->
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <div class="p-2 px-3 rounded-3 bg-body-tertiary h-100">
                            <span class="text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 0.62rem; letter-spacing: 0.5px;">RESIDENTE</span>
                            <div class="fw-bold text-dark lh-sm" style="font-size: 0.85rem;">@Model.Residente</div>
                            <span class="badge bg-secondary-subtle text-secondary border mt-1" style="font-size: 0.65rem;">@Model.CodigoResidente</span>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="p-2 px-3 rounded-3 bg-body-tertiary h-100">
                            <span class="text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 0.62rem; letter-spacing: 0.5px;">PRIORIDAD</span>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-semibold px-2 py-1" style="font-size: 0.75rem;">
                                <i class="bi bi-tag-fill me-1"></i>@Model.Prioridad
                            </span>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="p-2 px-3 rounded-3 bg-body-tertiary h-100">
                            <!-- Separación entre título y fecha aumentada (mb-2) -->
                            <span class="text-uppercase fw-bold text-muted d-block mb-2" style="font-size: 0.62rem; letter-spacing: 0.5px;">FECHA PROGRAMADA</span>
                            <div class="fw-semibold text-dark lh-sm" style="font-size: 0.85rem;">
                                <i class="bi bi-calendar3 me-1 text-muted"></i>@Model.FechaProgramada.ToString("dd/MM/yyyy")
                            </div>
                            <!-- Separación entre fecha y hora reducida (mt-1) -->
                            <small class="text-muted d-block mt-1" style="font-size: 0.72rem;">
                                <i class="bi bi-clock me-1"></i>@Model.FechaProgramada.ToString("HH:mm") hrs
                            </small>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="p-2 px-3 rounded-3 bg-body-tertiary h-100">
                            <span class="text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 0.62rem; letter-spacing: 0.5px;">ESTADO ACTUAL</span>
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle fw-semibold px-2 py-1" style="font-size: 0.75rem;">
                                <i class="bi bi-hourglass-split me-1"></i>@Model.Estado
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Botones de Acción (Íconos más separados del texto) -->
                <form asp-action="Delete" method="post" class="pt-1">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.IdAlerta" />

                    <div class="row g-2">
                        <div class="col-6">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-3 py-2 fw-semibold w-100 d-flex align-items-center justify-content-center border-2 transition-all" style="font-size: 0.85rem;">
                                <i class="bi bi-x-circle fs-6 me-2"></i> Cancelar
                            </a>
                        </div>
                        <div class="col-6">
                            <button type="submit" class="btn btn-danger rounded-3 py-2 fw-bold shadow-sm w-100 d-flex align-items-center justify-content-center transition-all" style="background-color: #dc3545; font-size: 0.85rem;">
                                <i class="bi bi-trash-fill fs-6 me-2"></i> Confirmar
                            </button>
                        </div>
                    </div>
                </form>

            </div>
        </div>

    </div>
</div>

<style>
    .transition-all {
        transition: all 0.2s ease-in-out;
    }
    .transition-all:hover {
        transform: translateY(-1px);
    }
</style>