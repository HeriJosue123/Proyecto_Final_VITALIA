@model VITALIA.Models.ViewModels.AlertaFormViewModel

@{
    ViewData["Title"] = "Nueva Alerta";
}

<div class="animate-fade-up py-4 d-flex justify-content-center">
    <div style="width: 100%; max-width: 680px;" class="px-3">

        <!-- Tarjeta Principal con Encabezado Verde Integrado -->
        <div class="card border-0 rounded-4 shadow-sm overflow-hidden bg-white">
            
            <!-- Encabezado Estilo Bloque Verde -->
            <div class="p-4 text-white d-flex align-items-center justify-content-between flex-wrap gap-3" style="background: linear-gradient(135deg, #14828a 0%, #093437 100%);">
                <div class="d-flex align-items-center gap-3">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white shadow-sm" style="width: 44px; height: 44px; color: #14828a !important;">
                        <i class="bi bi-bell-fill fs-5"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0 text-white">Nueva Alerta</h4>
                        <p class="text-white-50 small mb-0">Se crea en estado <strong>Pendiente</strong> y registra fecha, hora y usuario.</p>
                    </div>
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-sm btn-light text-dark rounded-pill px-3 py-1.5 fw-semibold shadow-sm text-decoration-none">
                        ← Volver a la lista
                    </a>
                </div>
            </div>

            <!-- Cuerpo del Formulario -->
            <div class="card-body p-4 p-md-5">
                
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 small" role="alert"></div>

                    <!-- Campos parciales del formulario -->
                    <partial name="_AlertaFormCampos" model="Model" />

                    <!-- SECCIÓN DE MEDICAMENTO (EXCLUSIVA PARA MÉDICOS) -->
                    @if (Model.EsMedico)
                    {
                        <div class="p-4 mt-4 mb-4 rounded-4 shadow-sm" style="background-color: #f4fbfc; border: 1px dashed #14828a;">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white shadow-sm" style="width: 32px; height: 32px; color: #14828a;">
                                    <i class="bi bi-capsule fs-6"></i>
                                </div>
                                <h6 class="fw-bold mb-0" style="color: #14828a;">Prescripción de Medicamento</h6>
                                <span class="badge bg-white text-muted border ms-auto small">Opcional</span>
                            </div>
                            
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label text-muted small fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                        <i class="bi bi-box-seam me-1"></i> MEDICAMENTO (STOCK)
                                    </label>
                                    <select asp-for="IdMedicamento" asp-items="Model.Medicamentos" class="form-select border-0 shadow-sm rounded-3">
                                        <option value="">-- Sin recetar medicamento --</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted small fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                        <i class="bi bi-pencil-square me-1"></i> DOSIS Y FRECUENCIA
                                    </label>
                                    <input asp-for="Dosis" type="text" class="form-control border-0 shadow-sm rounded-3" placeholder="Ej. 1 tableta cada 8 horas">
                                </div>
                            </div>
                        </div>
                    }

                    <!-- BOTONES DE ACCIÓN BALANCEADOS -->
                    <div class="d-flex gap-2 pt-3 border-top mt-4">
                        <a asp-action="Index" class="btn btn-light rounded-3 py-2.5 px-4 fw-semibold text-secondary flex-grow-1 text-center">
                            Cancelar
                        </a>
                        <button type="submit" class="btn text-white fw-bold rounded-3 py-2.5 px-4 shadow-sm flex-grow-1 d-flex align-items-center justify-content-center gap-2" style="background: linear-gradient(135deg, #14828a 0%, #093437 100%); transition: all 0.2s ease;">
                            <i class="bi bi-check-circle-fill"></i> Guardar Alerta
                        </button>
                    </div>
                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}