@{
    ViewData["Title"] = "Panel Principal";
    int totalResidentes = ViewBag.TotalResidentes ?? 0;
    int totalPersonal = ViewBag.TotalPersonal ?? 0;
    int atencionesHoy = ViewBag.AtencionesHoy ?? 0;
    int alertasPendientes = ViewBag.AlertasPendientes ?? 0;
}

<style>
    .dashboard-banner {
        background: linear-gradient(135deg, #0d3c3d 0%, #118a8b 100%);
        color: white;
        border-radius: 1rem;
    }

    .kpi-card {
        border: none;
        border-radius: 1rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .kpi-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08) !important;
    }

    .kpi-icon-box {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
    }

    .module-card {
        border: none;
        border-radius: 1rem;
        transition: all 0.2s ease;
        background-color: #ffffff;
    }

    .module-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08) !important;
    }

    .btn-vitalia-accent {
        background-color: #118a8b;
        color: white;
        border-radius: 0.6rem;
        font-weight: 600;
        transition: background 0.2s;
    }

    .btn-vitalia-accent:hover {
        background-color: #0d6d6e;
        color: white;
    }
</style>

<!-- Banner de Bienvenida -->
<div class="dashboard-banner p-4 p-md-5 mb-4 shadow-sm position-relative overflow-hidden">
    <div class="row align-items-center position-relative z-1">
        <div class="col-lg-8 mb-3 mb-lg-0">
            <span class="badge bg-white text-dark px-3 py-2 rounded-pill fw-semibold mb-2">
                <i class="bi bi-shield-check text-success me-1"></i> Plataforma Operativa Activa
            </span>
            <h2 class="fw-bold display-6 mb-2">Bienvenido a VITALIA</h2>
            <p class="mb-0 opacity-90 leading-relaxed" style="max-width: 600px;">
                Gestión integral, seguimiento médico y administración para la atención de adultos mayores.
            </p>
        </div>
        <div class="col-lg-4 text-lg-end">
            <div class="d-inline-flex flex-column align-items-lg-end bg-white bg-opacity-10 p-3 rounded-4 backdrop-blur">
                <small class="text-white-50 text-uppercase fw-bold" style="font-size: 0.7rem; letter-spacing: 1px;">Fecha del Servidor</small>
                <span class="fw-bold fs-5 text-white">@DateTime.Now.ToString("dd 'de' MMMM, yyyy")</span>
            </div>
        </div>
    </div>
</div>

<!-- Tarjetas KPI (Métricas Rápidas) -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card kpi-card shadow-sm p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-bold text-uppercase d-block mb-1" style="font-size: 0.7rem;">Residentes Activos</span>
                    <h3 class="fw-bold mb-0 text-dark">@totalResidentes</h3>
                </div>
                <div class="kpi-icon-box bg-primary-subtle text-primary">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
            <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                <small class="text-muted" style="font-size: 0.75rem;">Expedientes registrados</small>
                <a asp-controller="Residentes" asp-action="Index" class="text-decoration-none small fw-bold text-primary">Ver todos →</a>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card kpi-card shadow-sm p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-bold text-uppercase d-block mb-1" style="font-size: 0.7rem;">Personal Activo</span>
                    <h3 class="fw-bold mb-0 text-dark">@totalPersonal</h3>
                </div>
                <div class="kpi-icon-box bg-info-subtle text-info-emphasis">
                    <i class="bi bi-person-vcard-fill"></i>
                </div>
            </div>
            <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                <small class="text-muted" style="font-size: 0.75rem;">Cuidadores y médicos</small>
                <a asp-controller="Personal" asp-action="Index" class="text-decoration-none small fw-bold text-info-emphasis">Ver equipo →</a>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card kpi-card shadow-sm p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-bold text-uppercase d-block mb-1" style="font-size: 0.7rem;">Atenciones Hoy</span>
                    <h3 class="fw-bold mb-0 text-dark">@atencionesHoy</h3>
                </div>
                <div class="kpi-icon-box bg-success-subtle text-success">
                    <i class="bi bi-journal-check"></i>
                </div>
            </div>
            <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                <small class="text-muted" style="font-size: 0.75rem;">Registros de bitácora</small>
                <a asp-controller="Bitacora" asp-action="Index" class="text-decoration-none small fw-bold text-success">Ver bitácora →</a>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card kpi-card shadow-sm p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-bold text-uppercase d-block mb-1" style="font-size: 0.7rem;">Alertas Activas</span>
                    <h3 class="fw-bold mb-0 @(alertasPendientes > 0 ? "text-danger" : "text-dark")">@alertasPendientes</h3>
                </div>
                <div class="kpi-icon-box @(alertasPendientes > 0 ? "bg-danger-subtle text-danger" : "bg-light text-muted")">
                    <i class="bi bi-bell-fill"></i>
                </div>
            </div>
            <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                <small class="text-muted" style="font-size: 0.75rem;">Requieren atención</small>
                <a asp-controller="Alertas" asp-action="Index" class="text-decoration-none small fw-bold text-danger">Ver alertas →</a>
            </div>
        </div>
    </div>
</div>

<!-- Módulos de Acceso Rápido -->
<div class="mb-3">
    <h5 class="fw-bold text-dark mb-1">Módulos del Sistema</h5>
    <p class="text-muted small mb-3">Acceso rápido a las herramientas operativas de Vitalia</p>
</div>

<div class="row g-4 mb-4">
    <div class="col-12 col-md-6 col-lg-4">
        <div class="card module-card shadow-sm p-4 h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="kpi-icon-box bg-primary-subtle text-primary">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Módulo Activo</span>
                </div>
                <h5 class="fw-bold text-dark mb-2">Residentes</h5>
                <p class="text-muted small mb-4">
                    Administración de expedientes clínicos, contactos de familiares y asignación habitacional.
                </p>
            </div>
            <a asp-controller="Residentes" asp-action="Index" class="btn btn-vitalia-accent w-100 py-2 d-flex align-items-center justify-content-center gap-2">
                <span>Ingresar al Módulo</span>
                <i class="bi bi-arrow-right-short fs-5"></i>
            </a>
        </div>
    </div>

    <div class="col-12 col-md-6 col-lg-4">
        <div class="card module-card shadow-sm p-4 h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="kpi-icon-box bg-success-subtle text-success">
                        <i class="bi bi-journal-medical"></i>
                    </div>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Módulo Activo</span>
                </div>
                <h5 class="fw-bold text-dark mb-2">Bitácora de Atenciones</h5>
                <p class="text-muted small mb-4">
                    Registro cronológico inmutable de medicaciones, signos vitales, alimentación y actividades.
                </p>
            </div>
            <a asp-controller="Bitacora" asp-action="Index" class="btn btn-vitalia-accent w-100 py-2 d-flex align-items-center justify-content-center gap-2">
                <span>Ingresar al Módulo</span>
                <i class="bi bi-arrow-right-short fs-5"></i>
            </a>
        </div>
    </div>

    <div class="col-12 col-md-6 col-lg-4">
        <div class="card module-card shadow-sm p-4 h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="kpi-icon-box bg-warning-subtle text-warning-emphasis">
                        <i class="bi bi-bell-fill"></i>
                    </div>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Módulo Activo</span>
                </div>
                <h5 class="fw-bold text-dark mb-2">Alertas y Tareas</h5>
                <p class="text-muted small mb-4">
                    Gestión de incidencias, recordatorios de tratamientos y seguimiento de tareas prioritarias.
                </p>
            </div>
            <a asp-controller="Alertas" asp-action="Index" class="btn btn-vitalia-accent w-100 py-2 d-flex align-items-center justify-content-center gap-2">
                <span>Ingresar al Módulo</span>
                <i class="bi bi-arrow-right-short fs-5"></i>
            </a>
        </div>
    </div>
</div>