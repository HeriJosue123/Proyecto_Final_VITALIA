@{
    ViewData["Title"] = "Inicio";
}

<!-- Banner / Encabezado Principal -->
<div class="card border-0 shadow-sm rounded-4 mb-4 bg-white p-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="d-flex align-items-center justify-content-center rounded-3 text-white" style="width: 48px; height: 48px; background-color: #12898e;">
                <i class="bi bi-suit-heart-fill fs-4"></i>
            </div>
            <div>
                <h3 class="fw-bold mb-0 text-dark">VITALIA</h3>
                <p class="text-muted small mb-0">Plataforma Integral de Gestión, Cuidado y Bienestar del Adulto Mayor</p>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Residentes" asp-action="Index" class="btn btn-vitalia">
                <i class="bi bi-people-fill me-1"></i> Residentes
            </a>
        </div>
    </div>
</div>

<!-- Título de sección -->
<div class="mb-3">
    <h5 class="fw-bold text-dark mb-1">Módulos de Gestión</h5>
    <p class="text-muted small">Administración de expedientes de residentes</p>
</div>

<!-- Tarjetas de Módulos -->
<div class="row g-4">
    <!-- Módulo Residentes -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-white">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="rounded-3 d-flex align-items-center justify-content-center text-white" style="width: 46px; height: 46px; background-color: #12898e;">
                    <i class="bi bi-people-fill fs-5"></i>
                </div>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5 rounded-pill small">
                    <i class="bi bi-check-circle-fill me-1"></i> Módulo Activo
                </span>
            </div>
            <h5 class="fw-bold text-dark mb-2">Residentes</h5>
            <p class="text-muted small mb-4">Expedientes de adultos mayores, información personal, fechas de ingreso y asignación de habitaciones.</p>
            <div class="mt-auto">
                <a asp-controller="Residentes" asp-action="Index" class="btn btn-vitalia w-100 d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-arrow-right-circle-fill"></i> Ingresar al Módulo
                </a>
            </div>
        </div>
    </div>
</div>