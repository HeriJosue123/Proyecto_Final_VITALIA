            <a asp-controller="Alertas" asp-action="Index" class="btn btn-vitalia-accent w-100 py-2 d-flex align-items-center justify-content-center gap-2">
                <span>Ingresar al Módulo</span>
                <i class="bi bi-arrow-right-short fs-5"></i>
            </a>
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
        <div class="card module-card shadow-sm p-4 h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="kpi-icon-box bg-info-subtle text-info-emphasis">
                        <i class="bi bi-capsule"></i>
                    </div>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Módulo Activo</span>
                </div>
                <h5 class="fw-bold text-dark mb-2">Farmacia y Stock</h5>
