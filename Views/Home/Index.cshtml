@{
    ViewData["Title"] = "Panel Principal";
    int totalResidentes = ViewBag.TotalResidentes ?? 0;
    int totalPersonal = ViewBag.TotalPersonal ?? 0;
    int atencionesHoy = ViewBag.AtencionesHoy ?? 0;
    int alertasPendientes = ViewBag.AlertasPendientes ?? 0;
    int totalMedicamentos = ViewBag.TotalMedicamentos ?? 0;
    bool esAdmin = User.IsInRole(RolesSistema.Administrador);
}

<style>
    /* Bloquea de raíz cualquier desbordamiento horizontal en esta página */
    body, .vitalia-content {
        overflow-x: hidden !important;
    }

    .dashboard-banner {
        background: linear-gradient(135deg, #0d3c3d 0%, #118a8b 100%);
        color: white;
        border-radius: 1rem;
    }

    /* Contenedor exterior estricto: no permite que NADA salga fuera del ancho */
    .kpi-carousel-outer {
        position: relative;
        width: 100%;
        max-width: 100%;
        overflow: hidden;
        padding: 0 45px; /* Espacio exacto reservado para las flechas dentro del marco */
        box-sizing: border-box;
    }

    /* Pista interna deslizable */
    .kpi-scroll-track {
        display: flex;
        gap: 0.75rem;
        overflow-x: auto;
        scroll-behavior: smooth;
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE / Edge */
        padding: 0.4rem 0.1rem;
        cursor: grab;
        user-select: none;
        width: 100%;
        box-sizing: border-box;
    }

    .kpi-scroll-track:active {
        cursor: grabbing;
    }

    .kpi-scroll-track::-webkit-scrollbar {
        display: none; /* Chrome / Safari / Edge */
    }

    /* Tarjetas cuadradas y compactas (4 exactas encajadas en pantalla) */
    .kpi-card-item {
        flex: 0 0 calc((100% - 2.25rem) / 4);
        min-width: 200px;
        box-sizing: border-box;
    }

    @@media (max-width: 1100px) {
        .kpi-card-item { flex: 0 0 calc((100% - 1.5rem) / 3); }
    }

    @@media (max-width: 768px) {
        .kpi-card-item { flex: 0 0 calc((100% - 0.75rem) / 2); }
    }

    @@media (max-width: 500px) {
        .kpi-card-item { flex: 0 0 100%; }
    }

    /* Estilo de tarjetas KPI original */
    .kpi-card {
        border: none;
        border-radius: 1rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        height: 100%;
        background-color: #ffffff;
    }

    .kpi-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08) !important;
    }

    .kpi-icon-box {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
    }

    /* Flechas situadas 100% adentro en los extremos del padding sin tocar las tarjetas */
    .btn-kpi-extreme {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 1px solid #cbd5e1;
        background-color: #ffffff;
        color: #64748b;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        cursor: pointer;
        box-shadow: 0 3px 10px rgba(9, 52, 55, 0.12);
        z-index: 20;
    }

    .btn-kpi-extreme:hover {
        background: linear-gradient(135deg, #118a8b 0%, #0d3c3d 100%);
        color: #ffffff;
        border-color: #118a8b;
        transform: translateY(-50%) scale(1.08);
        box-shadow: 0 6px 14px rgba(17, 138, 139, 0.3);
    }

    .btn-kpi-prev-extreme {
        left: 2px;
    }

    .btn-kpi-next-extreme {
        right: 2px;
    }

    .module-card {
        border: none;
        border-radius: 1rem;
        transition: all 0.2s ease;
        background-color: #ffffff;
    }

    .module-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08) !important;
    }

    .btn-vitalia-accent {
        background-color: #118a8b;
        color: white;
        border-radius: 0.6rem;
        font-weight: 600;
        transition: background 0.2s;
    }

    .btn-vitalia-accent:hover {
        background-color: #0d6d6e;
        color: white;
    }
</style>

<!-- Banner de Bienvenida -->
<div class="dashboard-banner p-4 p-md-5 mb-4 shadow-sm position-relative overflow-hidden">
    <div class="row align-items-center position-relative z-1">
        <div class="col-lg-8 mb-3 mb-lg-0">
            <span class="badge bg-white text-dark px-3 py-2 rounded-pill fw-semibold mb-2">
                <i class="bi bi-shield-check text-success me-1"></i> Plataforma Operativa Activa
            </span>
            <h2 class="fw-bold display-6 mb-2">Bienvenido a VITALIA</h2>
            <p class="mb-0 opacity-90 leading-relaxed" style="max-width: 600px;">
                Gestión integral, seguimiento médico y administración para la atención de adultos mayores.
            </p>
        </div>
        <div class="col-lg-4 text-lg-end">
            <div class="d-inline-flex flex-column align-items-lg-end bg-white bg-opacity-10 p-3 rounded-4 backdrop-blur">
                <small class="text-white-50 text-uppercase fw-bold" style="font-size: 0.7rem; letter-spacing: 1px;">Fecha del Servidor</small>
                <span class="fw-bold fs-5 text-white">@DateTime.Now.ToString("dd 'de' MMMM, yyyy")</span>
            </div>
        </div>
    </div>
</div>

<!-- TÍTULO RESUMEN GENERAL -->
<div class="mb-2 px-1">
    <span class="text-muted small fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.6px;">
        <i class="bi bi-speedometer2 me-1" style="color: #118a8b;"></i> RESUMEN GENERAL DEL SISTEMA
    </span>
</div>

<!-- CONTENEDOR TOTALMENTE FIJO SIN SCROLLBAR EN EL NAVEGADOR -->
<div class="kpi-carousel-outer mb-4">
    
    <!-- Botón Izquierdo -->
    <button type="button" id="kpiPrevBtn" class="btn-kpi-extreme btn-kpi-prev-extreme" title="Anterior">
        <i class="bi bi-chevron-left"></i>
    </button>

    <!-- Pista de Tarjetas Deslizable -->
    <div class="kpi-scroll-track" id="kpiScrollTrack">
        
        <!-- 1. Residentes -->
        <div class="kpi-card-item">
            <div class="card kpi-card shadow-sm p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-bold text-uppercase d-block mb-1" style="font-size: 0.7rem;">Residentes Activos</span>
                        <h3 class="fw-bold mb-0 text-dark">@totalResidentes</h3>
                    </div>
                    <div class="kpi-icon-box bg-primary-subtle text-primary">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
                <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                    <small class="text-muted" style="font-size: 0.75rem;">Expedientes registrados</small>
                    <a asp-controller="Residentes" asp-action="Index" class="text-decoration-none small fw-bold text-primary">Ver todos →</a>
                </div>
            </div>
        </div>

        <!-- 2. Personal -->
        <div class="kpi-card-item">
            <div class="card kpi-card shadow-sm p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-bold text-uppercase d-block mb-1" style="font-size: 0.7rem;">Personal Activo</span>
                        <h3 class="fw-bold mb-0 text-dark">@totalPersonal</h3>
                    </div>
                    <div class="kpi-icon-box bg-info-subtle text-info-emphasis">
                        <i class="bi bi-person-vcard-fill"></i>
                    </div>
                </div>
                <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                    <small class="text-muted" style="font-size: 0.75rem;">Cuidadores y médicos</small>
                    @if (esAdmin)
                    {
                        <a asp-controller="Personal" asp-action="Index" class="text-decoration-none small fw-bold text-info-emphasis">Ver equipo →</a>
                    }
                </div>
            </div>
        </div>

        <!-- 3. Atenciones -->
        <div class="kpi-card-item">
            <div class="card kpi-card shadow-sm p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-bold text-uppercase d-block mb-1" style="font-size: 0.7rem;">Atenciones Hoy</span>
                        <h3 class="fw-bold mb-0 text-dark">@atencionesHoy</h3>
                    </div>
                    <div class="kpi-icon-box bg-success-subtle text-success">
                        <i class="bi bi-journal-check"></i>
                    </div>
                </div>
                <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                    <small class="text-muted" style="font-size: 0.75rem;">Registros de bitácora</small>
                    <a asp-controller="Bitacora" asp-action="Index" class="text-decoration-none small fw-bold text-success">Ver bitácora →</a>
                </div>
            </div>
        </div>

        <!-- 4. Alertas -->
        <div class="kpi-card-item">
            <div class="card kpi-card shadow-sm p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-bold text-uppercase d-block mb-1" style="font-size: 0.7rem;">Alertas Activas</span>
                        <h3 class="fw-bold mb-0 @(alertasPendientes > 0 ? "text-danger" : "text-dark")">@alertasPendientes</h3>
                    </div>
                    <div class="kpi-icon-box @(alertasPendientes > 0 ? "bg-danger-subtle text-danger" : "bg-light text-muted")">
                        <i class="bi bi-bell-fill"></i>
                    </div>
                </div>
                <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                    <small class="text-muted" style="font-size: 0.75rem;">Requieren atención</small>
                    <a asp-controller="Alertas" asp-action="Index" class="text-decoration-none small fw-bold text-danger">Ver alertas →</a>
                </div>
            </div>
        </div>

        <!-- 5. Farmacia y Stock -->
        <div class="kpi-card-item">
            <div class="card kpi-card shadow-sm p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-bold text-uppercase d-block mb-1" style="font-size: 0.7rem;">Medicamentos en catálogo</span>
                        <h3 class="fw-bold mb-0 text-dark">@totalMedicamentos</h3>
                    </div>
                    <div class="kpi-icon-box bg-warning-subtle text-warning-emphasis">
                        <i class="bi bi-capsule"></i>
                    </div>
                </div>
                <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                    <small class="text-muted" style="font-size: 0.75rem;">Fármacos registrados</small>
                    <a asp-controller="Farmacia" asp-action="Index" class="text-decoration-none small fw-bold text-warning-emphasis">Ver inventario →</a>
                </div>
            </div>
        </div>

        <!-- 6. Respaldos del Sistema -->
        <div class="kpi-card-item">
            <div class="card kpi-card shadow-sm p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-bold text-uppercase d-block mb-1" style="font-size: 0.7rem;">Copias de Seguridad</span>
                        <h3 class="fw-bold mb-0 text-success" style="font-size: 1.25rem;"><i class="bi bi-check-circle-fill"></i> Al Día</h3>
                    </div>
                    <div class="kpi-icon-box bg-secondary-subtle text-dark">
                        <i class="bi bi-hdd-fill"></i>
                    </div>
                </div>
                <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                    <small class="text-muted" style="font-size: 0.75rem;">Base de Datos SQL</small>
                    @if (esAdmin)
                    {
                        <a asp-controller="Respaldos" asp-action="Index" class="text-decoration-none small fw-bold text-dark">Gestionar →</a>
                    }
                </div>
            </div>
        </div>

    </div>

    <!-- Botón Derecho -->
    <button type="button" id="kpiNextBtn" class="btn-kpi-extreme btn-kpi-next-extreme" title="Siguiente">
        <i class="bi bi-chevron-right"></i>
    </button>
</div>

<!-- MÓDULOS OPERATIVOS -->
