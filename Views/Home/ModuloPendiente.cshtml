@{
    ViewData["Title"] = $"{ViewBag.ModuloNombre} - En Planificación";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-light border-0 py-4 px-4 text-center">
                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill text-uppercase fw-semibold mb-2">
                        <i class="bi bi-clock-history me-1"></i> Módulo en Planificación
                    </span>
                    <h2 class="h3 fw-bold text-dark mt-2 mb-1">Módulo: @ViewBag.ModuloNombre</h2>
                    <p class="text-muted mb-0">Plataforma Integral VITALIA</p>
                </div>
                <div class="card-body p-4 p-md-5 text-center">
                    <div class="mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning-subtle text-warning p-4 mb-3" style="width: 80px; height: 80px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" class="bi bi-cone-striped" viewBox="0 0 16 16">
                                <path d="m9.97 4.88.953 3.811C10.159 8.878 9.14 9 8 9s-2.158-.122-2.923-.309L6.03 4.88C6.635 4.957 7.3 5 8 5s1.365-.043 1.97-.12zm-.245-.978L9.246 1.99C9.027 1.407 8.544 1 8 1s-1.027.407-1.246.99L6.275 3.9C6.826 3.966 7.402 4 8 4s1.174-.034 1.725-.098m4.396 8.613a.5.5 0 0 1 .037.96l-6 2a.5.5 0 0 1-.316 0l-6-2a.5.5 0 0 1 .037-.96l2.391-.598.565-2.257c.862.211 1.906.335 3.01.335s2.148-.124 3.01-.335l.565 2.257z"/>
                            </svg>
                        </div>
                        <h4 class="fw-semibold text-secondary">Este módulo aún no ha sido implementado</h4>
                        <p class="text-muted col-md-10 mx-auto">
                            El módulo <strong>@ViewBag.ModuloNombre</strong> está programado para desarrollarse en las siguientes etapas según la matriz de requerimientos del sistema.
                        </p>
                    </div>

                    <div class="alert alert-light border rounded-3 text-start mx-auto p-3 mb-4" style="max-width: 520px;">
                        <h6 class="fw-bold mb-2 text-dark">
                            <i class="bi bi-info-circle me-1 text-primary"></i> Estado actual del desarrollo:
                        </h6>
                        <ul class="list-unstyled mb-0 text-secondary small">
                            <li class="mb-1">✓ <strong>Fase 1 (Completada):</strong> Estructura base, Entity Framework Core y conexión a SQL Server.</li>
                            <li class="mb-1">⏳ <strong>Fase 2 (Próxima):</strong> Implementación de <strong>Residentes y Habitaciones</strong>.</li>
                            <li>📋 <strong>Fases posteriores:</strong> Personal, Cuidados, Actividades, Visitas, Incidentes y Reportes.</li>
                        </ul>
                    </div>

                    <div class="d-flex justify-content-center gap-2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold shadow-sm">
                            Volver al Inicio
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
