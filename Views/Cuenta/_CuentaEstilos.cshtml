@* Estilos compartidos por las páginas de Cuenta (se ven sin el menú lateral) *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
<style>
    body {
        min-height: 100vh;
        margin: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem 1rem;
        background: linear-gradient(135deg, #093437 0%, #0d3c3d 45%, #118a8b 100%);
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    }

    .cuenta-tarjeta {
        width: 100%;
        max-width: 420px;
        background: #ffffff;
        border-radius: 18px;
        box-shadow: 0 20px 45px -12px rgba(0, 0, 0, 0.35);
        padding: 2.25rem 2rem;
    }

    .cuenta-marca {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .6rem;
        font-size: 1.5rem;
        font-weight: 700;
        color: #093437;
    }

    .cuenta-icono {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background-color: #17a2a8;
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-vitalia {
        background-color: #12898e;
        border-color: #12898e;
        color: #ffffff;
        font-weight: 600;
        border-radius: 10px;
        padding: .65rem 1rem;
    }

        .btn-vitalia:hover, .btn-vitalia:focus {
            background-color: #0e6c70;
            border-color: #0e6c70;
            color: #ffffff;
        }

    .form-control:focus, .form-check-input:focus {
        border-color: #14828a;
        box-shadow: 0 0 0 .25rem rgba(20, 130, 138, .18);
    }

    .form-check-input:checked {
        background-color: #12898e;
        border-color: #12898e;
    }
</style>
