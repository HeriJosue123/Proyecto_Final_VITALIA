@model VITALIA.Models.ViewModels.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar sesión - VITALIA</title>
    <partial name="_CuentaEstilos" />
    @* Diseño basado en el formulario de Uiverse.io (Yaya12085), con los colores de VITALIA *@
    <style>
        .login-tarjeta {
            width: 100%;
            max-width: 380px;
            border-radius: 0.9rem;
            background-color: #082b2e;
            border: 1px solid rgba(255, 255, 255, 0.06);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            padding: 2.25rem 2rem 1.75rem;
            color: #f3f4f6;
        }

        .login-marca {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .6rem;
            font-size: 1.6rem;
            font-weight: 700;
            color: #ffffff;
        }

        .login-subtitulo {
            text-align: center;
            font-size: .85rem;
            color: #8fb3b5;
            margin: .35rem 0 1.5rem;
        }

        .login-grupo {
            margin-bottom: 1rem;
            font-size: .875rem;
        }

            .login-grupo label {
                display: block;
                color: #a3c2c4;
                margin-bottom: 6px;
                font-weight: 500;
            }

        .login-campo {
            position: relative;
        }

            .login-campo input {
                width: 100%;
                border-radius: .5rem;
                border: 1px solid #1f4d50;
                outline: 0;
                background-color: #072326;
                padding: .75rem 1rem;
                color: #f3f4f6;
                font-size: .9rem;
                transition: border-color .2s ease, box-shadow .2s ease;
            }

                .login-campo input::placeholder {
                    color: #5c8b8e;
                }

                .login-campo input:focus {
                    border-color: #17a2a8;
                    box-shadow: 0 0 0 3px rgba(23, 162, 168, .25);
                }

                .login-campo input.con-ojo {
                    padding-right: 2.75rem;
                }

        .login-ojo {
            position: absolute;
            top: 50%;
            right: .5rem;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            color: #8fb3b5;
            padding: .25rem .4rem;
        }

            .login-ojo:hover {
                color: #ffffff;
            }

        .login-error-campo {
            display: block;
            color: #ff8a8a;
            font-size: .78rem;
            margin-top: 4px;
        }

        .login-opciones {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .5rem;
            font-size: .78rem;
            color: #a3c2c4;
            margin: .25rem 0 1.25rem;
        }

            .login-opciones .form-check-input {
                background-color: #072326;
                border-color: #1f4d50;
            }

                .login-opciones .form-check-input:checked {
                    background-color: #17a2a8;
                    border-color: #17a2a8;
                }

        .login-enlace {
            color: #f3f4f6;
            text-decoration: none;
            background: none;
            border: none;
            padding: 0;
            font-size: .8rem;
        }

            .login-enlace:hover {
                text-decoration: underline #17a2a8;
                color: #ffffff;
            }

        .login-ayuda {
            display: none;
            font-size: .78rem;
            color: #c9eef0;
            background-color: rgba(23, 162, 168, .15);
            border-radius: .5rem;
            padding: .5rem .75rem;
            margin: -.5rem 0 1rem;
        }

        .login-boton {
            display: block;
            width: 100%;
            background-color: #17a2a8;
            padding: .75rem;
            text-align: center;
            color: #ffffff;
            border: none;
            border-radius: .5rem;
            font-weight: 600;
            transition: background-color .2s ease, transform .2s ease;
        }

            .login-boton:hover {
                background-color: #12898e;
                transform: translateY(-1px);
            }

        .login-error {
            display: flex;
            align-items: flex-start;
            gap: .5rem;
            background-color: rgba(220, 53, 69, .15);
            border: 1px solid rgba(220, 53, 69, .45);
            color: #ffb3b3;
            border-radius: .5rem;
            padding: .6rem .8rem;
            font-size: .82rem;
            margin-bottom: 1rem;
        }

        .login-separador {
            display: flex;
            align-items: center;
            padding-top: 1.25rem;
        }

            .login-separador .linea {
                height: 1px;
                flex: 1 1 0%;
                background-color: #1f4d50;
            }

            .login-separador .mensaje {
                padding: 0 .75rem;
                font-size: .8rem;
                color: #8fb3b5;
                margin: 0;
            }

        .login-iconos {
            display: flex;
            justify-content: center;
            gap: 1.25rem;
            padding: .85rem 0 .5rem;
            color: #5fc9cd;
            font-size: 1.2rem;
        }

        .login-pie {
            text-align: center;
            font-size: .75rem;
            color: #8fb3b5;
            margin: 0;
        }
    </style>
</head>
<body>
    <div class="login-tarjeta">
        <div class="login-marca">
            <div class="cuenta-icono"><i class="bi bi-suit-heart-fill"></i></div>
            <span>VITALIA</span>
        </div>
        <p class="login-subtitulo">Inicie sesión para continuar</p>

        @* Errores generales (correo o contraseña incorrectos, usuario desactivado) *@
        @foreach (var error in ViewData.ModelState[string.Empty]?.Errors ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.ModelBinding.ModelError>())
        {
            <div class="login-error" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i> <span>@error.ErrorMessage</span>
            </div>
        }

        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
            <div class="login-grupo">
                <label asp-for="Correo">Correo electrónico</label>
                <div class="login-campo">
                    <input asp-for="Correo" placeholder="nombre@vitalia.com" autocomplete="username" autofocus />
                </div>
                <span asp-validation-for="Correo" class="login-error-campo"></span>
            </div>

            <div class="login-grupo">
                <label asp-for="Contrasena">Contraseña</label>
                <div class="login-campo">
                    <input asp-for="Contrasena" class="con-ojo" placeholder="Su contraseña" autocomplete="current-password" />
                    <button type="button" class="login-ojo" id="verContrasena" aria-label="Mostrar contraseña">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Contrasena" class="login-error-campo"></span>
            </div>

            <div class="login-opciones">
                <div class="form-check m-0">
                    <input asp-for="Recordarme" class="form-check-input" />
                    <label asp-for="Recordarme" class="form-check-label">Mantener la sesión</label>
                </div>
                <button type="button" class="login-enlace" id="olvideContrasena">¿Olvidó su contraseña?</button>
            </div>
            <div class="login-ayuda" id="ayudaContrasena">
                <i class="bi bi-info-circle me-1"></i> Pida al administrador del sistema que le asigne una nueva contraseña.
            </div>

            <button type="submit" class="login-boton">
                <i class="bi bi-box-arrow-in-right me-1"></i> Entrar
            </button>
        </form>

        <div class="login-separador">
            <div class="linea"></div>
            <p class="mensaje">Cuidado de adultos mayores</p>
            <div class="linea"></div>
        </div>
        <div class="login-iconos" aria-hidden="true">
            <i class="bi bi-people-fill" title="Residentes"></i>
            <i class="bi bi-journal-medical" title="Bitácora"></i>
            <i class="bi bi-bell-fill" title="Alertas"></i>
        </div>
        <p class="login-pie">¿No tiene cuenta? Solicítela al administrador.</p>
    </div>

    <script>
        // Botón del ojo: muestra u oculta la contraseña
        document.getElementById('verContrasena').addEventListener('click', function () {
            var campo = document.getElementById('Contrasena');
            var mostrar = campo.type === 'password';
            campo.type = mostrar ? 'text' : 'password';
            this.querySelector('i').className = mostrar ? 'bi bi-eye-slash' : 'bi bi-eye';
        });

        // "¿Olvidó su contraseña?": muestra u oculta el aviso
        document.getElementById('olvideContrasena').addEventListener('click', function () {
            var ayuda = document.getElementById('ayudaContrasena');
            ayuda.style.display = ayuda.style.display === 'block' ? 'none' : 'block';
        });
    </script>
</body>
</html>
