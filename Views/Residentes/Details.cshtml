@model VITALIA.Models.ViewModels.ResidenteDetalleViewModel

@{
    ViewData["Title"] = $"Expediente: {Model.Residente.Nombre} {Model.Residente.Apellido}";
    var r = Model.Residente;

    var hoy = DateTime.Today;
    int edad = hoy.Year - r.FechaNacimiento.Year;
    if (r.FechaNacimiento.Date > hoy.AddYears(-edad)) edad--;
    edad = Math.Max(0, edad);

    int diasEstancia = (int)(DateTime.Today - r.FechaIngreso.Date).TotalDays;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Residentes</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Expediente #@r.IdResidente</li>
                </ol>
            </nav>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
                <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-primary text-white fw-bold me-3 shadow-sm" style="width: 48px; height: 48px; font-size: 1.25rem;">
                            @(r.Nombre.Length > 0 ? r.Nombre.Substring(0, 1) : "R")
                        </div>
                        <div>
                            <h2 class="h5 mb-0 fw-bold text-dark">@r.Nombre @r.Apellido</h2>
                            <small class="text-muted">Expediente ID: #@r.IdResidente &bull; Registrado en VITALIADB</small>
                        </div>
                    </div>
                    <div>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill">
                            <i class="bi bi-calendar-check me-1"></i> @diasEstancia día(s) de estancia
                        </span>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    @if (!Model.PuedeEliminar)
                    {
                        <div class="alert alert-info border-0 rounded-3 p-3 mb-4 small" role="alert">
                            <h6 class="fw-bold mb-1"><i class="bi bi-info-circle-fill me-1 text-info"></i> Registros asociados en otros módulos</h6>
                            <p class="mb-1 text-secondary">Este residente cuenta con vínculos en la plataforma:</p>
                            <ul class="mb-0">
                                @foreach (var dep in Model.DependenciasBloqueantes)
                                {
                                    <li><strong>@dep</strong></li>
                                }
                            </ul>
                        </div>
                    }

                    <!-- Datos Personales -->
                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                        <i class="bi bi-person-badge text-primary me-2"></i>Información Personal
                    </h6>

                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded-3">
                                <span class="text-muted small d-block mb-1">Nombre Completo:</span>
                                <span class="fw-bold text-dark fs-6">@r.Nombre @r.Apellido</span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded-3">
                                <span class="text-muted small d-block mb-1">Fecha de Nacimiento y Edad:</span>
                                <span class="fw-bold text-dark fs-6">@r.FechaNacimiento.ToString("dd/MM/yyyy") (@edad años)</span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded-3">
                                <span class="text-muted small d-block mb-1">Sexo:</span>
                                <span class="fw-bold text-dark fs-6">@r.Sexo</span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded-3">
                                <span class="text-muted small d-block mb-1">Teléfono de Contacto:</span>
                                <span class="fw-bold text-dark fs-6">@(string.IsNullOrWhiteSpace(r.Telefono) ? "No especificado" : r.Telefono)</span>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3">
                                <span class="text-muted small d-block mb-1">Dirección de Procedencia:</span>
                                <span class="fw-medium text-dark">@(string.IsNullOrWhiteSpace(r.Direccion) ? "Sin dirección registrada" : r.Direccion)</span>
                            </div>
                        </div>
                    </div>

                    <!-- Datos de la Habitación -->
                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                        <i class="bi bi-door-open text-primary me-2"></i>Habitación Asignada
                    </h6>

                    @if (r.Habitacion != null)
                    {
                        <div class="card border rounded-3 p-3 mb-4 bg-light">
                            <div class="row align-items-center g-3">
                                <div class="col-sm-4 text-center text-sm-start">
                                    <span class="text-muted small d-block">Número de Habitación</span>
                                    <span class="h4 fw-bold text-primary mb-0">Hab. @r.Habitacion.Numero</span>
                                </div>
                                <div class="col-sm-4 text-center">
                                    <span class="text-muted small d-block">Estado de Habitación</span>
                                    <span class="badge @(r.Habitacion.EstadoCoherente == "Ocupada" ? "bg-primary-subtle text-primary border border-primary-subtle" : "bg-success-subtle text-success border border-success-subtle") rounded-pill px-3 py-1">
                                        @r.Habitacion.EstadoCoherente
                                    </span>
                                </div>
                                <div class="col-sm-4 text-center text-sm-end">
                                    <span class="text-muted small d-block">Capacidad y Ocupación</span>
                                    <span class="fw-bold text-dark">@Model.PlazasOcupadasHabitacion / @r.Habitacion.Capacidad residentes</span>
                                    <div class="small text-muted">(@Model.PlazasLibresHabitacion plaza(s) libre(s))</div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-secondary small rounded-3 p-3 mb-4">
                            Sin información de habitación asociada.
                        </div>
                    }

                    <!-- Datos de Ingreso -->
                    <div class="p-3 bg-light rounded-3 mb-4 small d-flex justify-content-between align-items-center">
                        <span class="text-muted">Fecha de Ingreso Oficial:</span>
                        <span class="fw-bold text-dark">@r.FechaIngreso.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-ES"))</span>
                    </div>

                    <!-- Botones de Acción -->
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">
                            <i class="bi bi-arrow-left me-1"></i> Volver al Listado
                        </a>
                        <div class="d-flex gap-2">
                            <a asp-action="Delete" asp-route-id="@r.IdResidente" class="btn btn-outline-danger rounded-pill px-3">
                                <i class="bi bi-trash me-1"></i> Eliminar
                            </a>
                            <a asp-action="Edit" asp-route-id="@r.IdResidente" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                                <i class="bi bi-pencil me-1"></i> Editar Expediente
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
