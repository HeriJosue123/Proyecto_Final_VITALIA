@model VITALIA.Models.Residente

@{
    ViewData["Title"] = "Ficha del residente";
    var hoy = DateOnly.FromDateTime(DateTime.Today);
    int edad = hoy.Year - Model.FechaNacimiento.Year;
    if (Model.FechaNacimiento > hoy.AddYears(-edad)) edad--;
    var cuidadores = Model.AsignacionCuidados.Where(a => a.Estado).OrderByDescending(a => a.FechaInicio).ToList();
}<div class="animate-fade-up py-3">
    <!-- NAVEGACIÓN SUPERIOR SEPARADA -->
    <div class="mb-3 d-flex justify-content-between align-items-center">
        <a asp-action="Index" asp-route-estado="todos" asp-route-seleccionado="@Model.IdResidente" class="btn btn-sm bg-white text-muted border rounded-pill px-3 py-1 shadow-sm text-decoration-none fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> Volver a la lista
        </a>
    </div>

    @if (!Model.Estado)
    {
        <div class="alert alert-secondary rounded-3 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-archive me-2"></i> Este residente está <strong>dado de baja</strong> (baja lógica). Su expediente se conserva como histórico y no aparece en el listado de activos.
        </div>
    }

    <div class="row g-4">
        <!-- COLUMNA PRINCIPAL: DATOS DEL RESIDENTE -->
        <div class="col-lg-8">
            <div class="card border-0 rounded-4 shadow-sm overflow-hidden bg-white h-100">
                <!-- Banner de Encabezado Verde -->
                <div class="p-4 text-white position-relative" style="background: linear-gradient(135deg, #14828a 0%, #093437 100%); min-height: 110px;">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="badge bg-white bg-opacity-25 text-white border border-white border-opacity-25 rounded-pill px-3 py-1 mb-2" style="font-size: 0.75rem;">
                                Expediente: @Model.CodigoUnico
                            </span>
                        </div>
                        @if (Model.Estado)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1">Inactivo</span>
                        }
                    </div>
                </div>

                <div class="card-body p-4 p-md-5 pt-0 position-relative">
                    <!-- Avatar con Iniciales Flotante -->
                    <div class="d-flex align-items-end gap-3 mb-4" style="margin-top: -40px;">
                        <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold fs-3 shadow-sm border border-4 border-white flex-shrink-0"
                             style="width: 76px; height: 76px; background-color: @(Model.Estado ? "#14828a" : "#6c757d");">
                            @($"{Model.Nombre.FirstOrDefault()}{Model.Apellido.FirstOrDefault()}".ToUpper())
                        </div>
                        <div class="mb-1">
                            <h3 class="fw-bold text-dark mb-0">@Model.Nombre @Model.Apellido</h3>
                            <p class="text-muted small mb-0">@edad años · Habitación <strong>@Model.NumHabitacion</strong></p>
                        </div>
                    </div>

                    <!-- Grilla de Información General -->
                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <div class="p-3 rounded-3 bg-light border border-light-subtle h-100">
                                <span class="text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">FECHA DE NACIMIENTO</span>
                                <span class="fw-bold text-dark fs-6"><i class="bi bi-cake2 text-primary me-1"></i>@Model.FechaNacimiento.ToString("dd/MM/yyyy")</span>
                                <span class="text-muted small">(@edad años)</span>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="p-3 rounded-3 bg-light border border-light-subtle h-100">
                                <span class="text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">TIPO DE SANGRE</span>
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill fw-semibold fs-6">
                                    <i class="bi bi-droplet-fill me-1"></i>@(Model.TipoSangre ?? "No registrado")
                                </span>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="p-3 rounded-3 bg-light border border-light-subtle h-100">
                                <span class="text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">ALERGIAS</span>
                                <span class="fw-medium text-dark small"><i class="bi bi-exclamation-triangle text-warning me-1"></i>@(string.IsNullOrEmpty(Model.Alergias) ? "Ninguna registrada" : Model.Alergias)</span>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="p-3 rounded-3 bg-light border border-light-subtle h-100">
                                <span class="text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">CONTACTO DE EMERGENCIA</span>
                                <span class="fw-semibold text-dark fs-6"><i class="bi bi-telephone text-primary me-1"></i>@Model.ContactoEmergencia</span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="p-3 rounded-3 bg-light border border-light-subtle">
                                <span class="text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">ANTECEDENTES / OBSERVACIONES</span>
                                <p class="text-dark small mb-0">@(string.IsNullOrEmpty(Model.Observaciones) ? "Sin observaciones registradas." : Model.Observaciones)</p>
                            </div>
                        </div>
                    </div>

                    <!-- Botones de Acción Balanceados -->
                    <div class="d-flex gap-2 pt-3 border-top justify-content-end">
                        @if (Model.Estado)
                        {
                            <a asp-action="Delete" asp-route-id="@Model.IdResidente" class="btn btn-outline-danger rounded-3 px-3 py-2 fw-semibold text-nowrap">
                                <i class="bi bi-person-dash me-1"></i> Dar de baja
                            </a>
                        }
                        <a asp-action="Edit" asp-route-id="@Model.IdResidente" class="btn text-white rounded-3 px-4 py-2 fw-semibold shadow-sm" style="background-color: #14828a;">
                            <i class="bi bi-pencil me-1"></i> Editar datos
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- COLUMNA LATERAL: VÍNCULOS Y CUIDADORES -->
        <div class="col-lg-4 d-flex flex-column gap-4">
            <!-- Tarjeta Familiares -->
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white">
                <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background-color: rgba(20, 130, 138, 0.1); color: #14828a;">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-0">Familiares vinculados</h6>
                </div>
                
                @if (Model.FamiliarResidentes.Any())
                {
                    foreach (var fam in Model.FamiliarResidentes)
                    {
                        <div class="p-2 px-3 rounded-3 bg-light mb-2 border border-light-subtle">
                            <div class="fw-bold text-dark small">@(fam.IdUsuarioNavigation?.Correo ?? "Familiar")</div>
                            <div class="text-muted small"><i class="bi bi-telephone me-1"></i>@fam.Parentesco · @fam.TelefonoContacto</div>
                        </div>
                    }
                }
                else
                {
                    <p class="small text-muted mb-0"><i class="bi bi-info-circle me-1"></i>No hay familiares vinculados actualmente.</p>
                }
            </div>

            <!-- Tarjeta Cuidador Asignado -->
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white">
                <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background-color: rgba(20, 130, 138, 0.1); color: #14828a;">
                        <i class="bi bi-heart-pulse-fill"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-0">Cuidador asignado</h6>
                </div>

                @if (cuidadores.Any())
                {
                    foreach (var asig in cuidadores)
                    {
                        <div class="p-2 px-3 rounded-3 bg-light mb-2 border border-light-subtle">
                            <div class="fw-bold text-dark small">@asig.IdEmpleadoNavigation?.Nombre @asig.IdEmpleadoNavigation?.Apellido</div>
                            <div class="text-muted small"><i class="bi bi-person-badge me-1"></i>@asig.IdEmpleadoNavigation?.Cargo · desde @asig.FechaInicio.ToString("dd/MM/yyyy")</div>
                        </div>
                    }
                }
                else
                {
                    <p class="small text-muted mb-0"><i class="bi bi-info-circle me-1"></i>Sin cuidador asignado actualmente.</p>
                }
            </div>
        </div>
    </div>
</div>