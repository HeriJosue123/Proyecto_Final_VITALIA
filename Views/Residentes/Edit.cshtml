@model VITALIA.Models.Residente

@{
    ViewData["Title"] = "Editar Residente";
}<div class="animate-fade-up py-4 d-flex justify-content-center">
    <div style="width: 100%; max-width: 768px;" class="px-3">

        <!-- Tarjeta Principal con Encabezado Verde Integrado -->
        <div class="card border-0 rounded-4 shadow-sm overflow-hidden bg-white">
            
            <!-- Encabezado Estilo Bloque Verde -->
            <div class="p-4 text-white d-flex align-items-center justify-content-between flex-wrap gap-3" style="background: linear-gradient(135deg, #14828a 0%, #093437 100%);">
                <div class="d-flex align-items-center gap-3">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white text-dark shadow-sm" style="width: 44px; height: 44px; color: #14828a !important;">
                        <i class="bi bi-person-gear fs-5"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h4 class="fw-bold mb-0">Editar Residente</h4>
                            @if (Model.Estado)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1" style="font-size: 0.75rem;">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1" style="font-size: 0.75rem;">Inactivo</span>
                            }
                        </div>
                        <p class="text-white-50 small mb-0">Expediente: <strong>@Model.CodigoUnico</strong> · Modifique los datos de salud e identificación</p>
                    </div>
                </div>
                <div>
                    <a asp-action="Details" asp-route-id="@Model.IdResidente" class="btn btn-sm btn-light text-dark rounded-pill px-3 py-1.5 fw-semibold shadow-sm text-decoration-none">
                        ← Volver a la ficha
                    </a>
                </div>
            </div>

            <!-- Cuerpo del Formulario -->
            <div class="card-body p-4 p-md-5">
                
                <form asp-action="Edit" asp-route-id="@Model.IdResidente" method="post">
                    <input type="hidden" asp-for="IdResidente" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 small" role="alert"></div>

                    <!-- Renderizado del partial (campos de entrada) -->
                    @await Html.PartialAsync("_FormularioResidente", Model)

                    <!-- BOTONES DE ACCIÓN BALANCEADOS -->
                    <div class="d-flex gap-2 pt-4 mt-4 border-top">
                        <a asp-action="Index" class="btn btn-light rounded-3 py-2.5 px-4 fw-semibold text-secondary flex-grow-1 text-center">
                            Cancelar
                        </a>
                        <button type="submit" class="btn text-white fw-bold rounded-3 py-2.5 px-4 shadow-sm flex-grow-1 d-flex align-items-center justify-content-center gap-2" style="background: linear-gradient(135deg, #14828a 0%, #093437 100%); transition: all 0.2s ease;">
                            <i class="bi bi-check-circle-fill"></i> Guardar Cambios
                        </button>
                    </div>
                </form>

            </div>
        </div>

    </div></div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}