@model VITALIA.Models.Residente

@{
    ViewData["Title"] = "Editar residente";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Editar residente</h3>
        <p class="text-muted small mb-0">
            Expediente @Model.CodigoUnico ·
            @if (Model.Estado)
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle">Activo</span>
            }
            else
            {
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Inactivo</span>
            }
        </p>
    </div>
    <a asp-action="Details" asp-route-id="@Model.IdResidente" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Volver a la ficha
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <form asp-action="Edit" asp-route-id="@Model.IdResidente" method="post">
        <input type="hidden" asp-for="IdResidente" />
        @await Html.PartialAsync("_FormularioResidente", Model)

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-vitalia">
                <i class="bi bi-save me-1"></i> Guardar cambios
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
