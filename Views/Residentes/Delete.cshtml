@model VITALIA.Models.Residente

@{
    ViewData["Title"] = "Dar de baja residente";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Dar de baja residente</h3>
        <p class="text-muted small mb-0">Baja lógica: el expediente se conserva como histórico</p>
    </div>
    <a asp-action="Details" asp-route-id="@Model.IdResidente" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Volver a la ficha
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            @if (Model.Estado)
            {
                <div class="alert alert-warning rounded-3 small" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                    ¿Confirma que desea dar de baja a este residente? Dejará de aparecer en el listado de activos,
                    pero sus datos e historial <strong>no se eliminarán</strong>.
                </div>
            }
            else
            {
                <div class="alert alert-secondary rounded-3 small" role="alert">
                    <i class="bi bi-info-circle me-1"></i> Este residente ya está dado de baja.
                </div>
            }

            <dl class="row small mb-4">
                <dt class="col-sm-4 text-muted">Código único</dt>
                <dd class="col-sm-8 fw-semibold">@Model.CodigoUnico</dd>
                <dt class="col-sm-4 text-muted">Residente</dt>
                <dd class="col-sm-8">@Model.Nombre @Model.Apellido</dd>
                <dt class="col-sm-4 text-muted">Habitación</dt>
                <dd class="col-sm-8">@Model.NumHabitacion</dd>
                <dt class="col-sm-4 text-muted">Estado actual</dt>
                <dd class="col-sm-8">@(Model.Estado ? "Activo" : "Inactivo")</dd>
            </dl>

            <form asp-action="Delete" asp-route-id="@Model.IdResidente" method="post" class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                @if (Model.Estado)
                {
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-person-dash me-1"></i> Confirmar baja
                    </button>
                }
            </form>
        </div>
    </div>
</div>
