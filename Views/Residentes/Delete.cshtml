@model VITALIA.Models.ViewModels.ResidenteDetalleViewModel

@{
    ViewData["Title"] = $"Eliminar Residente: {Model.Residente.Nombre} {Model.Residente.Apellido}";
    var r = Model.Residente;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Residentes</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Eliminar Residente</li>
                </ol>
            </nav>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="card-header bg-danger text-white py-3 px-4">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-trash fs-4 me-2"></i>
                        <div>
                            <h2 class="h5 mb-0 fw-bold">Eliminar Residente: @r.Nombre @r.Apellido</h2>
                            <small class="text-white-50">Control de integridad referencial y confirmación segura</small>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    @if (!Model.PuedeEliminar)
                    {
                        <div class="alert alert-danger border-0 rounded-3 p-3 mb-4" role="alert">
                            <h6 class="fw-bold mb-1">
                                <i class="bi bi-shield-x me-1"></i> Eliminación Bloqueada por Integridad Referencial
                            </h6>
                            <p class="small mb-2">
                                Este residente no puede ser eliminado porque tiene registros dependientes en otras tablas de la base de datos VITALIADB:
                            </p>
                            <ul class="small mb-2">
                                @foreach (var dep in Model.DependenciasBloqueantes)
                                {
                                    <li><strong>@dep</strong></li>
                                }
                            </ul>
                            <p class="small mb-0 text-muted">
                                Para proteger la coherencia histórica y el expediente clínico del asilo, primero deben desvincularse o gestionarse dichos registros.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning border-0 rounded-3 p-3 mb-4" role="alert">
                            <h6 class="fw-bold mb-1">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i> ¿Está seguro de eliminar este residente?
                            </h6>
                            <p class="small mb-0">
                                Esta acción eliminará permanentemente el registro del residente de la base de datos VITALIADB.
                                Su plaza en la habitación @(r.Habitacion != null ? r.Habitacion.Numero : "") quedará libre de inmediato.
                            </p>
                        </div>
                    }

                    <div class="bg-light rounded-3 p-3 mb-4">
                        <dl class="row mb-0 small">
                            <dt class="col-sm-5 text-muted">Expediente:</dt>
                            <dd class="col-sm-7 fw-semibold text-dark">#@r.IdResidente</dd>

                            <dt class="col-sm-5 text-muted">Nombre Completo:</dt>
                            <dd class="col-sm-7 fw-semibold text-dark">@r.Nombre @r.Apellido</dd>

                            <dt class="col-sm-5 text-muted">Sexo:</dt>
                            <dd class="col-sm-7 fw-semibold text-dark">@r.Sexo</dd>

                            <dt class="col-sm-5 text-muted">Fecha de Ingreso:</dt>
                            <dd class="col-sm-7 fw-semibold text-dark">@r.FechaIngreso.ToString("dd/MM/yyyy")</dd>

                            <dt class="col-sm-5 text-muted">Habitación Asignada:</dt>
                            <dd class="col-sm-7 fw-semibold text-dark">Habitación @(r.Habitacion != null ? r.Habitacion.Numero : "Sin asignar")</dd>
                        </dl>
                    </div>

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@r.IdResidente" />

                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">
                                Cancelar y Volver
                            </a>

                            @if (Model.PuedeEliminar)
                            {
                                <button type="submit" class="btn btn-danger px-4 rounded-pill fw-semibold shadow-sm">
                                    <i class="bi bi-trash me-1"></i> Confirmar Eliminación
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-secondary px-4 rounded-pill fw-semibold" disabled>
                                    <i class="bi bi-lock-fill me-1"></i> Eliminación Bloqueada
                                </button>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
