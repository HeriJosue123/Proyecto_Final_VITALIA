@model VITALIA.Models.Residente

@* Campos compartidos por Registrar y Editar *@
@{
    string fechaValor = ViewData.ModelState.TryGetValue("FechaNacimiento", out var entradaFecha) && entradaFecha.AttemptedValue != null
        ? entradaFecha.AttemptedValue
        : (Model.FechaNacimiento == default ? "" : Model.FechaNacimiento.ToString("yyyy-MM-dd"));

    // Partes de la fecha para preseleccionar Día / Mes / Año
    int diaSel = 0, mesSel = 0, anioSel = 0;
    if (DateOnly.TryParseExact(fechaValor, "yyyy-MM-dd", out var fechaSel))
    {
        diaSel = fechaSel.Day; mesSel = fechaSel.Month; anioSel = fechaSel.Year;
    }
    int anioMasReciente = DateTime.Today.Year - VITALIA.Controllers.ResidentesController.EdadMinima;
    int anioMasAntiguo = DateTime.Today.Year - VITALIA.Controllers.ResidentesController.EdadMaxima;
    string[] meses = { "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre" };
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger rounded-3 small" role="alert">
        <div class="fw-bold mb-1"><i class="bi bi-exclamation-octagon-fill me-1"></i> Revise los datos del formulario:</div>
        <ul class="mb-0">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<h6 class="fw-bold text-dark mb-3">Identificación</h6>
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <label asp-for="CodigoUnico" class="form-label fw-semibold small">Código único <span class="text-danger">*</span></label>
        <input asp-for="CodigoUnico" class="form-control" placeholder="Ej. RES-2026-001" maxlength="20" />
        <span asp-validation-for="CodigoUnico" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Nombre" class="form-label fw-semibold small">Nombre <span class="text-danger">*</span></label>
        <input asp-for="Nombre" class="form-control" placeholder="Ej. Marta Elena" />
        <span asp-validation-for="Nombre" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Apellido" class="form-label fw-semibold small">Apellido <span class="text-danger">*</span></label>
        <input asp-for="Apellido" class="form-control" placeholder="Ej. Gómez" />
        <span asp-validation-for="Apellido" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label for="FechaDia" class="form-label fw-semibold small">Fecha de nacimiento <span class="text-danger">*</span></label>
        <input type="hidden" id="FechaNacimiento" name="FechaNacimiento" value="@fechaValor" />
        <style>
            .fecha-partes .form-select { padding-right: 2rem; background-position: right .6rem center; }
        </style>
        <div class="d-flex gap-2 fecha-partes">
            <select id="FechaDia" class="form-select" aria-label="Día de nacimiento" style="flex: 0 0 24%;">
                <option value="">Día</option>
                @for (int d = 1; d <= 31; d++)
                {
                    <option value="@d" selected="@(d == diaSel)">@d</option>
                }
            </select>
            <select id="FechaMes" class="form-select" aria-label="Mes de nacimiento">
                <option value="">Mes</option>
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m" selected="@(m == mesSel)">@meses[m - 1]</option>
                }
            </select>
            <select id="FechaAnio" class="form-select" aria-label="Año de nacimiento" style="flex: 0 0 30%;">
                <option value="">Año</option>
                @for (int a = anioMasReciente; a >= anioMasAntiguo; a--)
                {
                    <option value="@a" selected="@(a == anioSel)">@a</option>
                }
            </select>
        </div>
        <div class="form-text small">El residente debe tener al menos @VITALIA.Controllers.ResidentesController.EdadMinima años.</div>
        <span asp-validation-for="FechaNacimiento" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="NumHabitacion" class="form-label fw-semibold small">Habitación <span class="text-danger">*</span></label>
        <input asp-for="NumHabitacion" class="form-control" placeholder="Ej. 101" maxlength="20" />
        <span asp-validation-for="NumHabitacion" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="TipoSangre" class="form-label fw-semibold small">Tipo de sangre</label>
        <select asp-for="TipoSangre" class="form-select">
            <option value="">No registrado</option>
            @foreach (var tipo in VITALIA.Controllers.ResidentesController.TiposSangre)
            {
                <option value="@tipo">@tipo</option>
            }
        </select>
        <span asp-validation-for="TipoSangre" class="text-danger small"></span>
    </div>
</div>

<h6 class="fw-bold text-dark mb-3">Salud y contacto</h6>
<div class="row g-3 mb-4">
    <div class="col-md-5">
        <label asp-for="ContactoNombre" class="form-label fw-semibold small">Contacto de emergencia <span class="text-danger">*</span></label>
        <input asp-for="ContactoNombre" class="form-control" placeholder="Ej. Carlos Gómez" maxlength="120" />
        <span asp-validation-for="ContactoNombre" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="ContactoTelefono" class="form-label fw-semibold small">Teléfono del contacto <span class="text-danger">*</span></label>
        <input asp-for="ContactoTelefono" type="tel" inputmode="numeric" class="form-control" placeholder="Ej. 7000-1111" maxlength="9" />
        <span asp-validation-for="ContactoTelefono" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Alergias" class="form-label fw-semibold small">Alergias</label>
        <input asp-for="Alergias" class="form-control" placeholder="Ej. Penicilina (dejar vacío si no tiene)" />
        <span asp-validation-for="Alergias" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="Observaciones" class="form-label fw-semibold small">Antecedentes / observaciones <span class="text-danger">*</span></label>
        <textarea asp-for="Observaciones" class="form-control" rows="3" maxlength="2000" placeholder="Ej. Hipertensión controlada. Requiere apoyo para caminar."></textarea>
        <span asp-validation-for="Observaciones" class="text-danger small"></span>
    </div>
</div>

<script>
    // Teléfono del contacto: solo dígitos, máximo 8, con el guion en medio (7000-1111)
    document.addEventListener('DOMContentLoaded', function () {
        // Fecha de nacimiento: junta Día / Mes / Año en el campo oculto (aaaa-mm-dd)
        var dia = document.getElementById('FechaDia');
        var mes = document.getElementById('FechaMes');
        var anio = document.getElementById('FechaAnio');
        var fecha = document.getElementById('FechaNacimiento');
        function actualizarFecha() {
            // Solo deja elegir los días que tiene ese mes (ej. febrero 28 o 29)
            var diasDelMes = new Date(anio.value || 2000, mes.value || 1, 0).getDate();
            for (var i = 1; i < dia.options.length; i++) {
                dia.options[i].disabled = i > diasDelMes;
            }
            if (Number(dia.value) > diasDelMes) dia.value = '';
            fecha.value = dia.value && mes.value && anio.value
                ? anio.value + '-' + ('0' + mes.value).slice(-2) + '-' + ('0' + dia.value).slice(-2)
                : '';
        }
        if (dia && mes && anio && fecha) {
            [dia, mes, anio].forEach(function (s) { s.addEventListener('change', actualizarFecha); });
            if (dia.value && mes.value && anio.value) actualizarFecha();
        }

        var telefono = document.getElementById('ContactoTelefono');
        if (!telefono) return;
        telefono.addEventListener('input', function () {
            var digitos = telefono.value.replace(/\D/g, '').slice(0, 8);
            telefono.value = digitos.length > 4 ? digitos.slice(0, 4) + '-' + digitos.slice(4) : digitos;
        });
    });
</script>
