@model VITALIA.Models.ViewModels.ResidentesListadoViewModel

@{
    ViewData["Title"] = "Residentes";

    static int CalcularEdad(DateOnly nacimiento)
    {
        var hoy = DateOnly.FromDateTime(DateTime.Today);
        int edad = hoy.Year - nacimiento.Year;
        if (nacimiento > hoy.AddYears(-edad)) edad--;
        return edad;
    }

    static string Iniciales(Residente r) =>
        $"{(r.Nombre.Length > 0 ? r.Nombre[0] : ' ')}{(r.Apellido.Length > 0 ? r.Apellido[0] : ' ')}".Trim().ToUpper();

    var sel = Model.Seleccionado;
    bool hayFiltros = !string.IsNullOrWhiteSpace(Model.Busqueda) || !string.IsNullOrWhiteSpace(Model.Habitacion) || Model.Estado != "activos";
    string textoEstado = Model.Estado switch { "inactivos" => "inactivos", "todos" => "activos e inactivos", _ => "activos" };
}

<!-- Encabezado del Módulo -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Residentes</h3>
        <p class="text-muted small mb-0">Expedientes digitales del adulto mayor</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <div class="input-group search-box" style="width: 280px;">
            <span class="input-group-text bg-white border-end-0 rounded-start-3 text-muted">
                <i class="bi bi-search"></i>
            </span>
            <input type="search" name="busqueda" form="frmFiltros" value="@Model.Busqueda" class="form-control border-start-0 rounded-end-3" placeholder="Buscar por nombre o código..." aria-label="Buscar residentes">
        </div>
        <a asp-action="Create" class="btn btn-vitalia text-nowrap">
            <i class="bi bi-plus-lg me-1"></i> Registrar residente
        </a>
    </div>
</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
        <i class="bi bi-check-circle-fill me-1"></i> @TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show rounded-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["MensajeError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="row g-4">
    <!-- Tabla Principal de Residentes -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <form id="frmFiltros" method="get" asp-action="Index" class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div class="d-flex flex-wrap gap-2">
                    <select name="estado" class="form-select form-select-sm rounded-3 border-light-subtle" style="width: auto;" onchange="this.form.submit()" aria-label="Filtrar por estado">
                        <option value="activos" selected="@(Model.Estado == "activos")">Estado: Activos (@Model.TotalActivos)</option>
                        <option value="inactivos" selected="@(Model.Estado == "inactivos")">Estado: Inactivos (@Model.TotalInactivos)</option>
                        <option value="todos" selected="@(Model.Estado == "todos")">Todos (@(Model.TotalActivos + Model.TotalInactivos))</option>
                    </select>
                    <select name="habitacion" class="form-select form-select-sm rounded-3 border-light-subtle" style="width: auto;" onchange="this.form.submit()" aria-label="Filtrar por habitación">
                        <option value="">Habitaciones: Todas</option>
                        @foreach (var hab in Model.Habitaciones)
                        {
                            <option value="@hab" selected="@(Model.Habitacion == hab)">Hab. @hab</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-sm btn-outline-vitalia rounded-3">
                        <i class="bi bi-funnel me-1"></i> Aplicar
                    </button>
                    @if (hayFiltros)
                    {
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-3">Limpiar</a>
                    }
                </div>
                <small class="text-muted">@Model.Residentes.Count residente(s) @textoEstado · ordenados por código</small>
            </form>

            <!-- Tabla -->
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th>Código</th>
                            <th>Residente</th>
                            <th>Edad</th>
                            <th>Ubicación</th>
                            <th>Sangre</th>
                            <th class="d-none d-xl-table-cell">Alergias</th>
                            <th>Estado</th>
                            <th class="text-end"><span class="visually-hidden">Acciones</span></th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @if (Model.Residentes.Any())
                        {
                            foreach (var item in Model.Residentes)
                            {
                                <tr class="@(sel?.IdResidente == item.IdResidente ? "table-active" : "")">
                                    <td class="fw-bold text-dark text-nowrap">@item.CodigoUnico</td>
                                    <td class="fw-semibold">
                                        <a asp-action="Index" asp-route-busqueda="@Model.Busqueda" asp-route-estado="@Model.Estado" asp-route-habitacion="@Model.Habitacion" asp-route-seleccionado="@item.IdResidente"
                                           class="text-decoration-none text-dark" title="Ver en el panel">@item.Nombre @item.Apellido</a>
                                    </td>
                                    <td class="text-nowrap">@CalcularEdad(item.FechaNacimiento) años</td>
                                    <td class="text-nowrap">Hab. @item.NumHabitacion</td>
                                    <td><span class="badge bg-danger-subtle text-danger border border-danger-subtle">@(item.TipoSangre ?? "N/A")</span></td>
                                    <td class="d-none d-xl-table-cell">@(string.IsNullOrEmpty(item.Alergias) ? "Ninguna" : item.Alergias)</td>
                                    <td>
                                        @if (item.Estado)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-outline-secondary border-0" type="button" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false" title="Acciones" aria-label="Acciones de @item.CodigoUnico">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end small">
                                                <li><a class="dropdown-item" asp-action="Details" asp-route-id="@item.IdResidente"><i class="bi bi-eye me-2"></i>Ver ficha</a></li>
                                                <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.IdResidente"><i class="bi bi-pencil me-2"></i>Editar</a></li>
                                                @if (item.Estado)
                                                {
                                                    <li><hr class="dropdown-divider" /></li>
                                                    <li><a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@item.IdResidente"><i class="bi bi-person-dash me-2"></i>Dar de baja</a></li>
                                                }
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-5">
                                    <i class="bi bi-people fs-2 d-block mb-2"></i>
                                    @if (hayFiltros)
                                    {
                                        <span>No hay residentes que coincidan con la búsqueda o los filtros aplicados.</span>
                                    }
                                    else
                                    {
                                        <span>Todavía no hay residentes registrados.</span>
                                        <div class="mt-2"><a asp-action="Create" class="btn btn-sm btn-vitalia">Registrar el primer residente</a></div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Panel Lateral de Detalle del Residente -->
    <div class="col-lg-4">
        @if (sel == null)
        {
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center text-muted small">
                <i class="bi bi-person-vcard fs-2 d-block mb-2"></i>
                Seleccione un residente del listado para ver su resumen.
            </div>
        }
        else
        {
            var cuidadores = sel.AsignacionCuidados.Where(a => a.Estado).OrderByDescending(a => a.FechaInicio).ToList();

            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold fs-5 flex-shrink-0"
                         style="width: 52px; height: 52px; background-color: @(sel.Estado ? "#12898e" : "#6c757d");">
                        @Iniciales(sel)
                    </div>
                    <div>
                        <h5 class="fw-bold text-dark mb-0">@sel.Nombre @sel.Apellido</h5>
                        <small class="text-muted">@sel.CodigoUnico · @CalcularEdad(sel.FechaNacimiento) años · Hab. @sel.NumHabitacion</small>
                        @if (!sel.Estado)
                        {
                            <div><span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle mt-1">Inactivo (dado de baja)</span></div>
                        }
                    </div>
                </div>

                <div class="row g-2 small text-muted mb-3 border-top border-bottom py-2">
                    <div class="col-6">
                        <span class="d-block text-uppercase fw-bold" style="font-size: 0.65rem;">Nacimiento</span>
                        <span class="text-dark fw-semibold">@sel.FechaNacimiento.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="col-6">
                        <span class="d-block text-uppercase fw-bold" style="font-size: 0.65rem;">Tipo de Sangre</span>
                        <span class="text-dark fw-semibold">@(sel.TipoSangre ?? "No registrado")</span>
                    </div>
                    <div class="col-6 mt-2">
                        <span class="d-block text-uppercase fw-bold" style="font-size: 0.65rem;">Alergias</span>
                        <span class="text-dark fw-semibold">@(string.IsNullOrEmpty(sel.Alergias) ? "Ninguna" : sel.Alergias)</span>
                    </div>
                    <div class="col-6 mt-2">
                        <span class="d-block text-uppercase fw-bold" style="font-size: 0.65rem;">Emergencia</span>
                        <span class="text-dark fw-semibold">@sel.ContactoEmergencia</span>
                    </div>
                </div>

                <div class="mb-3">
                    <span class="d-block text-uppercase fw-bold text-muted mb-1" style="font-size: 0.65rem;">Antecedentes / observaciones</span>
                    <p class="small text-dark mb-0 bg-light p-2 rounded-3 border">
                        @(string.IsNullOrEmpty(sel.Observaciones) ? "Sin observaciones registradas." : sel.Observaciones)
                    </p>
                </div>

                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@sel.IdResidente" class="btn btn-vitalia btn-sm flex-fill">Editar datos</a>
                    <a asp-action="Details" asp-route-id="@sel.IdResidente" class="btn btn-outline-vitalia btn-sm flex-fill">Ver ficha</a>
                    <a asp-controller="Bitacora" asp-action="Index" class="btn btn-outline-vitalia btn-sm flex-fill">Ver bitácora</a>
                </div>
            </div>

            <!-- Familiares Vinculados -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <h6 class="fw-bold text-dark mb-3">Familiares vinculados</h6>
                @if (sel.FamiliarResidentes.Any())
                {
                    foreach (var fam in sel.FamiliarResidentes)
                    {
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                <i class="bi bi-person"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark small">@(fam.IdUsuarioNavigation?.Correo ?? "Familiar")</div>
                                <small class="text-muted d-block" style="font-size: 0.75rem;">@fam.Parentesco · @fam.TelefonoContacto · Solo lectura</small>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="small text-muted mb-0">No hay familiares vinculados.</p>
                }
            </div>

            <!-- Cuidador Asignado -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h6 class="fw-bold text-dark mb-3">Cuidador asignado</h6>
                @if (cuidadores.Any())
                {
                    foreach (var asig in cuidadores)
                    {
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <div class="rounded-circle bg-success text-white fw-bold d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                <i class="bi bi-person-badge"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark small">@asig.IdEmpleadoNavigation?.Nombre @asig.IdEmpleadoNavigation?.Apellido</div>
                                <small class="text-muted d-block" style="font-size: 0.75rem;">@asig.IdEmpleadoNavigation?.Cargo · desde @asig.FechaInicio.ToString("dd/MM/yyyy")</small>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="small text-muted mb-0">Sin cuidador asignado. Las asignaciones se gestionan en el módulo Personal.</p>
                }
            </div>
        }
    </div>
</div>
