@model VITALIA.Models.ViewModels.ResidentesIndexViewModel

@{
    ViewData["Title"] = "Gestión de Residentes";
}

<div class="container-fluid px-3 px-lg-4 py-4">
    <!-- Encabezado -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Residentes</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold text-dark mb-0">
                <i class="bi bi-people text-primary me-2"></i>Gestión de Residentes
            </h1>
            <p class="text-muted small mb-0">Expedientes personales y asignación habitacional del adulto mayor en VITALIA</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary px-3 py-2 rounded-pill shadow-sm fw-semibold">
                <i class="bi bi-person-plus me-1"></i> Registrar Residente
            </a>
        </div>
    </div>

    <!-- Alertas de Feedback -->
    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
            <div>@TempData["MensajeExito"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-danger"></i>
            <div>@TempData["MensajeError"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- Métricas del Módulo -->
    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="p-3 rounded-3 bg-primary-subtle text-primary me-3">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-medium">Total Residentes</span>
                        <h3 class="fw-bold mb-0 text-dark">@Model.TotalResidentes</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="p-3 rounded-3 bg-info-subtle text-info-emphasis me-3">
                        <i class="bi bi-gender-male fs-4"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-medium">Hombres</span>
                        <h3 class="fw-bold mb-0 text-dark">@Model.TotalHombres</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="p-3 rounded-3 bg-danger-subtle text-danger me-3">
                        <i class="bi bi-gender-female fs-4"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-medium">Mujeres</span>
                        <h3 class="fw-bold mb-0 text-dark">@Model.TotalMujeres</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Panel de Búsqueda y Ordenamiento -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-3 p-md-4">
            <form method="get" asp-action="Index" class="row g-2 align-items-end">
                <div class="col-md-6">
                    <label class="form-label small fw-semibold text-secondary">Buscar por Nombre o Apellido</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="busqueda" value="@Model.Busqueda" class="form-control border-start-0 bg-light" placeholder="Ej: María, Gómez, José..." />
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-secondary">Ordenar por</label>
                    <select name="orden" class="form-select bg-light">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.OrdenActual) ? "selected" : null)">Nombre (A - Z)</option>
                        <option value="nombre_desc" selected="@(Model.OrdenActual == "nombre_desc" ? "selected" : null)">Nombre (Z - A)</option>
                        <option value="apellido_asc" selected="@(Model.OrdenActual == "apellido_asc" ? "selected" : null)">Apellido (A - Z)</option>
                        <option value="ingreso_desc" selected="@(Model.OrdenActual == "ingreso_desc" ? "selected" : null)">Fecha de Ingreso (Más recientes)</option>
                        <option value="ingreso_asc" selected="@(Model.OrdenActual == "ingreso_asc" ? "selected" : null)">Fecha de Ingreso (Más antiguos)</option>
                        <option value="habitacion_asc" selected="@(Model.OrdenActual == "habitacion_asc" ? "selected" : null)">Habitación</option>
                    </select>
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 fw-semibold">
                        <i class="bi bi-funnel me-1"></i> Filtrar
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Model.Busqueda) || !string.IsNullOrWhiteSpace(Model.OrdenActual))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary" title="Limpiar filtros">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla de Residentes -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Residente</th>
                        <th>Edad / F. Nacimiento</th>
                        <th>Sexo</th>
                        <th>Contacto</th>
                        <th>Fecha Ingreso</th>
                        <th>Habitación</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Residentes.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-person-x fs-1 d-block mb-2 text-secondary"></i>
                                <strong>No se encontraron residentes registrados.</strong>
                                <p class="small mb-3">Comience registrando un nuevo residente en VITALIA.</p>
                                <a asp-action="Create" class="btn btn-outline-primary btn-sm rounded-pill">
                                    <i class="bi bi-person-plus me-1"></i> Registrar Residente
                                </a>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Residentes)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary fw-bold me-3" style="width: 38px; height: 38px;">
                                            @(item.Nombre.Length > 0 ? item.Nombre.Substring(0, 1) : "R")
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@item.NombreCompleto</div>
                                            <span class="badge bg-light text-muted border" style="font-size: 0.7rem;">ID #@item.IdResidente</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@item.Edad años</div>
                                    <small class="text-muted">@item.FechaNacimiento.ToString("dd/MM/yyyy")</small>
                                </td>
                                <td>
                                    @if (item.Sexo.Equals("Masculino", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill">
                                            <i class="bi bi-gender-male me-1"></i> Masculino
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">
                                            <i class="bi bi-gender-female me-1"></i> Femenino
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="small">
                                        <i class="bi bi-telephone me-1 text-muted"></i>
                                        @(string.IsNullOrWhiteSpace(item.Telefono) ? "Sin teléfono" : item.Telefono)
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(item.Direccion))
                                    {
                                        <div class="text-muted small text-truncate" style="max-width: 180px;" title="@item.Direccion">
                                            <i class="bi bi-geo-alt me-1"></i>@item.Direccion
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="text-dark fw-medium">@item.FechaIngreso.ToString("dd/MM/yyyy")</span>
                                </td>
                                <td>
                                    <a asp-controller="Habitaciones" asp-action="Details" asp-route-id="@item.IdHabitacion" class="text-decoration-none">
                                        <span class="badge bg-light text-primary border px-2 py-1 rounded-pill">
                                            <i class="bi bi-door-closed me-1"></i> Hab. @item.NumeroHabitacion
                                        </span>
                                    </a>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.IdResidente" class="btn btn-outline-secondary" title="Ficha de Detalles">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.IdResidente" class="btn btn-outline-primary" title="Editar Expediente">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.IdResidente" class="btn btn-outline-danger" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
