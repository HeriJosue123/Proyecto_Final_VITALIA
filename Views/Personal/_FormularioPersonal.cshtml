@model VITALIA.Models.Empleado

<!-- CAMPO: NOMBRE -->
<div class="mb-2">
    <label asp-for="Nombre" class="form-label fw-bold text-dark small text-uppercase tracking-wider mb-1 d-block text-start">
        <i class="bi bi-person me-1" style="color: #14828a;"></i> NOMBRE
    </label>
    <input asp-for="Nombre" class="form-control form-control-lg rounded-3 fs-6 shadow-none" placeholder="Ej. Ana" required style="border-color: #cbd5e1; padding: 0.65rem 1rem;" />
    <span asp-validation-for="Nombre" class="text-danger small ms-1"></span>
</div>

<!-- CAMPO: APELLIDO -->
<div class="mb-2">
    <label asp-for="Apellido" class="form-label fw-bold text-dark small text-uppercase tracking-wider mb-1 d-block text-start">
        <i class="bi bi-person-badge me-1" style="color: #14828a;"></i> APELLIDO
    </label>
    <input asp-for="Apellido" class="form-control form-control-lg rounded-3 fs-6 shadow-none" placeholder="Ej. López" required style="border-color: #cbd5e1; padding: 0.65rem 1rem;" />
    <span asp-validation-for="Apellido" class="text-danger small ms-1"></span>
</div>

<!-- CAMPO: CARGO -->
<div class="mb-2">
    <label asp-for="Cargo" class="form-label fw-bold text-dark small text-uppercase tracking-wider mb-1 d-block text-start">
        <i class="bi bi-briefcase me-1" style="color: #14828a;"></i> CARGO
    </label>
    <input asp-for="Cargo" class="form-control form-control-lg rounded-3 fs-6 shadow-none" placeholder="Ej. Enfermera, Cuidador..." required style="border-color: #cbd5e1; padding: 0.65rem 1rem;" />
    <span asp-validation-for="Cargo" class="text-danger small ms-1"></span>
</div>

<!-- CAMPO: VINCULAR USUARIO -->
<div class="mb-2">
    <label asp-for="IdUsuario" class="form-label fw-bold text-dark small text-uppercase tracking-wider mb-1 d-block text-start">
        <i class="bi bi-link-45deg me-1 fs-5 align-middle" style="color: #14828a;"></i> VINCULAR USUARIO
    </label>
    
    @{
        var usuarios = ViewData["IdUsuario"] as SelectList;
        bool hayUsuarios = usuarios != null && usuarios.Any();
    }

    <select asp-for="IdUsuario" class="form-select form-select-lg rounded-3 fs-6 shadow-none" required disabled="@(!hayUsuarios)" style="border-color: #cbd5e1; padding: 0.65rem 1rem;">
        <option value="">@(hayUsuarios ? "-- Seleccione un usuario --" : "-- No hay usuarios disponibles --")</option>
        @if (hayUsuarios)
        {
            foreach (var item in usuarios!)
            {
                <option value="@item.Value" selected="@item.Selected">@item.Text</option>
            }
        }
    </select>

    @if (!hayUsuarios)
    {
        <div class="text-muted small mt-1 ms-1">
            <i class="bi bi-info-circle me-1"></i> No hay usuarios libres para vincular. Primero cree uno en
            <a asp-controller="Usuario" asp-action="Create" class="fw-semibold text-decoration-none" style="color: #14828a;">Usuarios y Roles</a>
        </div>
    }
    
    <span asp-validation-for="IdUsuario" class="text-danger small ms-1"></span>
</div>