@model VITALIA.Models.Empleado
@{
    ViewData["Title"] = "Detalles del Empleado";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">

        <div class="vitalia-banner mb-4">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex align-items-center justify-content-center rounded-3 bg-white bg-opacity-25" style="width: 48px; height: 48px;">
                        <i class="bi bi-person-vcard fs-4"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-1">Detalles del Empleado</h3>
                        <p class="mb-0 opacity-75">Información completa del miembro del personal</p>
                    </div>
                </div>
                <a asp-action="Index" class="btn text-nowrap">
                    ← Volver a la lista
                </a>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold mb-4 border-bottom pb-2">Datos Personales y de Sistema</h5>

            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted fw-semibold mb-2">Nombre completo</dt>
                <dd class="col-sm-8 mb-3 fw-bold">@Model.Nombre @Model.Apellido</dd>

                <dt class="col-sm-4 text-muted fw-semibold mb-2">Cargo</dt>
                <dd class="col-sm-8 mb-3">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">
                        @Model.Cargo
                    </span>
                </dd>

                <dt class="col-sm-4 text-muted fw-semibold mb-2">Usuario Vinculado</dt>
                <dd class="col-sm-8 mb-3">
                    @(Model.IdUsuarioNavigation?.Correo ?? "Sin usuario vinculado al sistema")
                </dd>

                <dt class="col-sm-4 text-muted fw-semibold mb-2">Estado</dt>
                <dd class="col-sm-8 mb-3">
                    @if (Model.Estado)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-circle me-1"></i> Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle"><i class="bi bi-x-circle me-1"></i> Inactivo</span>
                    }
                </dd>
            </dl>

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a asp-action="Edit" asp-route-id="@Model.IdEmpleado" class="btn btn-vitalia">
                    <i class="bi bi-pencil-square me-1"></i> Editar Empleado
                </a>
            </div>
        </div>
    </div>
</div>