@model VITALIA.Models.Empleado
@{
    ViewData["Title"] = "Registrar Nuevo Empleado";

    // Verificamos si hay usuarios disponibles aquí también,
    // para poder deshabilitar el botón de "Guardar Empleado" si es necesario.
    var usuarios = ViewData["IdUsuario"] as SelectList;
    bool hayUsuarios = usuarios != null && usuarios.Any();
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">

        @* Encabezado con el estilo visual (Banner) del proyecto Vitalia *@
        <div class="vitalia-banner mb-4">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex align-items-center justify-content-center rounded-3 bg-white bg-opacity-25" style="width: 48px; height: 48px;">
                        <i class="bi bi-person-plus-fill fs-4"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-1">Registrar Nuevo Empleado</h3>
                        <p class="mb-0 opacity-75">Ingrese los datos del nuevo miembro del personal</p>
                    </div>
                </div>
                <a asp-action="Index" class="btn text-nowrap">
                    ← Volver a la lista
                </a>
            </div>
        </div>

        @* Tarjeta principal que contiene el formulario *@
        <div class="card border-0 shadow-sm rounded-4 p-4">

            <form asp-action="Create" method="post">
                @* Token de seguridad para evitar ataques de falsificación de solicitudes (CSRF) *@
                @Html.AntiForgeryToken()

                @* 
                   AQUÍ INYECTAMOS LA VISTA PARCIAL:
                   Llamamos al archivo "_FormularioPersonal" y le pasamos el Modelo actual.
                   Esto mantiene este archivo limpio y fácil de leer.
                *@
                @await Html.PartialAsync("_FormularioPersonal", Model)

                <div class="d-grid mt-2">
                    @* El botón se deshabilita automáticamente si no hay usuarios libres en el sistema *@
                    <button type="submit" class="btn btn-vitalia" disabled="@(!hayUsuarios)">
                        <i class="bi bi-save me-1"></i> Guardar Empleado
                    </button>
                </div>

                @* Bucle para mostrar errores generales del modelo (ej. fallos al guardar en base de datos) que no pertenecen a un campo específico *@
                @foreach (var error in ViewData.ModelState[string.Empty]?.Errors ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.ModelBinding.ModelError>())
                {
                    <div class="text-danger small mt-2">@error.ErrorMessage</div>
                }
            </form>
        </div>
    </div>
</div>

@* Sección de scripts: Carga las librerías de validación de jQuery para validar sin recargar la página *@
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}