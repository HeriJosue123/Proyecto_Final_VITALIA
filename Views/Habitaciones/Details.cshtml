@model VITALIA.Models.Habitacion

@{
    ViewData["Title"] = $"Detalles de Habitación {Model.Numero}";
    int residentesCount = Model.Residentes?.Count ?? 0;
    int plazasLibres = Math.Max(0, Model.Capacidad - residentesCount);
    int porcentaje = Model.Capacidad > 0 ? Math.Min(100, (int)Math.Round((double)residentesCount / Model.Capacidad * 100)) : 0;
    bool sobreocupada = residentesCount > Model.Capacidad;

    string estadoClass = Model.EstadoCoherente switch
    {
        "Disponible" => "bg-success-subtle text-success border border-success-subtle",
        "Ocupada" => "bg-primary-subtle text-primary border border-primary-subtle",
        "Mantenimiento" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
        "Inactiva" => "bg-secondary-subtle text-secondary border border-secondary-subtle",
        _ => "bg-light text-dark border"
    };
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Navegación superior -->
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Habitaciones</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Detalles @Model.Numero</li>
                </ol>
            </nav>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
                <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="h5 mb-0 fw-bold text-dark">
                            <i class="bi bi-door-open text-primary me-2"></i>Habitación @Model.Numero
                        </h2>
                        <small class="text-muted">Identificador de Base de Datos: #@Model.IdHabitacion</small>
                    </div>
                    <div>
                        <span class="badge @estadoClass px-3 py-2 rounded-pill">
                            @Model.EstadoCoherente
                        </span>
                        @if (Model.TieneInconsistenciaEstado)
                        {
                            <span class="badge bg-warning text-dark px-2 py-1 rounded-pill small ms-1" title="Valor guardado en BD">
                                BD: @Model.Estado
                            </span>
                        }
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    @if (Model.TieneInconsistenciaEstado)
                    {
                        <div class="alert alert-warning border-0 rounded-3 small mb-4 d-flex align-items-center" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-warning"></i>
                            <div>
                                <strong>Inconsistencia detectada en base de datos:</strong> La habitación figura en BD como <em>@Model.Estado</em> pero actualmente tiene <strong>@residentesCount residente(s)</strong> de @Model.Capacidad plaza(s).
                                Su estado operativo calculado es <strong>@Model.EstadoCoherente</strong>. Puede sincronizar el registro en <a asp-action="CambiarEstado" asp-route-id="@Model.IdHabitacion" class="alert-link">Cambiar Estado</a>.
                            </div>
                        </div>
                    }
                    <!-- Métricas de Ocupación -->
                    <div class="row g-3 mb-4 text-center">
                        <div class="col-4">
                            <div class="p-3 bg-light rounded-3">
                                <span class="text-muted small d-block mb-1">Capacidad Total</span>
                                <h4 class="fw-bold text-dark mb-0">@Model.Capacidad</h4>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3 bg-light rounded-3">
                                <span class="text-muted small d-block mb-1">Residentes Actuales</span>
                                <h4 class="fw-bold @(sobreocupada ? "text-danger" : "text-dark") mb-0">@residentesCount</h4>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3 bg-light rounded-3">
                                <span class="text-muted small d-block mb-1">Plazas Libres</span>
                                <h4 class="fw-bold @(plazasLibres > 0 ? "text-success" : "text-danger") mb-0">@plazasLibres</h4>
                            </div>
                        </div>
                    </div>

                    <!-- Barra de progreso -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between small text-muted mb-1">
                            <span>Tasa de Ocupación</span>
                            <span class="fw-bold">@porcentaje%</span>
                        </div>
                        <div class="progress" style="height: 10px;">
                            <div class="progress-bar @(sobreocupada ? "bg-danger" : (porcentaje >= 100 ? "bg-primary" : "bg-success"))" 
                                 role="progressbar" 
                                 style="width: @porcentaje%;" 
                                 aria-valuenow="@porcentaje" 
                                 aria-valuemin="0" 
                                 aria-valuemax="100">
                            </div>
                        </div>
                        @if (sobreocupada)
                        {
                            <div class="text-danger small mt-2">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i> Advertencia: Esta habitación registra una inconsistencia por sobreocupación.
                            </div>
                        }
                    </div>

                    <!-- Lista de Residentes asignados -->
                    <h5 class="fw-bold text-dark mb-3">
                        <i class="bi bi-people text-secondary me-2"></i>Residentes Asignados (@residentesCount)
                    </h5>

                    @if (residentesCount == 0)
                    {
                        <div class="alert alert-light border rounded-3 p-3 text-center text-muted small">
                            <i class="bi bi-person-x fs-4 d-block mb-1 text-secondary"></i>
                            No hay residentes asignados actualmente a esta habitación.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive rounded-3 border">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th class="ps-3">ID</th>
                                        <th>Nombre Completo</th>
                                        <th>Sexo</th>
                                        <th>Fecha de Ingreso</th>
                                    </tr>
                                </thead>
                                <tbody class="small">
                                    @foreach (var res in Model.Residentes!)
                                    {
                                        <tr>
                                            <td class="ps-3 text-muted">#@res.IdResidente</td>
                                            <td class="fw-semibold text-dark">@res.Nombre @res.Apellido</td>
                                            <td>@res.Sexo</td>
                                            <td>@res.FechaIngreso.ToString("dd/MM/yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <!-- Botones de Acción -->
                    <div class="d-flex justify-content-between align-items-center pt-4 mt-4 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">
                            <i class="bi bi-arrow-left me-1"></i> Volver al Listado
                        </a>
                        <div class="d-flex gap-2">
                            <a asp-action="CambiarEstado" asp-route-id="@Model.IdHabitacion" class="btn btn-outline-warning rounded-pill px-3">
                                <i class="bi bi-arrow-repeat me-1"></i> Cambiar Estado
                            </a>
                            <a asp-action="Edit" asp-route-id="@Model.IdHabitacion" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                                <i class="bi bi-pencil me-1"></i> Editar
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
