@model VITALIA.Models.Habitacion

@{
    ViewData["Title"] = $"Editar Habitación {Model.Numero}";
    var estados = ViewBag.EstadosDisponibles as List<string> ?? new List<string> { "Disponible", "Ocupada", "Mantenimiento", "Inactiva" };
    int residentesAsignados = ViewBag.ResidentesAsignados ?? 0;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <!-- Navegación superior -->
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Habitaciones</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Editar Habitación</li>
                </ol>
            </nav>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="card-header bg-primary text-white py-3 px-4">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-pencil-square fs-4 me-2"></i>
                        <div>
                            <h2 class="h5 mb-0 fw-bold">Editar Habitación: @Model.Numero</h2>
                            <small class="text-white-50">Modifique los parámetros de la habitación conservando su identificador</small>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    @if (Model.TieneInconsistenciaEstado)
                    {
                        <div class="alert alert-warning border-0 rounded-3 d-flex align-items-center mb-4 small" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-warning"></i>
                            <div>
                                <strong>Inconsistencia detectada en base de datos:</strong> La habitación figura en BD como <em>@Model.Estado</em> pero actualmente tiene <strong>@residentesAsignados residente(s)</strong> de @Model.Capacidad plaza(s).
                                Se ha preseleccionado su estado coherente <strong>@Model.EstadoCoherente</strong> para regularizar el registro al guardar.
                            </div>
                        </div>
                    }

                    @if (residentesAsignados > 0)
                    {
                        <div class="alert alert-info border-0 rounded-3 d-flex align-items-center mb-4 small" role="alert">
                            <i class="bi bi-info-circle-fill fs-5 me-2 text-info"></i>
                            <div>
                                Esta habitación tiene <strong>@residentesAsignados residente(s)</strong> actualmente asignado(s). 
                                La capacidad no puede reducirse por debajo de este valor.
                            </div>
                        </div>
                    }

                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="IdHabitacion" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 py-2 small" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Numero" class="form-label fw-semibold text-dark">
                                Número de Habitación <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-tag"></i></span>
                                <input asp-for="Numero" class="form-control bg-light" maxlength="10" />
                            </div>
                            <span asp-validation-for="Numero" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Capacidad" class="form-label fw-semibold text-dark">
                                Capacidad Máxima (Plazas) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-person"></i></span>
                                <input asp-for="Capacidad" type="number" min="@(Math.Max(1, residentesAsignados))" max="100" class="form-control bg-light" />
                            </div>
                            <span asp-validation-for="Capacidad" class="text-danger small"></span>
                            <div class="form-text small">Mínimo permitido actualmente: @(Math.Max(1, residentesAsignados)) plaza(s).</div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Estado" class="form-label fw-semibold text-dark">
                                Estado <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Estado" class="form-select bg-light">
                                @foreach (var est in estados)
                                {
                                    bool permitido = true;
                                    string etiqueta = est;

                                    if (residentesAsignados == 0 && est == "Ocupada")
                                    {
                                        permitido = false;
                                        etiqueta = $"{est} (No permitido: 0 residentes)";
                                    }
                                    else if (residentesAsignados >= Model.Capacidad && est == "Disponible")
                                    {
                                        permitido = false;
                                        etiqueta = $"{est} (No permitido: Capacidad completa)";
                                    }
                                    else if (residentesAsignados > 0 && residentesAsignados < Model.Capacidad && est == "Ocupada")
                                    {
                                        permitido = false;
                                        etiqueta = $"{est} (No permitido: Plazas disponibles)";
                                    }
                                    else if (residentesAsignados > 0 && (est == "Mantenimiento" || est == "Inactiva"))
                                    {
                                        permitido = false;
                                        etiqueta = $"{est} (No permitido: Con residentes)";
                                    }

                                    <option value="@est" selected="@(((Model.TieneInconsistenciaEstado ? Model.EstadoCoherente : Model.Estado) == est) ? "selected" : null)" disabled="@(permitido ? null : "disabled")">
                                        @etiqueta
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="Estado" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">
                                Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary px-4 rounded-pill fw-semibold shadow-sm">
                                <i class="bi bi-save me-1"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
