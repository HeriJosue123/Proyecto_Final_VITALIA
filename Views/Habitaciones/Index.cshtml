@model VITALIA.Models.ViewModels.HabitacionesIndexViewModel

@{
    ViewData["Title"] = "Gestión de Habitaciones";
}

<div class="container-fluid px-3 px-lg-4 py-4">
    <!-- Encabezado -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Habitaciones</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold text-dark mb-0">
                <i class="bi bi-door-open text-primary me-2"></i>Gestión de Habitaciones
            </h1>
            <p class="text-muted small mb-0">Administración de infraestructura, capacidad y plazas disponibles en VITALIA</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary px-3 py-2 rounded-pill shadow-sm fw-semibold">
                <i class="bi bi-plus-circle me-1"></i> Nueva Habitación
            </a>
        </div>
    </div>

    <!-- Alertas de Feedback -->
    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
            <div>@TempData["MensajeExito"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-danger"></i>
            <div>@TempData["MensajeError"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- Tarjetas de Métricas -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="p-3 rounded-3 bg-primary-subtle text-primary me-3">
                        <i class="bi bi-door-closed fs-4"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-medium">Total Habitaciones</span>
                        <h3 class="fw-bold mb-0 text-dark">@Model.TotalHabitaciones</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="p-3 rounded-3 bg-info-subtle text-info-emphasis me-3">
                        <i class="bi bi-people fs-4"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-medium">Capacidad Total</span>
                        <h3 class="fw-bold mb-0 text-dark">@Model.TotalCapacidad</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="p-3 rounded-3 bg-secondary-subtle text-secondary me-3">
                        <i class="bi bi-person-check fs-4"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-medium">Residentes Asignados</span>
                        <h3 class="fw-bold mb-0 text-dark">@Model.TotalResidentesAsignados</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="p-3 rounded-3 bg-success-subtle text-success me-3">
                        <i class="bi bi-check2-circle fs-4"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-medium">Plazas Libres</span>
                        <h3 class="fw-bold mb-0 text-success">@Model.TotalPlazasLibres</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Panel de Búsqueda, Filtro y Ordenamiento -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-3 p-md-4">
            <form method="get" asp-action="Index" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-secondary">Buscar por Número</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="busqueda" value="@Model.Busqueda" class="form-control border-start-0 bg-light" placeholder="Ej: 101, A-1..." />
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-secondary">Filtrar por Estado</label>
                    <select name="estado" class="form-select bg-light">
                        <option value="">-- Todos los estados --</option>
                        @foreach (var est in Model.EstadosDisponibles)
                        {
                            <option value="@est" selected="@(Model.FiltroEstado == est ? "selected" : null)">@est</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-secondary">Ordenar por</label>
                    <select name="orden" class="form-select bg-light">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.OrdenActual) ? "selected" : null)">Número (Ascendente)</option>
                        <option value="numero_desc" selected="@(Model.OrdenActual == "numero_desc" ? "selected" : null)">Número (Descendente)</option>
                        <option value="capacidad_asc" selected="@(Model.OrdenActual == "capacidad_asc" ? "selected" : null)">Capacidad (Menor a Mayor)</option>
                        <option value="capacidad_desc" selected="@(Model.OrdenActual == "capacidad_desc" ? "selected" : null)">Capacidad (Mayor a Menor)</option>
                        <option value="estado_asc" selected="@(Model.OrdenActual == "estado_asc" ? "selected" : null)">Estado (Alfabético)</option>
                    </select>
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 fw-semibold">
                        <i class="bi bi-funnel me-1"></i> Filtrar
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Model.Busqueda) || !string.IsNullOrWhiteSpace(Model.FiltroEstado) || !string.IsNullOrWhiteSpace(Model.OrdenActual))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary" title="Limpiar filtros">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla de Habitaciones -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Número</th>
                        <th>Capacidad</th>
                        <th>Residentes Asignados</th>
                        <th>Plazas Disponibles</th>
                        <th>Ocupación</th>
                        <th>Estado</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Habitaciones.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                <strong>No se encontraron habitaciones registradas.</strong>
                                <p class="small mb-3">Comience registrando la primera habitación del asilo.</p>
                                <a asp-action="Create" class="btn btn-outline-primary btn-sm rounded-pill">
                                    <i class="bi bi-plus me-1"></i> Registrar Habitación
                                </a>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Habitaciones)
                        {
                            var porcentaje = item.Capacidad > 0 ? Math.Min(100, (int)Math.Round((double)item.ResidentesAsignados / item.Capacidad * 100)) : 0;
                            string estadoClass = item.EstadoCoherente switch
                            {
                                "Disponible" => "bg-success-subtle text-success border border-success-subtle",
                                "Ocupada" => "bg-primary-subtle text-primary border border-primary-subtle",
                                "Mantenimiento" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
                                "Inactiva" => "bg-secondary-subtle text-secondary border border-secondary-subtle",
                                _ => "bg-light text-dark border"
                            };

                            <tr>
                                <td class="ps-4 fw-bold text-dark">
                                    <span class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle me-2" style="width: 32px; height: 32px;">
                                        <i class="bi bi-door-closed text-primary"></i>
                                    </span>
                                    @item.Numero
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-person me-1"></i> @item.Capacidad plaza(s)
                                    </span>
                                </td>
                                <td>
                                    @if (item.ResidentesAsignados > 0)
                                    {
                                        <span class="fw-semibold text-dark">@item.ResidentesAsignados</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">0 (Vacía)</span>
                                    }
                                </td>
                                <td>
                                    @if (item.TieneSobreocupacion)
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-exclamation-octagon me-1"></i> Sobreocupada
                                        </span>
                                    }
                                    else if (item.PlazasDisponibles > 0)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-check-lg me-1"></i> @item.PlazasDisponibles libre(s)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                            Sin plazas
                                        </span>
                                    }
                                </td>
                                <td style="min-width: 130px;">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 6px;">
                                            <div class="progress-bar @(item.TieneSobreocupacion ? "bg-danger" : (porcentaje >= 100 ? "bg-primary" : "bg-success"))" 
                                                 role="progressbar" 
                                                 style="width: @porcentaje%;" 
                                                 aria-valuenow="@porcentaje" 
                                                 aria-valuemin="0" 
                                                 aria-valuemax="100">
                                            </div>
                                        </div>
                                        <span class="small text-muted" style="font-size: 0.75rem;">@porcentaje%</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @estadoClass px-2 py-1 rounded-pill small">
                                        @item.EstadoCoherente
                                    </span>
                                    @if (item.TieneInconsistenciaEstado)
                                    {
                                        <a asp-action="CambiarEstado" asp-route-id="@item.IdHabitacion" 
                                           class="badge bg-warning text-dark text-decoration-none ms-1" 
                                           title="Inconsistencia detectada en base de datos (figuraba como '@item.Estado'). Haga clic para corregir.">
                                            <i class="bi bi-exclamation-triangle-fill"></i> BD: @item.Estado
                                        </a>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.IdHabitacion" class="btn btn-outline-secondary" title="Detalles">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.IdHabitacion" class="btn btn-outline-primary" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="CambiarEstado" asp-route-id="@item.IdHabitacion" class="btn btn-outline-warning" title="Cambiar Estado">
                                            <i class="bi bi-arrow-repeat"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.IdHabitacion" class="btn btn-outline-danger" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
