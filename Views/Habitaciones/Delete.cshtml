@model VITALIA.Models.Habitacion

@{
    ViewData["Title"] = $"Eliminar Habitación {Model.Numero}";
    int residentesCount = Model.Residentes?.Count ?? 0;
    bool puedeEliminar = residentesCount == 0;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Habitaciones</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Eliminar Habitación</li>
                </ol>
            </nav>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="card-header bg-danger text-white py-3 px-4">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-trash fs-4 me-2"></i>
                        <div>
                            <h2 class="h5 mb-0 fw-bold">Eliminar Habitación: @Model.Numero</h2>
                            <small class="text-white-50">Confirmación de eliminación segura con control de integridad</small>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    @if (!puedeEliminar)
                    {
                        <div class="alert alert-danger border-0 rounded-3 p-3 mb-4" role="alert">
                            <h6 class="fw-bold mb-1">
                                <i class="bi bi-shield-x me-1"></i> Operación Bloqueada por Integridad Referencial
                            </h6>
                            <p class="small mb-0">
                                Esta habitación tiene <strong>@residentesCount residente(s) asignado(s)</strong>.
                                Por políticas de seguridad e integridad del asilo, 
                                <strong>no es posible eliminar habitaciones con residentes activos</strong>.
                                Debe reubicar o dar de baja a los residentes antes de eliminarla.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning border-0 rounded-3 p-3 mb-4" role="alert">
                            <h6 class="fw-bold mb-1">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i> ¿Está seguro de eliminar esta habitación?
                            </h6>
                            <p class="small mb-0">
                                Esta acción eliminará el registro de la habitación de forma permanente de la base de datos VITALIADB.
                            </p>
                        </div>
                    }

                    <div class="bg-light rounded-3 p-3 mb-4">
                        <dl class="row mb-0 small">
                            <dt class="col-sm-5 text-muted">ID de Habitación:</dt>
                            <dd class="col-sm-7 fw-semibold text-dark">#@Model.IdHabitacion</dd>

                            <dt class="col-sm-5 text-muted">Número:</dt>
                            <dd class="col-sm-7 fw-semibold text-dark">@Model.Numero</dd>

                            <dt class="col-sm-5 text-muted">Capacidad:</dt>
                            <dd class="col-sm-7 fw-semibold text-dark">@Model.Capacidad plaza(s)</dd>

                            <dt class="col-sm-5 text-muted">Estado Actual:</dt>
                            <dd class="col-sm-7 fw-semibold text-dark">
                                @Model.EstadoCoherente
                                @if (Model.TieneInconsistenciaEstado)
                                {
                                    <span class="badge bg-warning text-dark ms-1 small" title="Valor guardado en BD">BD: @Model.Estado</span>
                                }
                            </dd>

                            <dt class="col-sm-5 text-muted">Residentes Asignados:</dt>
                            <dd class="col-sm-7 fw-semibold @(residentesCount > 0 ? "text-danger" : "text-dark")">@residentesCount</dd>
                        </dl>
                    </div>

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="IdHabitacion" />

                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">
                                Cancelar y Volver
                            </a>

                            @if (puedeEliminar)
                            {
                                <button type="submit" class="btn btn-danger px-4 rounded-pill fw-semibold shadow-sm">
                                    <i class="bi bi-trash me-1"></i> Confirmar Eliminación
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-secondary px-4 rounded-pill fw-semibold" disabled>
                                    <i class="bi bi-lock-fill me-1"></i> Eliminación Bloqueada
                                </button>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
