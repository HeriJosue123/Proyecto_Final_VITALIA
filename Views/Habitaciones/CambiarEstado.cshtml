@model VITALIA.Models.ViewModels.CambiarEstadoViewModel

@{
    ViewData["Title"] = $"Cambiar Estado de Habitación {Model.Numero}";
    var estados = ViewBag.EstadosDisponibles as List<string> ?? new List<string> { "Disponible", "Ocupada", "Mantenimiento", "Inactiva" };
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Habitaciones</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Cambiar Estado</li>
                </ol>
            </nav>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="card-header bg-warning text-dark py-3 px-4">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-arrow-repeat fs-4 me-2"></i>
                        <div>
                            <h2 class="h5 mb-0 fw-bold">Actualizar Estado: Habitación @Model.Numero</h2>
                            <small class="text-dark-50">Operación controlada de cambio de estado operativo</small>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    <div class="p-3 bg-light rounded-3 mb-4 small">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Estado Actual (BD):</span>
                            <span class="badge bg-secondary">@Model.EstadoActual</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Capacidad Total:</span>
                            <span class="fw-semibold text-dark">@Model.Capacidad plaza(s)</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Residentes Asignados:</span>
                            <span class="fw-bold text-dark">@Model.ResidentesAsignados</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Plazas Disponibles:</span>
                            <span class="fw-bold text-success">@Model.PlazasDisponibles libre(s)</span>
                        </div>
                    </div>

                    @if (Model.TieneInconsistenciaEstado)
                    {
                        <div class="alert alert-warning border-0 rounded-3 small mb-4 d-flex align-items-center" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-warning"></i>
                            <div>
                                <strong>Inconsistencia detectada en base de datos:</strong> La habitación figura como <em>@Model.EstadoActual</em> pero tiene <strong>@Model.ResidentesAsignados residente(s)</strong> de @Model.Capacidad plaza(s).
                                Seleccione un estado válido para corregir y sincronizar el registro en VITALIADB.
                            </div>
                        </div>
                    }

                    <form asp-action="CambiarEstado" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="IdHabitacion" />
                        <input type="hidden" asp-for="Numero" />
                        <input type="hidden" asp-for="Capacidad" />
                        <input type="hidden" asp-for="EstadoActual" />
                        <input type="hidden" asp-for="ResidentesAsignados" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 py-2 small" role="alert"></div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-dark">Seleccione el Nuevo Estado</label>
                            <div class="d-flex flex-column gap-2">
                                @foreach (var est in estados)
                                {
                                    bool permitido = Model.EsEstadoPermitido(est, out string? motivo);
                                    <div class="form-check p-3 border rounded-3 @(permitido ? "bg-light" : "bg-light-subtle opacity-75")">
                                        <input class="form-check-input" type="radio" asp-for="NuevoEstado" value="@est" id="estado_@est" 
                                               checked="@(Model.NuevoEstado == est ? "checked" : null)" 
                                               disabled="@(permitido ? null : "disabled")">
                                        <label class="form-check-label fw-semibold text-dark w-100" for="estado_@est">
                                            @est
                                            @if (!permitido)
                                            {
                                                <span class="badge bg-danger-subtle text-danger ms-2 small">@motivo</span>
                                            }
                                            <span class="d-block small text-muted fw-normal mt-1">
                                                @(est switch
                                                {
                                                    "Disponible" => "Habitación lista y disponible para alojar residentes.",
                                                    "Ocupada" => "Habitación que ha alcanzado su capacidad máxima.",
                                                    "Mantenimiento" => "En labores de reparación, pintura o adecuación sanitaria (requiere 0 residentes).",
                                                    "Inactiva" => "Fuera de servicio de forma temporal o indefinida (requiere 0 residentes).",
                                                    _ => "Estado operativo personalizado."
                                                })
                                            </span>
                                        </label>
                                    </div>
                                }
                            </div>
                            <span asp-validation-for="NuevoEstado" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">
                                Cancelar
                            </a>
                            <button type="submit" class="btn btn-warning px-4 rounded-pill fw-semibold shadow-sm text-dark">
                                <i class="bi bi-check2-circle me-1"></i> Confirmar Cambio
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
