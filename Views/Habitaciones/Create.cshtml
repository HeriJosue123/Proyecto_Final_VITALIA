@model VITALIA.Models.Habitacion

@{
    ViewData["Title"] = "Registrar Nueva Habitación";
    var estados = ViewBag.EstadosDisponibles as List<string> ?? new List<string> { "Disponible", "Mantenimiento", "Inactiva" };
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <!-- Navegación superior -->
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Habitaciones</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Nueva Habitación</li>
                </ol>
            </nav>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="card-header bg-primary text-white py-3 px-4">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-door-open-fill fs-4 me-2"></i>
                        <div>
                            <h2 class="h5 mb-0 fw-bold">Registrar Nueva Habitación</h2>
                            <small class="text-white-50">Ingrese los datos para registrar un cuarto en VITALIADB</small>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 py-2 small" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Numero" class="form-label fw-semibold text-dark">
                                Número o Identificador de Habitación <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-tag"></i></span>
                                <input asp-for="Numero" class="form-control bg-light" placeholder="Ej: 101, 102-A, B-01" maxlength="10" autofocus />
                            </div>
                            <span asp-validation-for="Numero" class="text-danger small"></span>
                            <div class="form-text small">Código identificador único de la habitación (máximo 10 caracteres).</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Capacidad" class="form-label fw-semibold text-dark">
                                Capacidad Máxima (Plazas) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-person"></i></span>
                                <input asp-for="Capacidad" type="number" min="1" max="100" class="form-control bg-light" />
                            </div>
                            <span asp-validation-for="Capacidad" class="text-danger small"></span>
                            <div class="form-text small">Cantidad máxima de residentes que pueden alojarse en esta habitación (mayor que 0).</div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Estado" class="form-label fw-semibold text-dark">
                                Estado Inicial <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Estado" class="form-select bg-light">
                                @foreach (var est in estados)
                                {
                                    <option value="@est">@est</option>
                                }
                            </select>
                            <span asp-validation-for="Estado" class="text-danger small"></span>
                            <div class="form-text small">Estado operativo inicial de la habitación.</div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">
                                Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary px-4 rounded-pill fw-semibold shadow-sm">
                                <i class="bi bi-check2-circle me-1"></i> Guardar Habitación
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
