@model VITALIA.Models.TipoAtencion

@{
    ViewData["Title"] = "Eliminar Tipo de Atención";
}

<div class="d-flex justify-content-center py-2">
    <div style="width: 100%; max-width: 720px;">
        
        <!-- Banner Superior de Encabezado -->
        <div class="vitalia-banner d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 p-3 rounded-4" style="background-color: #842029; color: white;">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-2 bg-white bg-opacity-10 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-exclamation-triangle-fill fs-4 text-white"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0 text-white">Eliminar Tipo de Atención</h3>
                    <p class="mb-0 small text-white-50">Confirme si desea eliminar permanentemente esta categoría</p>
                </div>
            </div>
            <div>
                <a asp-controller="TipoAtencion" asp-action="Index" class="btn btn-light text-dark fw-semibold rounded-3 px-3 py-2 text-nowrap" style="font-size: 0.85rem;">
                    ← Volver a la lista
                </a>
            </div>
        </div>

        <!-- Tarjeta Principal de Confirmación -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            
            <!-- Alerta Informativa -->
            <div class="alert alert-warning border-0 rounded-3 mb-4 d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-info-circle-fill fs-5"></i>
                <span class="small">Esta acción no se podrá deshacer si la categoría no tiene registros asociados en la bitácora.</span>
            </div>

            <!-- DATOS DE LA CATEGORÍA -->
            <div class="mb-3">
                <label class="form-label fw-bold text-muted small text-uppercase mb-1" style="letter-spacing: 0.5px;">CÓDIGO DE CATEGORÍA</label>
                <div class="fs-6 fw-bold text-dark">#@Model.IdTipoAtencion</div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold text-muted small text-uppercase mb-1" style="letter-spacing: 0.5px;">NOMBRE DE LA CATEGORÍA</label>
                <div class="fs-5 fw-semibold text-dark">@Model.NombreCategoria</div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold text-muted small text-uppercase mb-1" style="letter-spacing: 0.5px;">DESCRIPCIÓN</label>
                <div class="text-secondary bg-light p-3 rounded-3 border-light-subtle">
                    @(string.IsNullOrWhiteSpace(Model.Descripcion) ? "Sin descripción registrada." : Model.Descripcion)
                </div>
            </div>

            <!-- FORMULARIO DE ELIMINACIÓN -->
            <form asp-controller="TipoAtencion" asp-action="Delete" method="post" class="mt-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.IdTipoAtencion" />

                <div class="d-flex gap-2">
                    <a asp-controller="TipoAtencion" asp-action="Index" class="btn btn-light border py-2 fw-semibold text-dark rounded-3 flex-fill text-center">
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-danger py-2 fw-semibold rounded-3 flex-fill d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-trash-fill fs-5"></i> Sí, eliminar categoría
                    </button>
                </div>
            </form>

        </div>

    </div>
</div>