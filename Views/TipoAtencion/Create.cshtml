@model VITALIA.Models.TipoAtencion

@{
    ViewData["Title"] = "Registrar Nuevo Tipo de Atención";
}<div class="animate-fade-up py-4 d-flex justify-content-center">
    <div style="width: 100%; max-width: 680px;" class="px-3">

        <!-- Tarjeta Principal con Encabezado Verde Integrado -->
        <div class="card border-0 rounded-4 shadow-sm overflow-hidden bg-white">
            
            <!-- Encabezado Estilo Bloque Verde (De borde a borde) -->
            <div class="p-4 text-white d-flex align-items-center justify-content-between flex-wrap gap-3" style="background: linear-gradient(135deg, #14828a 0%, #093437 100%);">
                <div class="d-flex align-items-center gap-3">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white text-dark shadow-sm" style="width: 44px; height: 44px; color: #14828a !important;">
                        <i class="bi bi-tag-fill fs-5"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0">Registrar Tipo de Atención</h4>
                        <p class="text-white-50 small mb-0">Ingrese los datos de la nueva categoría para la bitácora</p>
                    </div>
                </div>
                <div>
                    <a asp-controller="TipoAtencion" asp-action="Index" class="btn btn-sm btn-light text-dark rounded-pill px-3 py-1.5 fw-semibold shadow-sm text-decoration-none">
                        ← Volver a la lista
                    </a>
                </div>
            </div>

            <!-- Cuerpo del Formulario -->
            <div class="card-body p-4 p-md-5">
                
                <form asp-controller="TipoAtencion" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <!-- Mensajes de Alerta -->
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4 small" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                        </div>
                    }

                    <!-- CAMPO: NOMBRE DE LA CATEGORÍA -->
                    <div class="mb-4">
                        <label asp-for="NombreCategoria" class="form-label fw-bold text-dark small text-uppercase tracking-wider mb-2 d-block text-start">
                            <i class="bi bi-bookmark-star text-primary me-1"></i> Nombre de la Categoría
                        </label>
                        <input asp-for="NombreCategoria" name="nombre_categoria" class="form-control form-control-lg rounded-3 fs-6 shadow-none" placeholder="Ej. Control Térmico, Curaciones, Alimentación..." required autocomplete="off" style="border-color: #cbd5e1; padding: 0.75rem 1rem;" />
                        <span asp-validation-for="NombreCategoria" class="text-danger small ms-1"></span>
                    </div>

                    <!-- CAMPO: DESCRIPCIÓN -->
                    <div class="mb-4">
                        <label asp-for="Descripcion" class="form-label fw-bold text-dark small text-uppercase tracking-wider mb-2 d-block text-start">
                            <i class="bi bi-card-text text-primary me-1"></i> Descripción <span class="text-muted fw-normal text-lowercase">(opcional)</span>
                        </label>
                        <textarea asp-for="Descripcion" name="descripcion" class="form-control rounded-3 fs-6 shadow-none" rows="3" placeholder="Ej. Registro de suministro de medicamentos y suplementos..." style="border-color: #cbd5e1; padding: 0.75rem 1rem;"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger small ms-1"></span>
                    </div>

                    <!-- BOTONES DE ACCIÓN BALANCEADOS -->
                    <div class="d-flex gap-2 pt-3 border-top">
                        <a asp-controller="TipoAtencion" asp-action="Index" class="btn btn-light rounded-3 py-2.5 px-4 fw-semibold text-secondary flex-grow-1 text-center">
                            Cancelar
                        </a>
                        <button type="submit" class="btn text-white fw-bold rounded-3 py-2.5 px-4 shadow-sm flex-grow-1 d-flex align-items-center justify-content-center gap-2" style="background: linear-gradient(135deg, #14828a 0%, #093437 100%); transition: all 0.2s ease;">
                            <i class="bi bi-check-circle-fill"></i> Guardar Categoría
                        </button>
                    </div>
                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}