@model VITALIA.Models.TipoAtencion

@{
    ViewData["Title"] = "Registrar Nuevo Tipo de Atención";
}

<div class="d-flex justify-content-center py-2">
    <div style="width: 100%; max-width: 720px;">
        
        <!-- Banner Superior de Encabezado -->
        <div class="vitalia-banner d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 p-3 rounded-4" style="background-color: #0b5e58; color: white;">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-2 bg-white bg-opacity-10 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-tag-fill fs-4 text-white"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0 text-white">Registrar Nuevo Tipo de Atención</h3>
                    <p class="mb-0 small text-white-50">Ingrese los datos de la nueva categoría para el personal</p>
                </div>
            </div>
            <div>
                <a asp-controller="TipoAtencion" asp-action="Index" class="btn btn-light text-dark fw-semibold rounded-3 px-3 py-2 text-nowrap" style="font-size: 0.85rem;">
                    ← Volver a la lista
                </a>
            </div>
        </div>

        <!-- Tarjeta Principal del Formulario -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <form asp-controller="TipoAtencion" asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <!-- Mensajes de Alerta -->
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-3 border-0 mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                    </div>
                }

                <!-- NOMBRE DE LA CATEGORÍA -->
                <div class="mb-4">
                    <label class="form-label fw-bold text-dark small text-uppercase mb-2" style="letter-spacing: 0.5px;">NOMBRE DE LA CATEGORÍA</label>
                    <input asp-for="NombreCategoria" name="nombre_categoria" class="form-control form-control-lg rounded-3 border-light-subtle fs-6 py-2" placeholder="Ej. Control Térmico, Curaciones, Alimentación..." required autocomplete="off" />
                    <span asp-validation-for="NombreCategoria" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- DESCRIPCIÓN (OPCIONAL) -->
                <div class="mb-4">
                    <label class="form-label fw-bold text-dark small text-uppercase mb-2" style="letter-spacing: 0.5px;">DESCRIPCIÓN (OPCIONAL)</label>
                    <textarea asp-for="Descripcion" name="descripcion" class="form-control rounded-3 border-light-subtle fs-6 py-2" rows="3" placeholder="Ej. Registro de suministro de medicamentos y suplementos..."></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- BOTÓN GUARDAR -->
                <div class="mt-4">
                    <button type="submit" class="btn w-100 py-2 fw-semibold text-white rounded-3 d-flex align-items-center justify-content-center gap-2" style="background-color: #0e857c; font-size: 1rem;">
                        <i class="bi bi-box-arrow-in-down fs-5"></i> Guardar Categoria
                    </button>
                </div>
            </form>
        </div>

    </div>
</div>