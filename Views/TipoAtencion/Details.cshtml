@model VITALIA.Models.TipoAtencion

@{
    ViewData["Title"] = "Detalles de Tipo de Atención";
}<div class="animate-fade-up py-3">
    <!-- NAVEGACIÓN SUPERIOR SEPARADA -->
    <div class="mb-3">
        <a asp-controller="TipoAtencion" asp-action="Index" class="btn btn-sm bg-white text-muted border rounded-pill px-3 py-1 shadow-sm text-decoration-none fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> Volver a Tipos de Atención
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-md-9 col-lg-7 col-xl-6">
            
            <!-- ENCABEZADO CENTRADO CON ÍCONO -->
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle text-white shadow-sm mb-2" style="width: 64px; height: 64px; background: linear-gradient(135deg, #14828a, #093437); font-size: 1.5rem;">
                    <i class="bi bi-tag-fill"></i>
                </div>
                <h3 class="fw-bold mb-1" style="color: #1a252f;">@Model.NombreCategoria</h3>
                <span class="badge bg-light text-muted border px-3 py-1 rounded-pill">Categoría ID: #@Model.IdTipoAtencion</span>
            </div>

            <!-- TARJETA DE DETALLES -->
            <div class="vitalia-card-pro p-4 p-md-5 position-relative overflow-hidden bg-white rounded-4 shadow-sm">
                <!-- Borde Superior de Acento -->
                <div style="position: absolute; top:0; left:0; right:0; height: 4px; background: linear-gradient(90deg, #14828a, #093437);"></div>

                <!-- GRILLA DE DETALLES -->
                <div class="row g-4 mb-4">
                    <div class="col-6 text-center border-end">
                        <span class="d-block text-muted small fw-bold text-uppercase tracking-wider mb-2">Código</span>
                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-semibold fs-6">
                            #@Model.IdTipoAtencion
                        </span>
                    </div>
                    <div class="col-6 text-center">
                        <span class="d-block text-muted small fw-bold text-uppercase tracking-wider mb-2">Nombre de Categoría</span>
                        <span class="fw-bold text-dark fs-6 d-block">
                            <i class="bi bi-bookmark-star text-primary me-1"></i>@Model.NombreCategoria
                        </span>
                    </div>
                </div>

                <!-- DESCRIPCIÓN -->
                <div class="bg-light p-3 rounded-3 mb-4 text-start border border-light-subtle">
                    <span class="text-muted d-block small text-uppercase fw-bold mb-1" style="letter-spacing: 0.5px;">DESCRIPCIÓN DE LA CATEGORÍA</span>
                    <span class="text-dark small lh-base">
                        @(string.IsNullOrWhiteSpace(Model.Descripcion) ? "Sin descripción detallada registrada." : Model.Descripcion)
                    </span>
                </div>

                <!-- BOTONES DE ACCIÓN BALANCEADOS -->
                <div class="d-flex gap-2 pt-3 border-top">
                    <a asp-controller="TipoAtencion" asp-action="Index" class="btn btn-light rounded-3 py-2 px-4 fw-semibold text-secondary flex-grow-1 text-center">
                        Cerrar
                    </a>
                    <a asp-controller="TipoAtencion" asp-action="Edit" asp-route-id="@Model.IdTipoAtencion" class="btn text-white rounded-3 py-2 px-4 fw-bold shadow-sm flex-grow-1 text-center" style="background-color: #14828a;">
                        <i class="bi bi-pencil-square me-1"></i> Editar Categoría
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>