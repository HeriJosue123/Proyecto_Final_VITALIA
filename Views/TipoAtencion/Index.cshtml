@model IEnumerable<VITALIA.Models.TipoAtencion>

@{
    ViewData["Title"] = "Tipos de Atención";
}<div class="animate-fade-up">
    <!-- Encabezado del Módulo -->
    <div class="vitalia-banner p-4 rounded-4 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3" style="background-color: #14828a;">
        <div>
            <h2 class="fw-bold mb-1 text-white">Tipos de Atención</h2>
            <p class="text-white-50 mb-0">Catálogo de categorías para la bitácora de atenciones</p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <!-- Buscador -->
            <form asp-controller="TipoAtencion" asp-action="Index" method="get" class="input-group search-box" style="width: 240px;">
                <span class="input-group-text bg-white border-end-0 rounded-start-pill text-muted ps-3">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" name="busqueda" class="form-control border-start-0 rounded-end-pill fs-6 pe-3" placeholder="Buscar categoría..." value="@ViewBag.BusquedaActual" autocomplete="off">
            </form>

            <!-- Botones -->
            <a asp-controller="TipoAtencion" asp-action="Create" class="btn bg-white rounded-pill px-3 py-2 fw-bold shadow-sm text-nowrap" style="color: #14828a;">
                <i class="bi bi-plus-lg me-1"></i> Nuevo tipo
            </a>
            <a asp-controller="Bitacora" asp-action="Index" class="btn btn-outline-light rounded-pill px-3 py-2 fw-semibold text-nowrap">
                <i class="bi bi-arrow-left me-1"></i> Bitácora
            </a>
        </div>
    </div>

    <!-- Alertas -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- Tabla de Tipos de Atención -->
    <div class="vitalia-card-pro p-4 bg-white rounded-4 shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr class="text-dark small fw-bold text-uppercase" style="border-bottom: 2px solid #f0f0f0;">
                        <th class="py-3" style="width: 90px;">Código</th>
                        <th class="py-3">Categoría</th>
                        <th class="py-3">Descripción</th>
                        <th class="py-3 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-muted fw-bold py-3">#@item.IdTipoAtencion</td>
                                <td class="py-3">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center me-2" style="background-color: rgba(20, 130, 138, 0.1); color: #14828a; width: 32px; height: 32px; font-size: 0.9rem;">
                                            <i class="bi bi-tag-fill"></i>
                                        </div>
                                        <span class="fw-bold text-dark">@item.NombreCategoria</span>
                                    </div>
                                </td>
                                <td class="text-muted py-3 small">
                                    @(string.IsNullOrWhiteSpace(item.Descripcion) ? "Sin descripción agregada" : item.Descripcion)
                                </td>
                                <td class="py-3 text-end">
                                    <div class="d-flex justify-content-end align-items-center gap-2">
                                        <a asp-controller="TipoAtencion" asp-action="Details" asp-route-id="@item.IdTipoAtencion" class="btn btn-sm btn-light text-dark rounded-2 text-nowrap">
                                            <i class="bi bi-eye me-1"></i>Ver
                                        </a>
                                        <a asp-controller="TipoAtencion" asp-action="Edit" asp-route-id="@item.IdTipoAtencion" class="btn btn-sm rounded-3 px-3 py-1 fw-semibold text-nowrap" style="color: #14828a; border: 1px solid #14828a; background-color: transparent;">
                                            <i class="bi bi-pencil me-1"></i>Editar
                                        </a>
                                        <a asp-controller="TipoAtencion" asp-action="Delete" asp-route-id="@item.IdTipoAtencion" class="btn btn-sm btn-outline-danger rounded-3 px-3 py-1 fw-semibold text-nowrap">
                                            <i class="bi bi-trash me-1"></i>Eliminar
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox display-6 d-block mb-2 opacity-50"></i>
                                No se encontraron tipos de atención registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>