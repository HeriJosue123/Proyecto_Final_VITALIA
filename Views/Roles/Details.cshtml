@model VITALIA.Models.Rol

@{
    ViewData["Title"] = "Detalles del Rol";
}

<div class="animate-fade-up py-3">
    <!-- NAVEGACIÓN SUPERIOR SEPARADA -->
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-sm bg-white text-muted border rounded-pill px-3 py-1 shadow-sm text-decoration-none fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> Volver a Roles
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-md-9 col-lg-7 col-xl-6">
            
            <!-- ENCABEZADO CENTRADO -->
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle text-white shadow-sm mb-2" style="width: 64px; height: 64px; background: linear-gradient(135deg, #14828a, #093437);">
                    <i class="bi bi-shield-check fs-2"></i>
                </div>
                <h3 class="fw-bold mb-1" style="color: #1a252f;">@Model.NombreRol</h3>
                <span class="badge bg-light text-muted border px-3 py-1 rounded-pill">ID de Rol: #@Model.IdRol</span>
            </div>

            <!-- TARJETA DE DETALLES -->
            <div class="vitalia-card-pro p-4 p-md-5 position-relative overflow-hidden">
                <!-- Borde Superior de Acento -->
                <div style="position: absolute; top:0; left:0; right:0; height: 4px; background: linear-gradient(90deg, #14828a, #093437);"></div>

                <div class="bg-light p-3 rounded-3 mb-4 text-start border">
                    <span class="text-muted d-block small text-uppercase fw-bold mb-1">
                        <i class="bi bi-card-text text-primary me-1"></i> Descripción del Rol
                    </span>
                    <p class="fs-6 text-dark mb-0">
                        @(string.IsNullOrEmpty(Model.Descripcion) ? "No se ha asignado una descripción para este rol." : Model.Descripcion)
                    </p>
                </div>

                <!-- BOTONES DE ACCIÓN BALANCEADOS -->
                <div class="d-flex gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light rounded-3 py-2 px-4 fw-semibold text-secondary flex-grow-1 text-center">
                        Regresar
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.IdRol" class="btn text-white rounded-3 py-2 px-4 fw-bold shadow-sm flex-grow-1 text-center" style="background-color: #14828a;">
                        <i class="bi bi-pencil-square me-1"></i> Editar Rol
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>