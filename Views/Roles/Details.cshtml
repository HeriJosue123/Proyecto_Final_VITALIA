@model VITALIA.Models.Rol

@{
    ViewData["Title"] = "Detalles del Rol";
}

<div class="animate-fade-up py-4 d-flex justify-content-center">
    <div style="width: 100%; max-width: 680px;" class="px-3">

        <!-- Tarjeta Principal con Encabezado Verde Integrado -->
        <div class="card border-0 rounded-4 shadow-sm overflow-hidden bg-white">
            
            <!-- Encabezado Estilo Bloque Verde (De borde a borde) -->
            <div class="p-4 text-white d-flex align-items-center justify-content-between flex-wrap gap-3" style="background: linear-gradient(135deg, #14828a 0%, #093437 100%);">
                <div class="d-flex align-items-center gap-3">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white text-dark shadow-sm flex-shrink-0" style="width: 44px; height: 44px; color: #14828a !important;">
                        <i class="bi bi-shield-check fs-5"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h4 class="fw-bold mb-0">Detalles del Rol</h4>
                            <span class="badge bg-white bg-opacity-25 text-white border border-white border-opacity-25 rounded-pill px-3 py-1" style="font-size: 0.75rem;">
                                ID: #@Model.IdRol
                            </span>
                        </div>
                        <p class="text-white-50 small mb-0">Información del nivel de acceso y permisos del sistema</p>
                    </div>
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-sm btn-light text-dark rounded-pill px-3 py-1.5 fw-semibold shadow-sm text-decoration-none">
                        ← Volver a Roles
                    </a>
                </div>
            </div>

            <!-- Cuerpo de la Tarjeta -->
            <div class="card-body p-4 p-md-5">

                <!-- Nombre del Rol -->
                <div class="p-3 rounded-3 bg-light border border-light-subtle mb-3">
                    <span class="text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                        NOMBRE DEL ROL
                    </span>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-lock fs-5" style="color: #14828a;"></i>
                        <span class="fw-bold text-dark fs-5 mb-0">@Model.NombreRol</span>
                    </div>
                </div>

                <!-- Descripción del Rol -->
                <div class="p-3 rounded-3 bg-light border border-light-subtle mb-4">
                    <span class="text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                        DESCRIPCIÓN DEL PERFIL
                    </span>
                    <div class="d-flex align-items-start gap-2 pt-1">
                        <i class="bi bi-card-text fs-5 text-muted flex-shrink-0"></i>
                        <p class="fw-medium text-dark small mb-0 lh-base">
                            @(string.IsNullOrEmpty(Model.Descripcion) ? "No se ha asignado una descripción para este rol." : Model.Descripcion)
                        </p>
                    </div>
                </div>

                <!-- Botones de Acción Balanceados a Ancho Completo -->
                <div class="d-flex gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light rounded-3 py-2.5 px-4 fw-semibold text-secondary flex-grow-1 text-center text-decoration-none">
                        Cerrar
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.IdRol" class="btn text-white fw-bold rounded-3 py-2.5 px-4 shadow-sm flex-grow-1 d-flex align-items-center justify-content-center gap-2" style="background: linear-gradient(135deg, #14828a 0%, #093437 100%); transition: all 0.2s ease;">
                        <i class="bi bi-pencil-square"></i> Editar Rol
                    </a>
                </div>

            </div>
        </div>

    </div>
</div>