@model VITALIA.Models.Rol

@{
    ViewData["Title"] = "Eliminar Rol";
}<!-- Contenedor ajustado con altura fija relativa a la ventana para centrado exacto --><div class="d-flex justify-content-center align-items-center w-100 animate-fade-up" style="height: 85vh;">
    <div style="width: 100%; max-width: 500px;">

        <!-- Tarjeta Principal de Eliminación -->
        <div class="card border-0 rounded-4 shadow-sm overflow-hidden bg-white">
            
            <!-- Encabezado Rojo -->
            <div class="py-3 px-4 text-center text-white" style="background: linear-gradient(135deg, #dc3545 0%, #a71d2a 100%);">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white text-danger shadow-sm mb-2" style="width: 44px; height: 44px;">
                    <i class="bi bi-shield-x fs-5"></i>
                </div>
                <h5 class="fw-bold mb-1">Confirmar Eliminación</h5>
                <p class="text-white small mb-0 opacity-90 fw-medium" style="font-size: 0.85rem;">¿Desea eliminar permanentemente este perfil de rol?</p>
            </div>

            <div class="card-body p-3">
                
                <!-- Advertencia -->
                <div class="p-3 px-3 rounded-3 mb-3 d-flex align-items-center gap-2" style="background-color: #fff5f5; border-left: 4px solid #dc3545;">
                    <i class="bi bi-exclamation-octagon-fill text-danger fs-6 flex-shrink-0"></i>
                    <div class="small text-danger-emphasis fw-medium" style="font-size: 0.80rem;">
                        <strong>Atención:</strong> Esta acción no se puede deshacer. Los usuarios asociados a este rol perderán su perfil asignado.
                    </div>
                </div>

                <!-- Nombre del Rol -->
                <div class="bg-light p-3 rounded-3 mb-3 border border-light-subtle">
                    <span class="text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.6px;">
                        NOMBRE DEL ROL
                    </span>
                    <span class="fs-6 fw-bold text-dark d-block lh-base">#@Model.IdRol - @Model.NombreRol</span>
                </div>

                <!-- Grilla de Detalle -->
                <div class="row g-2 mb-3">
                    <!-- Descripción -->
                    <div class="col-12">
                        <div class="p-2 px-3 rounded-3 bg-body-tertiary h-100">
                            <span class="text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 0.62rem; letter-spacing: 0.5px;">DESCRIPCIÓN</span>
                            <div class="fw-medium text-dark lh-sm" style="font-size: 0.85rem;">
                                @(string.IsNullOrEmpty(Model.Descripcion) ? "Sin descripción especificada" : Model.Descripcion)
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Botones de Acción -->
                <form asp-action="Delete" method="post" class="pt-1">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="IdRol" />

                    <div class="row g-2">
                        <div class="col-6">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-3 py-2 fw-semibold w-100 d-flex align-items-center justify-content-center border-2 transition-all" style="font-size: 0.85rem;">
                                <i class="bi bi-x-circle fs-6 me-2"></i> Cancelar
                            </a>
                        </div>
                        <div class="col-6">
                            <button type="submit" class="btn btn-danger rounded-3 py-2 fw-bold shadow-sm w-100 d-flex align-items-center justify-content-center transition-all" style="background-color: #dc3545; font-size: 0.85rem;">
                                <i class="bi bi-trash-fill fs-6 me-2"></i> Confirmar
                            </button>
                        </div>
                    </div>
                </form>

            </div>
        </div>

    </div></div><style>
    body {
        overflow: hidden !important;
    }
    
    .transition-all {
        transition: all 0.2s ease-in-out;
    }
    .transition-all:hover {
        transform: translateY(-1px);
    }</style>