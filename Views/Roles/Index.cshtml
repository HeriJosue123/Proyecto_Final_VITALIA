@model IEnumerable<VITALIA.Models.Rol>

@{
    ViewData["Title"] = "Gestión de Usuarios y Roles";
}

<div class="animate-fade-up">
    <!-- Encabezado y Botón -->
    <div class="vitalia-banner d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1" style="color: #1a252f;">Gestión de Usuarios y Roles</h2>
            <p class="text-muted mb-0">Cuentas de acceso y asignación de permisos del sistema</p>
        </div>
        <div>
            <a asp-controller="Roles" asp-action="Create" class="btn text-white rounded-3 px-3 py-2 fw-semibold shadow-sm" style="background-color: #14828a;">
                <i class="bi bi-shield-plus me-1"></i> + Nuevo Rol
            </a>
        </div>
    </div>

    <!-- Pestañas (Tabs) -->
    <ul class="nav nav-pills mb-4 p-1 bg-white rounded-3 shadow-sm d-inline-flex border" style="gap: 4px;">
        <li class="nav-item">
            <a class="nav-link text-muted fw-semibold px-4 py-2 rounded-3" asp-controller="Usuario" asp-action="Index">
                <i class="bi bi-people-fill me-2"></i> Usuarios
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link active fw-semibold px-4 py-2 rounded-3 text-white" style="background-color: #14828a;" href="#">
                <i class="bi bi-shield-lock-fill me-2"></i> Roles
            </a>
        </li>
    </ul>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tabla de Roles -->
    <div class="vitalia-card-pro p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr class="text-muted small text-uppercase">
                        <th style="width: 80px;">ID</th>
                        <th>Nombre del Rol</th>
                        <th>Descripción</th>
                        <th class="text-center">Usuarios Asignados</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-muted fw-bold">#@item.IdRol</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle p-2 me-2" style="background-color: rgba(20, 130, 138, 0.1); color: #14828a;">
                                            <i class="bi bi-shield-check"></i>
                                        </div>
                                        <span class="fw-bold text-dark">@item.NombreRol</span>
                                    </div>
                                </td>
                                <td class="text-muted">
                                    @(string.IsNullOrEmpty(item.Descripcion) ? "Sin descripción especificada" : item.Descripcion)
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-semibold">
                                        <i class="bi bi-person me-1 text-primary"></i>@(item.Usuarios?.Count ?? 0)
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.IdRol" class="btn btn-sm btn-light text-dark rounded-2 me-1"><i class="bi bi-eye me-1"></i>Ver</a>
                                    <a asp-action="Edit" asp-route-id="@item.IdRol" class="btn btn-sm btn-outline-primary rounded-2 me-1"><i class="bi bi-pencil me-1"></i>Editar</a>
                                    <a asp-action="Delete" asp-route-id="@item.IdRol" class="btn btn-sm btn-outline-danger rounded-2"><i class="bi bi-trash me-1"></i>Eliminar</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-shield-x display-6 d-block mb-2 opacity-50"></i>
                                No hay roles registrados actualmente.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>