@model IEnumerable<VITALIA.Models.Rol>

@{
    ViewData["Title"] = "Gestión de Usuarios y Roles";
}

<div class="animate-fade-up">
    <!-- Encabezado y Botón -->
    <div class="vitalia-banner p-4 rounded-4 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3" style="background-color: #14828a;">
        <div>
            <h2 class="fw-bold mb-1 text-white">Gestión de Usuarios y Roles</h2>
            <p class="text-white-50 mb-0">Cuentas de acceso y asignación de permisos del sistema</p>
        </div>
        <div>
            <a asp-controller="Roles" asp-action="Create" class="btn bg-white rounded-pill px-4 py-2 fw-bold shadow-sm" style="color: #14828a;">
                <i class="bi bi-plus-lg me-1"></i> Nuevo Rol
            </a>
        </div>
    </div>

    <!-- Pestañas (Tabs) -->
    <ul class="nav nav-pills mb-4 p-1 bg-white rounded-3 shadow-sm d-inline-flex border" style="gap: 4px;">
        <li class="nav-item">
            <a class="nav-link text-muted fw-semibold px-4 py-2 rounded-3" asp-controller="Usuario" asp-action="Index">
                <i class="bi bi-people-fill me-2"></i> Usuarios
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link active fw-semibold px-4 py-2 rounded-3 text-white" style="background-color: #14828a;" href="#">
                <i class="bi bi-shield-lock-fill me-2"></i> Roles
            </a>
        </li>
    </ul>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tabla de Roles -->
    <div class="vitalia-card-pro p-4 bg-white rounded-4 shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr class="text-dark small fw-bold text-uppercase" style="border-bottom: 2px solid #f0f0f0;">
                        <th class="py-3" style="width: 80px;">ID</th>
                        <th class="py-3">Nombre del Rol</th>
                        <th class="py-3">Descripción</th>
                        <th class="py-3 text-center">Usuarios Asignados</th>
                        <th class="py-3 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-muted fw-bold">#@item.IdRol</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="background-color: rgba(20, 130, 138, 0.1); color: #14828a; width: 36px; height: 36px;">
                                            <i class="bi bi-shield-check"></i>
                                        </div>
                                        <span class="fw-bold text-dark">@item.NombreRol</span>
                                    </div>
                                </td>
                                <td class="text-muted">
                                    @(string.IsNullOrEmpty(item.Descripcion) ? "Sin descripción especificada" : item.Descripcion)
                                </td>
                                <td class="text-center">
                                    <span class="badge border px-3 py-2 rounded-pill text-muted fw-normal" style="background-color: transparent; border-color: #dee2e6 !important;">
                                        <i class="bi bi-person me-1" style="color: #9cb1c2;"></i>@(item.Usuarios?.Count ?? 0)
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex justify-content-end align-items-center gap-2">
                                        <a asp-action="Details" asp-route-id="@item.IdRol" class="btn btn-sm btn-link text-secondary text-decoration-none fw-semibold">
                                            <i class="bi bi-eye me-1"></i>Ver
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.IdRol" class="btn btn-sm rounded-3 px-3 fw-semibold" style="color: #14828a; border: 1px solid #14828a; background-color: transparent;">
                                            <i class="bi bi-pencil me-1"></i>Editar
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.IdRol" class="btn btn-sm btn-outline-danger rounded-3 px-3 fw-semibold">
                                            <i class="bi bi-trash me-1"></i>Eliminar
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-shield-x display-6 d-block mb-2 opacity-50"></i>
                                No hay roles registrados actualmente.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>