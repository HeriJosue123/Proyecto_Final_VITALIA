@inject VITALIA.Data.VitaliaDbContext BaseDatos
@{
    // Datos del usuario que inició sesión
    bool esAdministrador = User.IsInRole(RolesSistema.Administrador);

    // "Datos de presentación" solo se ve mientras no se hayan cargado
    bool mostrarDatosPresentacion = false;
    if (esAdministrador)
    {
        try { mostrarDatosPresentacion = !await VITALIA.Data.DatosPresentacion.CargadosAsync(BaseDatos); }
        catch { mostrarDatosPresentacion = false; }
    }
    bool esFamiliar = User.IsInRole(RolesSistema.Familiar);
    bool puedeAccederFarmacia = User.IsInRole("Administrador") || User.IsInRole("Medico") || User.IsInRole("Médico") || User.IsInRole("Enfermero");
    string nombreUsuario = User.Identity?.Name ?? "";
    string rolUsuario = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    string correoUsuario = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
    bool nombreEsCorreo = nombreUsuario == correoUsuario;

    // Iniciales
    var partesNombre = nombreUsuario.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    string iniciales = nombreEsCorreo || partesNombre.Length == 0
        ? (nombreUsuario.Length > 0 ? nombreUsuario.Substring(0, 1).ToUpper() : "")
        : string.Concat(partesNombre.Take(2).Select(p => char.ToUpper(p[0])));

    // Correo con corte de línea antes del @
    Func<string, Microsoft.AspNetCore.Html.IHtmlContent> correoPartido = texto =>
        new Microsoft.AspNetCore.Html.HtmlString(string.Join("<wbr>@", texto.Split('@').Select(System.Net.WebUtility.HtmlEncode)));

    // Datos para la tarjeta del perfil (cargo y a cuántos residentes atiende o tiene vinculados)
    string? cargoPerfil = null;
    int residentesPerfil = 0;
    if (int.TryParse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var idUsuarioPerfil))
    {
        try
        {
            if (esFamiliar)
            {
                residentesPerfil = BaseDatos.FamiliarResidentes.Count(f => f.IdUsuario == idUsuarioPerfil);
            }
            else
            {
                var empleadoPerfil = BaseDatos.Empleados.Where(e => e.IdUsuario == idUsuarioPerfil)
                    .Select(e => new { e.IdEmpleado, e.Cargo }).FirstOrDefault();
                if (empleadoPerfil != null)
                {
                    cargoPerfil = empleadoPerfil.Cargo;
                    residentesPerfil = BaseDatos.AsignacionCuidados.Count(a => a.IdEmpleado == empleadoPerfil.IdEmpleado && a.Estado);
                }
            }
        }
        catch { }
    }
    string etiquetaResidentes = esFamiliar ? "Familiares vinculados" : "Residentes a su cargo";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VITALIA</title>

    <!-- Bootstrap 5 CSS y Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Estilos Oficiales de Vitalia -->
    <style>
            :root {
                --vitalia-sidebar-bg: #093437;
                --vitalia-sidebar-text: #a3c2c4;
                --vitalia-primary: #12898e;
                --vitalia-primary-hover: #0e6c70;
                --vitalia-bg: #f2f5f7;
            }

            body {
                background-color: var(--vitalia-bg);
                font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
                margin: 0;
            }

            /* Reemplazo global del color azul de Bootstrap por Turquesa Vitalia */
            .btn-primary, .btn-vitalia {
                background-color: var(--vitalia-primary) !important;
                border-color: var(--vitalia-primary) !important;
                color: #ffffff !important;
                font-weight: 600;
                border-radius: 8px;
                padding: 0.5rem 1.25rem;
            }

                .btn-primary:hover, .btn-vitalia:hover {
                    background-color: var(--vitalia-primary-hover) !important;
                    border-color: var(--vitalia-primary-hover) !important;
                }

            .btn-outline-primary, .btn-outline-vitalia {
                color: var(--vitalia-primary) !important;
                border-color: var(--vitalia-primary) !important;
                font-weight: 600;
                border-radius: 8px;
                padding: 0.5rem 1.25rem;
            }

                .btn-outline-primary:hover, .btn-outline-vitalia:hover {
                    background-color: var(--vitalia-primary) !important;
                    color: #ffffff !important;
                }

            .text-primary {
                color: var(--vitalia-primary) !important;
            }

            .bg-primary {
                background-color: var(--vitalia-primary) !important;
            }

            /* Layout Dashboard */
            .vitalia-wrapper {
                display: flex;
                min-height: 100vh;
            }

            .vitalia-sidebar {
                width: 250px;
                background-color: var(--vitalia-sidebar-bg);
                color: #fff;
                display: flex;
                flex-direction: column;
                position: fixed;
                top: 0;
                bottom: 0;
                left: 0;
                z-index: 1000;
                padding: 1.5rem 1rem;
                /* Si el menú no cabe en la pantalla, se desplaza solo él */
                overflow-y: auto;
                overscroll-behavior: contain;
                scrollbar-width: thin;
                scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
            }

                .vitalia-sidebar::-webkit-scrollbar {
                    width: 6px;
                }

                .vitalia-sidebar::-webkit-scrollbar-thumb {
                    background-color: rgba(255, 255, 255, 0.2);
                    border-radius: 3px;
                }

            .vitalia-content {
                margin-left: 250px;
                flex: 1;
                padding: 2rem;
                background-color: var(--vitalia-bg);
                min-height: 100vh;
            }

            .sidebar-brand {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                font-size: 1.4rem;
                font-weight: 700;
                color: #fff;
                text-decoration: none;
                margin-bottom: 1.25rem;
                padding-left: 0.5rem;
            }

            .brand-icon {
                width: 36px;
                height: 36px;
                background-color: #17a2a8;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #fff;
            }

            .sidebar-section-label {
                font-size: 0.7rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.08em;
                color: #5c8b8e;
                margin-top: 1rem;
                margin-bottom: 0.5rem;
                padding-left: 0.75rem;
            }

            .sidebar-nav {
                list-style: none;
                padding: 0;
                margin: 0;
            }

                .sidebar-nav .nav-link {
                    display: flex;
                    align-items: center;
                    gap: 0.75rem;
                    padding: 0.65rem 0.9rem;
                    color: #b1d1d3;
                    border-radius: 10px;
                    font-weight: 500;
                    text-decoration: none;
                    transition: all 0.2s ease;
                    margin-bottom: 0.25rem;
                }

                    .sidebar-nav .nav-link:hover {
                        color: #fff;
                        background-color: rgba(255, 255, 255, 0.08);
                    }

                    .sidebar-nav .nav-link.active {
                        background-color: #ffffff;
                        color: #093437;
                        font-weight: 700;
                        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
                    }

                        .sidebar-nav .nav-link.active i {
                            color: #12898e;
                        }

            .sidebar-user {
                margin-top: auto;
                background-color: rgba(255, 255, 255, 0.08);
                border: 1px solid rgba(255, 255, 255, 0.08);
                border-radius: 14px;
                padding: 0.9rem;
            }

            .sidebar-user-nombre {
                color: #ffffff;
                font-weight: 700;
                font-size: 0.85rem;
                line-height: 1.25;
                overflow-wrap: anywhere;
            }

            .sidebar-user-rol {
                display: inline-flex;
                align-items: center;
                gap: 0.3rem;
                margin-top: 0.35rem;
                padding: 0.15rem 0.55rem;
                border-radius: 999px;
                background-color: rgba(23, 162, 168, 0.25);
                color: #c9eef0;
                font-size: 0.68rem;
                font-weight: 600;
            }

            .user-avatar {
                flex-shrink: 0;
                width: 40px;
                height: 40px;
                background-color: #e09f3e;
                color: #fff;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
                font-size: 0.85rem;
            }

            /* Animaciones globales (escapado para Razor con doble @@) */
            @@keyframes fadeInUp {
                from {
                    opacity: 0;
                    transform: translateY(18px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .animate-fade-up {
                animation: fadeInUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            }

            /* Redefinición de Focus para Inputs de Vitalia */
            .form-control:focus, .form-select:focus {
                border-color: #14828a !important;
                box-shadow: 0 0 0 0.25rem rgba(20, 130, 138, 0.18) !important;
            }

            /* Tarjeta de estilo Pro */
            .vitalia-card-pro {
                background: #ffffff;
                border-radius: 18px;
                border: 1px solid rgba(0, 0, 0, 0.05);
                box-shadow: 0 12px 35px -8px rgba(9, 52, 55, 0.07);
                transition: transform 0.3s ease, box-shadow 0.3s ease;
            }

            /* Estilo para grupo de inputs con icono */
            .input-group-text-vitalia {
                background-color: #f8fafc;
                border-right: none;
                color: #14828a;
                border-top-left-radius: 12px;
                border-bottom-left-radius: 12px;
            }

            .input-vitalia {
                border-left: none;
                border-top-right-radius: 12px;
                border-bottom-right-radius: 12px;
            }

                .input-vitalia:focus {
                    border-left: 1px solid #14828a !important;
                }

            /* Chips interactivos para sugerencias rápidas */
            .role-chip {
                cursor: pointer;
                transition: all 0.2s ease;
                border: 1px solid #e2e8f0;
                font-size: 0.82rem;
            }

                .role-chip:hover {
                    background-color: #14828a !important;
                    color: #ffffff !important;
                    border-color: #14828a !important;
                    transform: translateY(-2px);
                }

            /* Tarjeta de encabezado de los módulos */
            .vitalia-banner {
                background: linear-gradient(135deg, #0d3c3d 0%, #118a8b 100%);
                color: #ffffff;
                border-radius: 1rem;
                padding: 1rem 1.5rem;
                box-shadow: 0 .125rem .25rem rgba(0, 0, 0, .075);
            }

                .vitalia-banner h2, .vitalia-banner h3 {
                    color: #ffffff !important;
                }

                .vitalia-banner p.text-muted {
                    color: rgba(255, 255, 255, .75) !important;
                }

                .vitalia-banner .btn {
                    background-color: #ffffff !important;
                    color: #0d3c3d !important;
                    border-color: #ffffff !important;
                    font-weight: 600;
                }

                    .vitalia-banner .btn:hover {
                        background-color: #e6f4f4 !important;
                    }

            /* ===== Tarjeta del perfil (se abre al tocar el usuario del menú) ===== */
            .perfil-disparador {
                width: 100%;
                display: flex;
                align-items: center;
                gap: 0.65rem;
                padding: 0;
                border: 0;
                background: transparent;
                color: inherit;
                text-align: left;
                cursor: pointer;
            }

            .sidebar-user {
                transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
                cursor: pointer;
            }

                .sidebar-user:hover {
                    background-color: rgba(255, 255, 255, 0.13);
                    border-color: rgba(255, 255, 255, 0.16);
                }

                .sidebar-user.abierto {
                    background-color: rgba(23, 162, 168, 0.22);
                    border-color: rgba(23, 162, 168, 0.55);
                }

            .perfil-chevron {
                color: #a3c2c4;
                font-size: 1rem;
                transition: transform 0.25s ease, color 0.2s ease;
            }

            .sidebar-user:hover .perfil-chevron, .sidebar-user.abierto .perfil-chevron {
                color: #ffffff;
            }

            .sidebar-user.abierto .perfil-chevron {
                transform: rotate(180deg);
            }

            .perfil-fondo {
                position: fixed;
                inset: 0;
                z-index: 1040;
                background: rgba(9, 52, 55, 0.18);
                backdrop-filter: blur(2px);
                opacity: 0;
                transition: opacity 0.22s ease;
            }

                .perfil-fondo.visible {
                    opacity: 1;
                }

            .perfil-tarjeta {
                position: fixed;
                left: 262px;
                bottom: 18px;
                z-index: 1045;
                width: 340px;
                max-width: calc(100vw - 24px);
                max-height: calc(100vh - 36px);
                overflow-y: auto;
                overscroll-behavior: contain;
                background: #ffffff;
                border-radius: 22px;
                box-shadow: 0 24px 60px rgba(9, 52, 55, 0.28), 0 4px 14px rgba(9, 52, 55, 0.12);
                transform-origin: bottom left;
                opacity: 0;
                transform: translateY(10px) scale(0.94);
                transition: opacity 0.22s ease, transform 0.26s cubic-bezier(0.2, 0.9, 0.3, 1.2);
            }

                .perfil-tarjeta.visible {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }

            .perfil-cabecera {
                position: relative;
                overflow: hidden;
                padding: 1.6rem 1.4rem 1.3rem;
                text-align: center;
                color: #ffffff;
                background: linear-gradient(140deg, #093437 0%, #0e6c70 55%, #17a2a8 100%);
            }

                .perfil-cabecera::before, .perfil-cabecera::after {
                    content: "";
                    position: absolute;
                    border-radius: 50%;
                    background: rgba(255, 255, 255, 0.08);
                    pointer-events: none;
                }

                .perfil-cabecera::before {
                    width: 190px;
                    height: 190px;
                    top: -90px;
                    right: -60px;
                }

                .perfil-cabecera::after {
                    width: 120px;
                    height: 120px;
                    bottom: -70px;
                    left: -40px;
                }

            .perfil-cerrar {
                position: absolute;
                top: 0.75rem;
                right: 0.75rem;
                z-index: 1;
                width: 32px;
                height: 32px;
                border: 0;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.14);
                color: #ffffff;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: background-color 0.2s ease;
            }

                .perfil-cerrar:hover {
                    background: rgba(255, 255, 255, 0.28);
                }

            .perfil-avatar {
                position: relative;
                z-index: 1;
                width: 78px;
                height: 78px;
                margin: 0 auto 0.8rem;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.6rem;
                font-weight: 800;
                letter-spacing: 0.02em;
                color: #ffffff;
                background: linear-gradient(145deg, #f3b75a 0%, #e09f3e 60%, #c9832a 100%);
                box-shadow: 0 0 0 5px rgba(255, 255, 255, 0.18), 0 10px 24px rgba(0, 0, 0, 0.25);
            }

                .perfil-avatar .perfil-en-linea {
                    position: absolute;
                    right: 3px;
                    bottom: 4px;
                    width: 16px;
                    height: 16px;
                    border-radius: 50%;
                    background: #2ecc71;
                    border: 3px solid #0e6c70;
                }

            .perfil-nombre {
                position: relative;
                z-index: 1;
                font-size: 1.12rem;
                font-weight: 800;
                line-height: 1.25;
                overflow-wrap: anywhere;
            }

            .perfil-correo {
                position: relative;
                z-index: 1;
                font-size: 0.8rem;
                color: rgba(255, 255, 255, 0.75);
                overflow-wrap: anywhere;
                margin-top: 0.15rem;
            }

            .perfil-insignia {
                position: relative;
                z-index: 1;
                display: inline-flex;
                align-items: center;
                gap: 0.35rem;
                margin-top: 0.75rem;
                padding: 0.3rem 0.8rem;
                border-radius: 999px;
                background: rgba(255, 255, 255, 0.16);
                border: 1px solid rgba(255, 255, 255, 0.22);
                font-size: 0.75rem;
                font-weight: 700;
            }

            .perfil-cuerpo {
                padding: 1.1rem 1.2rem 1.2rem;
            }

            .perfil-dato {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                padding: 0.55rem 0.2rem;
            }

                .perfil-dato + .perfil-dato {
                    border-top: 1px solid #eef2f4;
                }

            .perfil-dato-icono {
                flex-shrink: 0;
                width: 36px;
                height: 36px;
                border-radius: 11px;
                background: #e8f4f5;
                color: #12898e;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1rem;
            }

            .perfil-dato-etiqueta {
                font-size: 0.66rem;
                font-weight: 700;
                letter-spacing: 0.06em;
                text-transform: uppercase;
                color: #7a9a9c;
            }

            .perfil-dato-valor {
                font-size: 0.88rem;
                font-weight: 600;
                color: #093437;
                overflow-wrap: anywhere;
            }

            .perfil-activa {
                display: inline-flex;
                align-items: center;
                gap: 0.35rem;
                color: #1e9e5a;
            }

                .perfil-activa::before {
                    content: "";
                    width: 8px;
                    height: 8px;
                    border-radius: 50%;
                    background: #2ecc71;
                    box-shadow: 0 0 0 3px rgba(46, 204, 113, 0.2);
                }

            .perfil-acciones {
                margin-top: 0.9rem;
                display: grid;
                gap: 0.5rem;
            }

            .perfil-accion {
                width: 100%;
                display: flex;
                align-items: center;
                gap: 0.75rem;
                padding: 0.7rem 0.85rem;
                border-radius: 14px;
                border: 1px solid #e3ecee;
                background: #ffffff;
                color: #093437;
                font-size: 0.88rem;
                font-weight: 600;
                text-align: left;
                text-decoration: none;
                transition: all 0.2s ease;
            }

                .perfil-accion i:first-child {
                    font-size: 1.05rem;
                    color: #12898e;
                }

                .perfil-accion .bi-chevron-right {
                    margin-left: auto;
                    color: #a9bfc1;
                    font-size: 0.8rem;
                    transition: transform 0.2s ease;
                }

                .perfil-accion:hover {
                    border-color: #12898e;
                    background: #f2fafa;
                    color: #093437;
                }

                    .perfil-accion:hover .bi-chevron-right {
                        transform: translateX(3px);
                        color: #12898e;
                    }

                .perfil-accion.peligro i:first-child {
                    color: #dc3545;
                }

                .perfil-accion.peligro:hover {
                    border-color: #dc3545;
                    background: #fff5f5;
                    color: #a71d2a;
                }

            .perfil-pie {
                padding: 0.7rem 1.2rem;
                border-top: 1px solid #eef2f4;
                background: #f8fbfb;
                text-align: center;
                font-size: 0.7rem;
                color: #7a9a9c;
                letter-spacing: 0.03em;
            }

                .perfil-pie i {
                    color: #12898e;
                }

            @@media (max-width: 600px) {
                .perfil-tarjeta {
                    left: 12px;
                    right: 12px;
                    width: auto;
                    bottom: 12px;
                    transform-origin: bottom center;
                }
            }

            @@media (prefers-reduced-motion: reduce) {
                .perfil-tarjeta, .perfil-fondo {
                    transition: none;
                }
            }
    </style>
</head>
<body>
    <div class="vitalia-wrapper">
        <!-- Sidebar Oscuro -->
        <aside class="vitalia-sidebar">
            <a class="sidebar-brand" asp-area="" asp-controller="@(esFamiliar ? "Familiar" : "Home")" asp-action="Index">
                <div class="brand-icon">
                    <i class="bi bi-suit-heart-fill"></i>
                </div>
                <span>VITALIA</span>
            </a>

            @if (esFamiliar)
            {
                @* El familiar solo ve su propia sección *@
                <div class="sidebar-section-label">Familia</div>
                <ul class="sidebar-nav">
                    <li>
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Familiar" ? "active" : "")"
                           asp-area="" asp-controller="Familiar" asp-action="Index">
                            <i class="bi bi-person-heart"></i> Mi familiar
                        </a>
                    </li>
                </ul>
            }
            else
            {
                <div class="sidebar-section-label">Módulos</div>
                <ul class="sidebar-nav">
                    <li>
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && string.IsNullOrEmpty(ViewContext.RouteData.Values["area"]?.ToString()) ? "active" : "")"
                           asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door-fill"></i> Inicio
                        </a>
                    </li>
                    <li>
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Residentes" ? "active" : "")"
                           asp-area="" asp-controller="Residentes" asp-action="Index">
                            <i class="bi bi-people-fill"></i> Residentes
                        </a>
                    </li>
                    <li>
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Bitacora" ? "active" : "")"
                           asp-area="" asp-controller="Bitacora" asp-action="Index">
                            <i class="bi bi-journal-text"></i> Bitácora
                        </a>
                    </li>
                    <li>
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Alertas" ? "active" : "")"
                           asp-area="" asp-controller="Alertas" asp-action="Index">
                            <i class="bi bi-bell-fill"></i> Alertas y Tareas
                        </a>
                    </li>

                    @* Módulo visible únicamente para Administrador, Médico y Enfermero *@
                    @if (puedeAccederFarmacia)
                    {
                        <li>
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Farmacia" ? "active" : "")"
                               asp-area="" asp-controller="Farmacia" asp-action="Index">
                                <i class="bi bi-capsule"></i> Farmacia y Stock
                            </a>
                        </li>
                    }

                    @if (esAdministrador)
                    {
                        <li>
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Personal" ? "active" : "")"
                               asp-area="" asp-controller="Personal" asp-action="Index">
                                <i class="bi bi-person-badge-fill"></i> Personal
                            </a>
                        </li>
                    }
                </ul>
            }

            @if (esAdministrador)
            {
                <div class="sidebar-section-label">Recursos Humanos</div>
                <ul class="sidebar-nav">
                    <li>
                        <a class="nav-link @(ViewContext.RouteData.Values["area"]?.ToString() == "RRHH" ? "active" : "")"
                           asp-area="RRHH" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-briefcase-fill"></i> Panel de RRHH
                        </a>
                    </li>
                </ul>

                <div class="sidebar-section-label">Sistema</div>
                <ul class="sidebar-nav">
                    <li>
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Usuario" || ViewContext.RouteData.Values["controller"]?.ToString() == "Roles" ? "active" : "")"
                           asp-area="" asp-controller="Usuario" asp-action="Index">
                            <i class="bi bi-shield-lock-fill"></i> Usuarios y Roles
                        </a>
                    </li>
                    <li>
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Respaldos" ? "active" : "")"
                           asp-area="" asp-controller="Respaldos" asp-action="Index">
                            <i class="bi bi-hdd-fill"></i> Respaldos
                        </a>
                    </li>
                    @if (mostrarDatosPresentacion)
                    {
                        <li>
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "DatosPresentacion" ? "active" : "")"
                               asp-controller="DatosPresentacion" asp-action="Index">
                                <i class="bi bi-database-fill-add"></i> Datos de presentación
                            </a>
                        </li>
                    }
                </ul>
            }

            @* Usuario que inició sesión *@
            <div class="sidebar-user" id="perfilCaja">
                <button type="button" class="perfil-disparador" id="perfilDisparador"
                        aria-haspopup="dialog" aria-expanded="false" aria-controls="perfilTarjeta" title="Ver mi perfil">
                    <div class="user-avatar">@iniciales</div>
                    <div class="flex-grow-1" style="min-width: 0;">
                        <div class="sidebar-user-nombre">@(nombreEsCorreo ? correoPartido(nombreUsuario) : nombreUsuario)</div>
                        <span class="sidebar-user-rol"><i class="bi bi-shield-check"></i> @rolUsuario</span>
                    </div>
                    <i class="bi bi-chevron-up perfil-chevron"></i>
                </button>
            </div>
        </aside>

        @* Tarjeta flotante del perfil *@
        <div class="perfil-fondo" id="perfilFondo" hidden></div>
        <section class="perfil-tarjeta" id="perfilTarjeta" role="dialog" aria-modal="false" aria-labelledby="perfilNombre" hidden>
            <div class="perfil-cabecera">
                <button type="button" class="perfil-cerrar" id="perfilCerrar" aria-label="Cerrar">
                    <i class="bi bi-x-lg"></i>
                </button>
                <div class="perfil-avatar">
                    @iniciales
                    <span class="perfil-en-linea" title="En línea"></span>
                </div>
                <div class="perfil-nombre" id="perfilNombre">@(nombreEsCorreo ? correoPartido(nombreUsuario) : nombreUsuario)</div>
                @if (!nombreEsCorreo && !string.IsNullOrEmpty(correoUsuario))
                {
                    <div class="perfil-correo">@correoPartido(correoUsuario)</div>
                }
                else
                {
                    <div class="perfil-correo">Correo de acceso</div>
                }
                <span class="perfil-insignia"><i class="bi bi-shield-check"></i> @rolUsuario</span>
            </div>

            <div class="perfil-cuerpo">
                @if (!string.IsNullOrEmpty(cargoPerfil))
                {
                    <div class="perfil-dato">
                        <div class="perfil-dato-icono"><i class="bi bi-briefcase-fill"></i></div>
                        <div style="min-width: 0;">
                            <div class="perfil-dato-etiqueta">Cargo</div>
                            <div class="perfil-dato-valor">@cargoPerfil</div>
                        </div>
                    </div>
                }
                @if (!nombreEsCorreo)
                {
                    <div class="perfil-dato">
                        <div class="perfil-dato-icono"><i class="bi bi-envelope-fill"></i></div>
                        <div style="min-width: 0;">
                            <div class="perfil-dato-etiqueta">Correo de acceso</div>
                            <div class="perfil-dato-valor">@correoPartido(correoUsuario)</div>
                        </div>
                    </div>
                }
                @if (esFamiliar || cargoPerfil != null)
                {
                    <div class="perfil-dato">
                        <div class="perfil-dato-icono"><i class="bi @(esFamiliar ? "bi-house-heart-fill" : "bi-people-fill")"></i></div>
                        <div style="min-width: 0;">
                            <div class="perfil-dato-etiqueta">@etiquetaResidentes</div>
                            <div class="perfil-dato-valor">@residentesPerfil</div>
                        </div>
                    </div>
                }
                <div class="perfil-dato">
                    <div class="perfil-dato-icono"><i class="bi bi-patch-check-fill"></i></div>
                    <div style="min-width: 0;">
                        <div class="perfil-dato-etiqueta">Estado de la cuenta</div>
                        <div class="perfil-dato-valor"><span class="perfil-activa">Activa</span></div>
                    </div>
                </div>

                <div class="perfil-acciones">
                    <a asp-area="" asp-controller="Perfil" asp-action="CambiarContrasena" class="perfil-accion">
                        <i class="bi bi-key-fill"></i> Cambiar contraseña <i class="bi bi-chevron-right"></i>
                    </a>
                    <button type="button" class="perfil-accion peligro" id="perfilSalir" data-bs-toggle="modal" data-bs-target="#modalCerrarSesion">
                        <i class="bi bi-box-arrow-right"></i> Cerrar sesión <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>

            <div class="perfil-pie"><i class="bi bi-heart-pulse-fill me-1"></i> VITALIA · Atención integral</div>
        </section>

        <!-- Contenido principal con animación global -->
        <main class="vitalia-content animate-fade-up">
            @RenderBody()
        </main>
    </div>

    @* Confirmación para cerrar sesión *@
    <div class="modal fade" id="modalCerrarSesion" tabindex="-1" aria-labelledby="tituloCerrarSesion" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
            <div class="modal-content border-0 rounded-4 shadow overflow-hidden">
                <div class="py-3 px-4 text-center text-white" style="background: linear-gradient(135deg, #dc3545 0%, #a71d2a 100%);">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white text-danger shadow-sm mb-2" style="width: 44px; height: 44px;">
                        <i class="bi bi-box-arrow-right fs-5"></i>
                    </div>
                    <h5 class="fw-bold mb-1" id="tituloCerrarSesion">Cerrar sesión</h5>
                    <p class="text-white small mb-0 opacity-90 fw-medium" style="font-size: 0.85rem;">¿Está seguro de que desea cerrar sesión?</p>
                </div>

                <div class="p-3">
                    <div class="p-3 rounded-3 mb-3 d-flex align-items-center gap-2" style="background-color: #fff5f5; border-left: 4px solid #dc3545;">
                        <i class="bi bi-exclamation-octagon-fill text-danger fs-6 flex-shrink-0"></i>
                        <div class="small text-danger-emphasis fw-medium" style="font-size: 0.80rem;">
                            <strong>Atención:</strong> tendrá que escribir su correo y contraseña otra vez para volver a entrar.
                        </div>
                    </div>

                    <div class="bg-light p-3 rounded-3 mb-3 border border-light-subtle">
                        <span class="text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.6px;">SESIÓN ACTUAL</span>
                        <span class="fw-bold text-dark d-block lh-base" style="overflow-wrap: anywhere;">@correoUsuario</span>
                        <small class="text-muted">@rolUsuario</small>
                    </div>

                    <form asp-area="" asp-controller="Cuenta" asp-action="Logout" method="post" class="m-0">
                        <div class="row g-2">
                            <div class="col-6">
                                <button type="button" class="btn btn-outline-secondary rounded-3 py-2 fw-semibold w-100 d-flex align-items-center justify-content-center border-2" style="font-size: 0.85rem;" data-bs-dismiss="modal">
                                    <i class="bi bi-x-circle fs-6 me-2"></i> Cancelar
                                </button>
                            </div>
                            <div class="col-6">
                                <button type="submit" class="btn btn-danger rounded-3 py-2 fw-bold shadow-sm w-100 d-flex align-items-center justify-content-center" style="background-color: #dc3545; font-size: 0.85rem;">
                                    <i class="bi bi-box-arrow-right fs-6 me-2"></i> Cerrar sesión
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            // Tarjeta del perfil: se abre al tocar el usuario del menú y se cierra con la X, Esc o tocando fuera
            (function () {
                const caja = document.getElementById("perfilCaja");
                const disparador = document.getElementById("perfilDisparador");
                const tarjeta = document.getElementById("perfilTarjeta");
                const fondo = document.getElementById("perfilFondo");
                if (!caja || !disparador || !tarjeta || !fondo) return;

                // Mientras la tarjeta está abierta la página de atrás no se mueve
                // (se reserva el ancho de la barra de desplazamiento para que nada brinque)
                function bloquearPagina(bloquear) {
                    const barra = window.innerWidth - document.documentElement.clientWidth;
                    document.body.style.overflow = bloquear ? "hidden" : "";
                    document.body.style.paddingRight = bloquear && barra > 0 ? barra + "px" : "";
                }

                function abrir() {
                    bloquearPagina(true);
                    tarjeta.hidden = false;
                    fondo.hidden = false;
                    requestAnimationFrame(() => { tarjeta.classList.add("visible"); fondo.classList.add("visible"); });
                    caja.classList.add("abierto");
                    disparador.setAttribute("aria-expanded", "true");
                    document.getElementById("perfilCerrar").focus({ preventScroll: true });
                }

                function cerrar(devolverFoco) {
                    if (tarjeta.hidden) return;
                    tarjeta.classList.remove("visible");
                    fondo.classList.remove("visible");
                    caja.classList.remove("abierto");
                    disparador.setAttribute("aria-expanded", "false");
                    bloquearPagina(false);
                    setTimeout(() => { tarjeta.hidden = true; fondo.hidden = true; }, 230);
                    if (devolverFoco) disparador.focus({ preventScroll: true });
                }

                caja.addEventListener("click", () => tarjeta.hidden ? abrir() : cerrar(true));
                fondo.addEventListener("click", () => cerrar(true));
                document.getElementById("perfilCerrar").addEventListener("click", () => cerrar(true));
                // Antes de abrir la confirmación de cerrar sesión se suelta la página,
                // así el modal guarda el estado normal y lo devuelve al cancelar
                document.getElementById("modalCerrarSesion")?.addEventListener("show.bs.modal", () => cerrar(false));
                document.addEventListener("keydown", e => { if (e.key === "Escape") cerrar(true); });
            })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>