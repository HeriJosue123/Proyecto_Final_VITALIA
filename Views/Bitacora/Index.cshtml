@model IEnumerable<VITALIA.Models.AtencionDiaria>

@{
    ViewData["Title"] = "Bitácora de Atenciones";
    var residentes = ViewBag.Residentes as List<SelectListItem> ?? new List<SelectListItem>();
    var empleados = ViewBag.Empleados as List<SelectListItem> ?? new List<SelectListItem>();
    var tiposAtencion = ViewBag.TiposAtencion as List<SelectListItem> ?? new List<SelectListItem>();

    // Paleta cromática diversificada para los badges
    string[] clasesColores = new string[]
    {
        "bg-primary-subtle text-primary border-primary-subtle",          // Azul
        "bg-success-subtle text-success border-success-subtle",          // Verde
        "bg-danger-subtle text-danger border-danger-subtle",            // Rojo
        "bg-warning-subtle text-warning-emphasis border-warning-subtle", // Amarillo / Naranja
        "bg-info-subtle text-info-emphasis border-info-subtle",          // Cyan / Azul Claro
        "bg-secondary-subtle text-secondary border-secondary-subtle",    // Gris
        "bg-dark-subtle text-dark border-dark-subtle"                    // Oscuro
    };
}

<style>
    input[type="date"]::-webkit-calendar-picker-indicator,
    input[type="date"]::-webkit-inner-spin-button {
        display: none;
        -webkit-appearance: none;
    }

    input[type="date"] {
        -moz-appearance: textfield;
        cursor: pointer;
    }

    #panelFormulario {
        transition: all 0.3s ease-in-out;
    }
</style>

<!-- Encabezado del Módulo -->
<div class="vitalia-banner d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-0">Bitácora de atenciones</h3>
        <p class="text-muted small mb-0">Historial cronológico inmutable</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <!-- Buscador Superior -->
        <form asp-controller="Bitacora" asp-action="Index" method="get" class="input-group search-box" style="width: 260px;">
            <span class="input-group-text bg-white border-end-0 rounded-start-3 text-muted">
                <i class="bi bi-search"></i>
            </span>
            <input type="text" name="busqueda" class="form-control border-start-0 rounded-end-3" placeholder="Buscar por nombre o ID..." value="@ViewBag.BusquedaActual">
            @if (ViewBag.IdTipoAtencionSeleccionado != null)
            {
                <input type="hidden" name="idTipoAtencion" value="@ViewBag.IdTipoAtencionSeleccionado" />
            }
            @if (ViewBag.IdResidenteSeleccionado != null)
            {
                <input type="hidden" name="idResidente" value="@ViewBag.IdResidenteSeleccionado" />
            }
        </form>

        <!-- Botón a Módulo Independiente de Tipos de Atención -->
        <a asp-controller="TipoAtencion" asp-action="Index" class="btn btn-outline-secondary text-nowrap" title="Gestionar tipos de atención">
            <i class="bi bi-gear-fill me-1"></i> Tipos
        </a>

        <!-- Botón + Nueva atención -->
        <button type="button" class="btn btn-vitalia text-nowrap" onclick="prepararNuevoRegistro()" @(residentes.Any() && empleados.Any() ? "" : "disabled") title="@(!residentes.Any() ? "Registre un residente primero" : !empleados.Any() ? "Registre personal primero" : "")">
            + Nueva atención
        </button>
    </div>
</div>

<div class="row g-4">
    <!-- Columna del Historial de Atenciones -->
    <div id="columnaHistorial" class="col-12">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <!-- Barra de Filtros -->
            <form asp-controller="Bitacora" asp-action="Index" method="get" class="row g-2 mb-3 align-items-center">
                <input type="hidden" name="busqueda" value="@ViewBag.BusquedaActual" />

                <div class="col-md-3">
                    <select name="idResidente" class="form-select form-select-sm rounded-3 border-light-subtle">
                        <option value="">Todos los residentes</option>
                        @foreach (var res in residentes)
                        {
                            <option value="@res.Value" selected="@(ViewBag.IdResidenteSeleccionado?.ToString() == res.Value)">@res.Text</option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <div class="input-group input-group-sm border rounded-3 bg-white px-2 align-items-center">
                        <span class="text-muted pe-1 style-pointer" onclick="document.getElementById('fechaInicioInput').showPicker()" style="cursor: pointer;">
                            📅
                        </span>
                        <input type="date" id="fechaInicioInput" name="fechaInicio" class="form-control border-0 text-center p-0 bg-transparent" value="@ViewBag.FechaInicio" style="font-size: 0.8rem;" onclick="this.showPicker()" title="Fecha Inicio" />
                        <span class="text-muted px-1" style="font-size: 0.8rem;">
                            ➔
                        </span>
                        <input type="date" id="fechaFinInput" name="fechaFin" class="form-control border-0 text-center p-0 bg-transparent" value="@ViewBag.FechaFin" style="font-size: 0.8rem;" onclick="this.showPicker()" title="Fecha Fin" />
                    </div>
                </div>

                <div class="col-md-3">
                    <select name="idTipoAtencion" class="form-select form-select-sm rounded-3 border-light-subtle">
                        <option value="">Tipo: Todos</option>
                        @foreach (var tipo in tiposAtencion)
                        {
                            <option value="@tipo.Value" selected="@(ViewBag.IdTipoAtencionSeleccionado?.ToString() == tipo.Value)">@tipo.Text</option>
                        }
                    </select>
                </div>

                <div class="col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-vitalia btn-sm flex-fill">Filtrar</button>
                    <button type="button" class="btn btn-outline-vitalia btn-sm flex-fill" title="Exportar PDF">
                        <i class="bi bi-file-earmark-pdf-fill"></i>
                    </button>
                </div>
            </form>

            <p class="text-muted small mb-4" style="font-size: 0.78rem;">
                Historial de solo anexo: no se puede editar ni eliminar (RF-011)
            </p>

            <!-- Lista de Atenciones -->
            <div class="d-flex flex-column gap-3">
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var tipoMatch = tiposAtencion.FirstOrDefault(t => t.Value == item.IdTipoAtencion.ToString());
                        string tipoTexto = tipoMatch != null ? tipoMatch.Text : "Atención General";

                        // Asignación de color consistente mediante el ID único del tipo de atención
                        int indiceColor = Math.Abs(item.IdTipoAtencion.GetHashCode()) % clasesColores.Length;
                        string badgeClass = clasesColores[indiceColor];

                        string empleadoNombre = item.IdEmpleadoNavigation != null
                            ? $"{item.IdEmpleadoNavigation.Nombre} {item.IdEmpleadoNavigation.Apellido}"
                            : "Empleado";

                        <div class="border-bottom pb-3">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <div>
                                    <span class="fw-bold text-dark me-2">@item.FechaHora.ToString("HH:mm")</span>
                                    <small class="text-muted me-2">@item.FechaHora.ToString("dd/MM/yyyy")</small>
                                    <span class="badge border ms-1 @badgeClass">
                                        @tipoTexto
                                    </span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <small class="text-muted" style="font-size: 0.72rem;">
                                        <i class="bi bi-lock-fill"></i> sello del servidor
                                    </small>

                                    <!-- Botón Editar -->
                                    <button type="button" class="btn btn-link text-primary p-0 border-0 ms-2" title="Editar registro"
                                            onclick="prepararEdicion(@item.IdAtencion, @item.IdResidente, @item.IdEmpleado, @item.IdTipoAtencion, '@item.Observaciones.Replace("'", "\\'").Replace("\r\n", " ").Replace("\n", " ")')">
                                        <i class="bi bi-pencil-square fs-6"></i>
                                    </button>

                                    <!-- Botón Eliminar con Modal -->
                                    <button type="button" class="btn btn-link text-danger p-0 border-0 ms-1" title="Eliminar registro"
                                            onclick="prepararEliminacion(@item.IdAtencion)">
                                        <i class="bi bi-trash-fill fs-6"></i>
                                    </button>
                                </div>
                            </div>
                            <p class="mb-1 text-dark small fw-semibold">@item.Observaciones</p>
                            <small class="text-muted d-block" style="font-size: 0.75rem;">
                                Registrado por @empleadoNombre · @(string.IsNullOrEmpty(item.EstadoCumplimiento) ? "Completado" : item.EstadoCumplimiento)
                            </small>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                        <p class="small mb-0">No se encontraron atenciones registradas.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Panel Lateral: Formulario Registrar / Editar Atención -->
    <div id="panelFormulario" class="col-lg-4 d-none">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 id="tituloPanel" class="fw-bold text-dark mb-0">Registrar atención</h6>
                <button type="button" class="btn-close small" onclick="cerrarFormularioAtencion()" aria-label="Cerrar"></button>
            </div>

            <form id="formAtencion" asp-controller="Bitacora" asp-action="Registrar" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" id="inputAtencionId" name="id_atencion" value="0" />

                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold uppercase" style="font-size: 0.68rem;">RESIDENTE *</label>
                    @if (residentes.Any())
                    {
                        <select id="selectResidente" name="id_residente" class="form-select form-select-sm" required>
                            @foreach (var res in residentes)
                            {
                                <option value="@res.Value">@res.Text</option>
                            }
                        </select>
                    }
                    else
                    {
                        <input type="text" class="form-control form-control-sm bg-light text-danger" value="Sin residentes registrados" readonly />
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold uppercase mb-1" style="font-size: 0.68rem;">TIPO DE ATENCIÓN *</label>
                    @if (tiposAtencion.Any())
                    {
                        <select id="selectTipoAtencion" name="id_tipo_atencion" class="form-select form-select-sm" required>
                            @foreach (var tipo in tiposAtencion)
                            {
                                <option value="@tipo.Value">@tipo.Text</option>
                            }
                        </select>
                    }
                    else
                    {
                        <select id="selectTipoAtencion" name="id_tipo_atencion" class="form-select form-select-sm border-danger text-danger" disabled>
                            <option value="">-- No hay tipos de atención registrados --</option>
                        </select>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold uppercase" style="font-size: 0.68rem;">DESCRIPCIÓN / OBSERVACIÓN *</label>
                    <textarea id="txtObservaciones" name="observaciones" class="form-control form-control-sm" rows="3" placeholder="Escribe lo realizado..." required></textarea>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label text-muted small fw-bold uppercase" style="font-size: 0.68rem;">FECHA Y HORA</label>
                        <input type="text" class="form-control form-control-sm bg-light" value="Automática 🔒" readonly />
                    </div>
                    <div class="col-6">
                        <label class="form-label text-muted small fw-bold uppercase" style="font-size: 0.68rem;">EMPLEADO *</label>
                        @if (empleados.Any())
                        {
                            <select id="selectEmpleado" name="id_empleado" class="form-select form-select-sm" required>
                                @foreach (var emp in empleados)
                                {
                                    <option value="@emp.Value">@emp.Text</option>
                                }
                            </select>
                        }
                        else
                        {
                            <input type="text" class="form-control form-control-sm bg-light text-danger" value="Sin personal registrado" readonly />
                        }
                    </div>
                </div>

                <button type="submit" id="btnGuardarAtencion" class="btn btn-vitalia w-100 mb-2" @(residentes.Any() && empleados.Any() && tiposAtencion.Any() ? "" : "disabled")>Guardar atención</button>
                <p class="text-center text-muted" style="font-size: 0.72rem;">Se registra en 4 clics o menos desde el panel del cuidador (RNF-004).</p>
            </form>
        </div>

        <div class="alert alert-danger border-danger-subtle rounded-4 p-3 mb-0 small" style="font-size: 0.75rem;">
            <i class="bi bi-exclamation-triangle-fill me-1"></i> <strong>Al intentar editar o borrar:</strong> "No se permite sobrescribir o alterar registros históricos".
        </div>
    </div>
</div>

<!-- Modal Confirmar Eliminación -->
<div class="modal fade" id="modalEliminarAtencion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-body text-center p-4">
                <div class="text-danger mb-3">
                    <i class="bi bi-exclamation-circle fs-1"></i>
                </div>
                <h6 class="fw-bold text-dark mb-2">¿Eliminar esta atención?</h6>
                <p class="text-muted small mb-4">Esta acción no se podrá deshacer.</p>

                <form id="formEliminarAtencion" asp-controller="Bitacora" asp-action="Eliminar" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="inputEliminarId" name="id" value="0" />

                    <div class="d-flex gap-2 justify-content-center">
                        <button type="button" class="btn btn-light rounded-3 btn-sm flex-fill" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-danger rounded-3 btn-sm flex-fill">Eliminar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function abrirPanel() {
        const columnaHistorial = document.getElementById('columnaHistorial');
        const panelFormulario = document.getElementById('panelFormulario');

        panelFormulario.classList.remove('d-none');
        columnaHistorial.classList.remove('col-12');
        columnaHistorial.classList.add('col-lg-8');
    }

    function cerrarFormularioAtencion() {
        const columnaHistorial = document.getElementById('columnaHistorial');
        const panelFormulario = document.getElementById('panelFormulario');

        panelFormulario.classList.add('d-none');
        columnaHistorial.classList.remove('col-lg-8');
        columnaHistorial.classList.add('col-12');
    }

    function prepararNuevoRegistro() {
        abrirPanel();

        document.getElementById('formAtencion').action = '/Bitacora/Registrar';
        document.getElementById('tituloPanel').innerText = 'Registrar atención';
        document.getElementById('btnGuardarAtencion').innerText = 'Guardar atención';

        document.getElementById('inputAtencionId').value = '0';
        document.getElementById('txtObservaciones').value = '';

        const selectTipoAtencion = document.getElementById('selectTipoAtencion');
        if (selectTipoAtencion && selectTipoAtencion.options.length > 0) {
            selectTipoAtencion.selectedIndex = 0;
        }

        const selectResidente = document.getElementById('selectResidente');
        if (selectResidente) {
            selectResidente.disabled = false;
        }

        const selectEmpleado = document.getElementById('selectEmpleado');
        if (selectEmpleado) {
            selectEmpleado.disabled = false;
        }

        document.getElementById('txtObservaciones').focus();
    }

    function prepararEdicion(id, idResidente, idEmpleado, idTipo, observaciones) {
        abrirPanel();

        document.getElementById('formAtencion').action = '/Bitacora/Editar';
        document.getElementById('tituloPanel').innerText = 'Editar atención';
        document.getElementById('btnGuardarAtencion').innerText = 'Actualizar atención';

        document.getElementById('inputAtencionId').value = id;

        const selectResidente = document.getElementById('selectResidente');
        if (selectResidente) {
            selectResidente.value = idResidente;
            selectResidente.disabled = true;
        }

        const selectEmpleado = document.getElementById('selectEmpleado');
        if (selectEmpleado) {
            selectEmpleado.value = idEmpleado;
            selectEmpleado.disabled = true;
        }

        const selectTipoAtencion = document.getElementById('selectTipoAtencion');
        if (selectTipoAtencion) {
            selectTipoAtencion.value = idTipo;
        }

        document.getElementById('txtObservaciones').value = observaciones;
        document.getElementById('txtObservaciones').focus();
    }

    function prepararEliminacion(id) {
        document.getElementById('inputEliminarId').value = id;
        var modal = new bootstrap.Modal(document.getElementById('modalEliminarAtencion'));
        modal.show();
    }
</script>