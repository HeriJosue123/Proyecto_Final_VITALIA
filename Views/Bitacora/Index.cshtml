@model IEnumerable<VITALIA.Models.AtencionDiarium>

@{
    ViewData["Title"] = "Bitácora de Atenciones";
}

<!-- Estilos para ocultar íconos nativos de fecha y transiciones dinámicas -->
<style>
    input[type="date"]::-webkit-calendar-picker-indicator,
    input[type="date"]::-webkit-inner-spin-button {
        display: none;
        -webkit-appearance: none;
    }

    input[type="date"] {
        -moz-appearance: textfield;
        cursor: pointer;
    }

    /* Animación suave para el panel desplegable lateral */
    #panelFormulario {
        transition: all 0.3s ease-in-out;
    }
</style>

<!-- Encabezado del Módulo -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-0">Bitácora de atenciones</h3>
        <p class="text-muted small mb-0">Historial cronológico inmutable</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <!-- Buscador Superior -->
        <form asp-controller="Bitacora" asp-action="Index" method="get" class="input-group search-box" style="width: 260px;">
            <span class="input-group-text bg-white border-end-0 rounded-start-3 text-muted">
                <i class="bi bi-search"></i>
            </span>
            <input type="text" name="busqueda" class="form-control border-start-0 rounded-end-3" placeholder="Buscar por nombre o ID..." value="@ViewBag.BusquedaActual">
            @if (ViewBag.IdTipoAtencionSeleccionado != null)
            {
                <input type="hidden" name="idTipoAtencion" value="@ViewBag.IdTipoAtencionSeleccionado" />
            }
        </form>

        <!-- Botón + Nueva atención que despliega/oculta el formulario lateral -->
        <button type="button" class="btn btn-vitalia text-nowrap" onclick="prepararNuevoRegistro()">
            + Nueva atención
        </button>
    </div>
</div>

<div class="row g-4">
    <!-- Columna del Historial de Atenciones (Se expande o contrae dinámicamente) -->
    <div id="columnaHistorial" class="col-12">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <!-- Barra de Filtros -->
            <form asp-controller="Bitacora" asp-action="Index" method="get" class="row g-2 mb-3 align-items-center">
                <input type="hidden" name="busqueda" value="@ViewBag.BusquedaActual" />

                <div class="col-md-3">
                    <select name="idResidente" class="form-select form-select-sm rounded-3 border-light-subtle">
                        <option value="">Residente: Marta E. Gómez</option>
                        <option value="">Todos los residentes</option>
                    </select>
                </div>

                <!-- Campo Unificado de Fechas -->
                <div class="col-md-4">
                    <div class="input-group input-group-sm border rounded-3 bg-white px-2 align-items-center">
                        <span class="text-muted pe-1 style-pointer" onclick="document.getElementById('fechaInicioInput').showPicker()" style="cursor: pointer;">
                            📅
                        </span>
                        <input type="date" id="fechaInicioInput" name="fechaInicio" class="form-control border-0 text-center p-0 bg-transparent" value="@ViewBag.FechaInicio" style="font-size: 0.8rem;" onclick="this.showPicker()" title="Fecha Inicio" />
                        <span class="text-muted px-1" style="font-size: 0.8rem;">
                            ➔
                        </span>
                        <input type="date" id="fechaFinInput" name="fechaFin" class="form-control border-0 text-center p-0 bg-transparent" value="@ViewBag.FechaFin" style="font-size: 0.8rem;" onclick="this.showPicker()" title="Fecha Fin" />
                    </div>
                </div>

                <div class="col-md-3">
                    <select name="idTipoAtencion" class="form-select form-select-sm rounded-3 border-light-subtle">
                        <option value="">Tipo: Todos</option>
                        <option value="1" selected="@(ViewBag.IdTipoAtencionSeleccionado == 1)">Medicación</option>
                        <option value="2" selected="@(ViewBag.IdTipoAtencionSeleccionado == 2)">Signos Vitales</option>
                        <option value="3" selected="@(ViewBag.IdTipoAtencionSeleccionado == 3)">Alimentación</option>
                        <option value="4" selected="@(ViewBag.IdTipoAtencionSeleccionado == 4)">Actividad Recreativa</option>
                        <option value="5" selected="@(ViewBag.IdTipoAtencionSeleccionado == 5)">Movilidad</option>
                    </select>
                </div>

                <div class="col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-vitalia btn-sm flex-fill">Filtrar</button>
                    <button type="button" class="btn btn-outline-vitalia btn-sm flex-fill" title="Exportar PDF">
                        <i class="bi bi-file-earmark-pdf-fill"></i>
                    </button>
                </div>
            </form>

            <p class="text-muted small mb-4" style="font-size: 0.78rem;">
                Historial de solo anexo: no se puede editar ni eliminar (RF-011)
            </p>

            <!-- Lista / Línea de Tiempo Dinámica de Atenciones -->
            <div class="d-flex flex-column gap-3">
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        string badgeClass = "bg-primary-subtle text-primary border-primary-subtle";
                        string tipoTexto = "Medicación";

                        switch (item.IdTipoAtencion)
                        {
                            case 1:
                                badgeClass = "bg-primary-subtle text-primary border-primary-subtle";
                                tipoTexto = "Medicación";
                                break;
                            case 2:
                                badgeClass = "bg-danger-subtle text-danger border-danger-subtle";
                                tipoTexto = "Toma de Signos Vitales";
                                break;
                            case 3:
                                badgeClass = "bg-success-subtle text-success border-success-subtle";
                                tipoTexto = "Alimentación";
                                break;
                            case 4:
                                badgeClass = "bg-warning-subtle text-warning-emphasis border-warning-subtle";
                                tipoTexto = "Actividad Recreativa";
                                break;
                            case 5:
                                badgeClass = "bg-info-subtle text-info-emphasis border-info-subtle";
                                tipoTexto = "Movilidad y Fisioterapia";
                                break;
                        }
                        <div class="border-bottom pb-3">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <div>
                                    <span class="fw-bold text-dark me-2">@item.FechaHora.ToString("HH:mm")</span>
                                    <small class="text-muted me-2">@item.FechaHora.ToString("dd/MM/yyyy")</small>
                                    <span class="badge border ms-1 @badgeClass">
                                        @tipoTexto
                                    </span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <small class="text-muted" style="font-size: 0.72rem;">
                                        <i class="bi bi-lock-fill"></i> sello del servidor
                                    </small>

                                    <!-- BOTÓN DE EDITAR AGREGADO AQUÍ -->
                                    <button type="button" class="btn btn-link text-primary p-0 border-0 ms-2" title="Editar registro"
                                            onclick="prepararEdicion(@item.IdAtencion, @item.IdTipoAtencion, '@item.Observaciones.Replace("'", "\\'").Replace("\r\n", " ").Replace("\n", " ")')">
                                        <i class="bi bi-pencil-square fs-6"></i>
                                    </button>

                                    <!-- Botón de Eliminar (Admin) -->
                                    <form asp-controller="Bitacora" asp-action="Eliminar" method="post" onsubmit="return confirm('¿Estás seguro de que deseas eliminar este registro de la bitácora?');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.IdAtencion" />
                                        <button type="submit" class="btn btn-link text-danger p-0 border-0 ms-1" title="Eliminar registro">
                                            <i class="bi bi-trash-fill fs-6"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                            <p class="mb-1 text-dark small fw-semibold">@item.Observaciones</p>
                            <small class="text-muted d-block" style="font-size: 0.75rem;">
                                Registrado por Lucía Pérez · @(string.IsNullOrEmpty(item.EstadoCumplimiento) ? "Completado" : item.EstadoCumplimiento)
                            </small>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                        <p class="small mb-0">No se encontraron atenciones registradas.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Panel Lateral: Formulario Registrar / Editar Atención -->
    <div id="panelFormulario" class="col-lg-4 d-none">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 id="tituloPanel" class="fw-bold text-dark mb-0">Registrar atención</h6>
                <button type="button" class="btn-close small" onclick="cerrarFormularioAtencion()" aria-label="Cerrar"></button>
            </div>

            <form id="formAtencion" asp-controller="Bitacora" asp-action="Registrar" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" id="inputAtencionId" name="id_atencion" value="0" />
                <input type="hidden" name="id_residente" value="1" />

                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold uppercase" style="font-size: 0.68rem;">RESIDENTE (asignado)</label>
                    <input type="text" class="form-control form-control-sm bg-light" value="Marta Elena Gómez · RES-2026-001" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold uppercase" style="font-size: 0.68rem;">TIPO DE ATENCIÓN *</label>
                    <select id="selectTipoAtencion" name="id_tipo_atencion" class="form-select form-select-sm" required>
                        <option value="1">Medicación</option>
                        <option value="2">Toma de Signos Vitales</option>
                        <option value="3">Alimentación</option>
                        <option value="4">Actividad Recreativa</option>
                        <option value="5">Movilidad y Fisioterapia</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold uppercase" style="font-size: 0.68rem;">DESCRIPCIÓN / OBSERVACIÓN *</label>
                    <textarea id="txtObservaciones" name="observaciones" class="form-control form-control-sm" rows="3" placeholder="Escribe lo realizado..." required></textarea>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label text-muted small fw-bold uppercase" style="font-size: 0.68rem;">FECHA Y HORA</label>
                        <input type="text" class="form-control form-control-sm bg-light" value="Automática 🔒" readonly />
                    </div>
                    <div class="col-6">
                        <label class="form-label text-muted small fw-bold uppercase" style="font-size: 0.68rem;">EMPLEADO</label>
                        <input type="text" class="form-control form-control-sm bg-light" value="Lucía Pérez 🔒" readonly />
                    </div>
                </div>

                <button type="submit" id="btnGuardarAtencion" class="btn btn-vitalia w-100 mb-2">Guardar atención</button>
                <p class="text-center text-muted" style="font-size: 0.72rem;">Se registra en 4 clics o menos desde el panel del cuidador (RNF-004).</p>
            </form>
        </div>

        <!-- Alerta de Inmutabilidad -->
        <div class="alert alert-danger border-danger-subtle rounded-4 p-3 mb-0 small" style="font-size: 0.75rem;">
            <i class="bi bi-exclamation-triangle-fill me-1"></i> <strong>Al intentar editar o borrar:</strong> "No se permite sobrescribir o alterar registros históricos".
        </div>
    </div>
</div>

<!-- JavaScript para alternar el panel y cargar datos de edición -->
<script>
    function abrirPanel() {
        const columnaHistorial = document.getElementById('columnaHistorial');
        const panelFormulario = document.getElementById('panelFormulario');

        panelFormulario.classList.remove('d-none');
        columnaHistorial.classList.remove('col-12');
        columnaHistorial.classList.add('col-lg-8');
    }

    function cerrarFormularioAtencion() {
        const columnaHistorial = document.getElementById('columnaHistorial');
        const panelFormulario = document.getElementById('panelFormulario');

        panelFormulario.classList.add('d-none');
        columnaHistorial.classList.remove('col-lg-8');
        columnaHistorial.classList.add('col-12');
    }

    function prepararNuevoRegistro() {
        abrirPanel();

        // Configurar formulario para inserción
        document.getElementById('formAtencion').action = '/Bitacora/Registrar';
        document.getElementById('tituloPanel').innerText = 'Registrar atención';
        document.getElementById('btnGuardarAtencion').innerText = 'Guardar atención';

        document.getElementById('inputAtencionId').value = '0';
        document.getElementById('txtObservaciones').value = '';
        document.getElementById('selectTipoAtencion').value = '1';
        document.getElementById('txtObservaciones').focus();
    }

    function prepararEdicion(id, idTipo, observaciones) {
        abrirPanel();

        // Configurar formulario para edición
        document.getElementById('formAtencion').action = '/Bitacora/Editar';
        document.getElementById('tituloPanel').innerText = 'Editar atención';
        document.getElementById('btnGuardarAtencion').innerText = 'Actualizar atención';

        // Llenar campos con los valores del registro
        document.getElementById('inputAtencionId').value = id;
        document.getElementById('selectTipoAtencion').value = idTipo;
        document.getElementById('txtObservaciones').value = observaciones;
        document.getElementById('txtObservaciones').focus();
    }
</script>