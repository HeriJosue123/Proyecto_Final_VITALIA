@model IEnumerable<VITALIA.Models.Rrhh.PersonalExterno>

@{
    ViewData["Title"] = "Personal Externo y Contratistas";
}

<!-- BANNER SUPERIOR ALINEADO -->
<div class="vitalia-banner mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-tools me-2"></i>Personal Externo y Servicios</h2>
        <p class="text-white opacity-75 mb-0">Control de cocineros, mantenimiento, seguridad y servicios contratados.</p>
    </div>

    <div class="d-flex gap-2 align-items-stretch">
        <a asp-area="RRHH" asp-controller="Dashboard" asp-action="Index" class="btn btn-light btn-sm d-flex align-items-center text-teal fw-semibold">
            Volver al Panel
        </a>
        <a asp-area="RRHH" asp-controller="PersonalExterno" asp-action="Crear" class="btn btn-outline-light btn-sm d-flex align-items-center fw-semibold">
            <i class="bi bi-plus-lg me-1"></i>Nuevo Registro
        </a>
    </div>
</div>

<div class="vitalia-card-pro p-4 shadow-sm border-0" style="border-radius: 12px;">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nombre / Contratista</th>
                    <th>Área / Servicio</th>
                    <th>Proveedor / Empresa</th>
                    <th>Horario / Turno</th>
                    <th>Monto Acordado</th>
                    <th>Estado de Pago</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No hay personal externo registrado.</td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-bold text-dark">@item.Nombre @item.Apellido</div>
                            <small class="text-muted"><i class="bi bi-card-heading me-1"></i>@item.DocumentoIdentidad | @(item.Telefono ?? "Sin tel.")</small>
                        </td>
                        <td>
                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2 py-1">
                                @item.AreaServicio
                            </span>
                        </td>
                        <td>@item.EmpresaProveedora</td>
                        <td><small class="text-muted">@(item.HorarioTurno ?? "No especificado")</small></td>
                        <td class="fw-bold text-dark">
                            @(item.MontoServicio.HasValue ? $"${item.MontoServicio.Value:N2}" : "-")
                        </td>
                        <td>
                            @if (item.EstadoPago == "Pagado")
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                    <i class="bi bi-check-circle-fill me-1"></i>Pagado
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                    <i class="bi bi-clock-history me-1"></i>Pendiente
                                </span>
                            }
                        </td>
                        <td class="pe-4 text-end">
                            <!-- COLUMNA DE ACCIONES ALINEADA CON ANCHOS FIJOS -->
                            <div class="d-flex gap-2 justify-content-end align-items-center">

                                <!-- Botón Cambiar Estado -->
                                <form asp-area="RRHH" asp-controller="PersonalExterno" asp-action="CambiarEstadoPago" method="post" class="m-0">
                                    <input type="hidden" name="id" value="@item.IdPersonalExterno" />
                                    @if (item.EstadoPago == "Pendiente")
                                    {
                                        <button type="submit" name="estado" value="Pagado" class="btn btn-sm btn-outline-success text-center" style="width: 105px;" title="Marcar como Pagado">
                                            <i class="bi bi-cash-stack me-1"></i>Pagado
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" name="estado" value="Pendiente" class="btn btn-sm btn-outline-warning text-center" style="width: 105px;" title="Marcar como Pendiente">
                                            <i class="bi bi-arrow-counterclockwise me-1"></i>Pendiente
                                        </button>
                                    }
                                </form>

                                <!-- Botón PDF -->
                                <a asp-area="RRHH" asp-controller="PersonalExterno" asp-action="DescargarComprobantePdf" asp-route-id="@item.IdPersonalExterno" target="_blank" class="btn btn-sm btn-outline-primary d-flex justify-content-center align-items-center" style="width: 36px; height: 31px;" title="Descargar Comprobante">
                                    <i class="bi bi-file-earmark-pdf"></i>
                                </a>

                                <!-- Botón Eliminar -->
                                <form asp-area="RRHH" asp-controller="PersonalExterno" asp-action="Eliminar" method="post" class="m-0">
                                    <input type="hidden" name="id" value="@item.IdPersonalExterno" />
                                    <button type="button" class="btn btn-sm btn-outline-danger btn-eliminar-externo d-flex justify-content-center align-items-center" style="width: 36px; height: 31px;" data-nombre="@item.Nombre @item.Apellido" title="Eliminar registro">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".btn-eliminar-externo").forEach(button => {
                button.addEventListener("click", function () {
                    const form = this.closest("form");
                    const nombre = this.getAttribute("data-nombre");

                    Swal.fire({
                        title: '¿Dar de baja registro?',
                        html: `¿Está seguro de dar de baja a <strong>${nombre}</strong>?<br><small class="text-muted">El registro ya no aparecerá en la lista activa.</small>`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#dc3545',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: '<i class="bi bi-trash me-1"></i> Sí, dar de baja',
                        cancelButtonText: 'Cancelar',
                        reverseButtons: true,
                        customClass: {
                            popup: 'rounded-4 shadow',
                            confirmButton: 'btn btn-danger px-4 mx-1',
                            cancelButton: 'btn btn-secondary px-4 mx-1'
                        },
                        buttonsStyling: false
                    }).then((result) => {
                        if (result.isConfirmed) {
                            form.submit();
                        }
                    });
                });
            });
        });
    </script>
}