@model IEnumerable<VITALIA.Models.Rrhh.PersonalExterno>

@{
    ViewData["Title"] = "Personal Externo y Contratistas";
}

<div class="vitalia-banner mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-tools me-2"></i>Personal Externo y Servicios</h2>
        <p class="text-muted mb-0">Control de cocineros, mantenimiento, seguridad y servicios contratados.</p>
    </div>
    <div>
        <a asp-area="RRHH" asp-controller="Dashboard" asp-action="Index" class="btn btn-light btn-sm me-2">Volver al Panel</a>
        <a asp-area="RRHH" asp-controller="PersonalExterno" asp-action="Crear" class="btn btn-vitalia btn-sm"><i class="bi bi-plus-lg me-1"></i>Nuevo Registro</a>
    </div>
</div>

<div class="vitalia-card-pro p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Nombre / Contratista</th>
                    <th>Área / Servicio</th>
                    <th>Proveedor / Empresa</th>
                    <th>Horario / Turno</th>
                    <th>Monto Acordado</th>
                    <th>Estado de Pago</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No hay personal externo registrado.</td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-bold text-dark">@item.Nombre @item.Apellido</div>
                            <small class="text-muted"><i class="bi bi-card-heading me-1"></i>@item.DocumentoIdentidad | @(item.Telefono ?? "Sin tel.")</small>
                        </td>
                        <td>
                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                @item.AreaServicio
                            </span>
                        </td>
                        <td>@item.EmpresaProveedora</td>
                        <td><small class="text-muted">@(item.HorarioTurno ?? "No especificado")</small></td>
                        <td class="fw-bold text-dark">
                            @(item.MontoServicio.HasValue ? $"${item.MontoServicio.Value:N2}" : "-")
                        </td>
                        <td>
                            @if (item.EstadoPago == "Pagado")
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-circle-fill me-1"></i>Pagado</span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle"><i class="bi bi-clock-history me-1"></i>Pendiente</span>
                            }
                        </td>
                        <td class="text-end">
                            <form asp-area="RRHH" asp-controller="PersonalExterno" asp-action="CambiarEstadoPago" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@item.IdPersonalExterno" />
                                @if (item.EstadoPago == "Pendiente")
                                {
                                    <button type="submit" name="estado" value="Pagado" class="btn btn-sm btn-outline-success" title="Marcar como Pagado">
                                        <i class="bi bi-cash-stack me-1"></i>Marcar Pagado
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" name="estado" value="Pendiente" class="btn btn-sm btn-outline-warning" title="Marcar como Pendiente">
                                        <i class="bi bi-arrow-counterclockwise me-1"></i>Marcar Pendiente
                                    </button>
                                }
                            </form>
                            
                            <form asp-area="RRHH" asp-controller="PersonalExterno" asp-action="Eliminar" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@item.IdPersonalExterno" />
                                <button type="button" class="btn btn-sm btn-outline-danger btn-eliminar-externo" data-nombre="@item.Nombre @item.Apellido">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".btn-eliminar-externo").forEach(button => {
                button.addEventListener("click", function () {
                    const form = this.closest("form");
                    const nombre = this.getAttribute("data-nombre");

                    Swal.fire({
                        title: '¿Dar de baja registro?',
                        html: `¿Está seguro de dar de baja a <strong>${nombre}</strong>?<br><small class="text-muted">El registro ya no aparecerá en la lista activa.</small>`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#dc3545',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: '<i class="bi bi-trash me-1"></i> Sí, dar de baja',
                        cancelButtonText: 'Cancelar',
                        reverseButtons: true,
                        customClass: {
                            popup: 'rounded-4 shadow',
                            confirmButton: 'btn btn-danger px-4 mx-1',
                            cancelButton: 'btn btn-secondary px-4 mx-1'
                        },
                        buttonsStyling: false
                    }).then((result) => {
                        if (result.isConfirmed) {
                            form.submit();
                        }
                    });
                });
            });
        });
    </script>
}