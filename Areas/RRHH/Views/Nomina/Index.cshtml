@model IEnumerable<VITALIA.Models.Rrhh.Nomina>

@{
    ViewData["Title"] = "Gestión de Nóminas";
}

<div class="vitalia-banner mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-cash-coin me-2"></i>Control de Nóminas y Salarios</h2>
        <p class="text-muted mb-0">Registro kardex de salarios y emisión de recibos oficiales en PDF.</p>
    </div>
    <div>
        <a asp-area="RRHH" asp-controller="Dashboard" asp-action="Index" class="btn btn-light btn-sm me-2">Volver al Panel</a>
        <a asp-area="RRHH" asp-controller="Nomina" asp-action="Crear" class="btn btn-vitalia btn-sm"><i class="bi bi-plus-lg me-1"></i>Registrar Pago</a>
    </div>
</div>

<div class="vitalia-card-pro p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Empleado</th>
                    <th>Período (Mes/Año)</th>
                    <th>Salario Bruto</th>
                    <th>Deducciones</th>
                    <th>Salario Neto</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No hay registros de nómina.</td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-dark">
                            @item.IdEmpleadoNavigation?.Nombre @item.IdEmpleadoNavigation?.Apellido
                            <small class="d-block text-muted">@item.IdEmpleadoNavigation?.Cargo</small>
                        </td>
                        <td><span class="badge bg-light text-dark border">@item.Mes / @item.Anio</span></td>
                        <td>$@item.SalarioBruto.ToString("N2")</td>
                        <td class="text-danger">-$@item.Deducciones.ToString("N2")</td>
                        <td class="fw-bold text-success">$@item.SalarioNeto.ToString("N2")</td>
                        <td>
                            @if (item.Estado == "Pagado")
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-circle-fill me-1"></i>Pagado</span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle"><i class="bi bi-clock-history me-1"></i>Pendiente</span>
                            }
                        </td>
                        <td class="text-end">
                            <form asp-area="RRHH" asp-controller="Nomina" asp-action="CambiarEstado" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@item.IdNomina" />
                                @if (item.Estado == "Pendiente")
                                {
                                    <button type="submit" name="estado" value="Pagado" class="btn btn-sm btn-outline-success me-1" title="Marcar como Pagado">
                                        <i class="bi bi-check-lg"></i> Pagado
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" name="estado" value="Pendiente" class="btn btn-sm btn-outline-warning me-1" title="Marcar como Pendiente">
                                        <i class="bi bi-arrow-counterclockwise"></i> Pendiente
                                    </button>
                                }
                            </form>
                            <a asp-area="RRHH" asp-controller="Nomina" asp-action="DescargarReciboPdf" asp-route-id="@item.IdNomina" target="_blank" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-file-earmark-pdf-fill me-1"></i>PDF
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>