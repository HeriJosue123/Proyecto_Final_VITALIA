@model VITALIA.Models.Rrhh.Nomina

@{
    ViewData["Title"] = "Registrar Nómina";
}

<div class="vitalia-banner mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-cash-stack me-2"></i>Nuevo Registro de Nómina</h2>
        <p class="text-muted mb-0">Ingrese los valores salariales correspondientes al empleado.</p>
    </div>
    <a asp-area="RRHH" asp-controller="Nomina" asp-action="Index" class="btn btn-light btn-sm">Cancelar</a>
</div>

<div class="vitalia-card-pro p-4" style="max-width: 800px; margin: 0 auto;">
    <form asp-area="RRHH" asp-controller="Nomina" asp-action="Crear" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

        <div class="row g-3">
            <div class="col-md-12">
                <label class="form-label fw-semibold">Empleado</label>
                <select asp-for="IdEmpleado" asp-items="ViewBag.Empleados" class="form-select" required>
                    <option value="">-- Seleccione Empleado --</option>
                </select>
                <span asp-validation-for="IdEmpleado" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">Mes de Nómina</label>
                <select asp-for="Mes" class="form-select" required>
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == DateTime.Now.Month)">@System.Globalization.DateTimeFormatInfo.CurrentInfo.GetMonthName(m).ToUpper()</option>
                    }
                </select>
                <span asp-validation-for="Mes" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">Año</label>
                <input asp-for="Anio" type="number" min="2020" max="2100" class="form-control" value="@DateTime.Now.Year" required />
                <span asp-validation-for="Anio" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">Salario Bruto ($)</label>
                <input asp-for="SalarioBruto" type="number" step="0.01" min="0.01" class="form-control" placeholder="0.00" required />
                <span asp-validation-for="SalarioBruto" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">Deducciones / Descuentos ($)</label>
                <input asp-for="Deducciones" type="number" step="0.01" min="0.00" class="form-control" placeholder="0.00" />
                <span asp-validation-for="Deducciones" class="text-danger small"></span>
            </div>
            <div class="col-md-12">
                <label class="form-label fw-semibold">Fecha Programada de Pago</label>
                <input asp-for="FechaPago" type="date" class="form-control" required />
                <span asp-validation-for="FechaPago" class="text-danger small"></span>
            </div>
            <div class="col-12 text-end mt-4">
                <a asp-area="RRHH" asp-controller="Nomina" asp-action="Index" class="btn btn-outline-secondary me-2">Cancelar</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Guardar Nómina</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}