@model IEnumerable<VITALIA.Models.Rrhh.SolicitudPermiso>

@{
    ViewData["Title"] = "Gestión de Permisos";
}

<div class="vitalia-banner mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-calendar2-check me-2"></i>Permisos y Licencias</h2>
        <p class="text-muted mb-0">Administración de vacaciones, ausencias médicas e incidencias del personal.</p>
    </div>
    <div>
        <a asp-area="RRHH" asp-controller="Dashboard" asp-action="Index" class="btn btn-light btn-sm me-2">Volver al Panel</a>
        <a asp-area="RRHH" asp-controller="Permisos" asp-action="Crear" class="btn btn-vitalia btn-sm"><i class="bi bi-plus-lg me-1"></i>Nueva Solicitud</a>
    </div>
</div>

<div class="vitalia-card-pro p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Empleado</th>
                    <th>Motivo</th>
                    <th>Fecha Inicio</th>
                    <th>Fecha Fin</th>
                    <th>Observación</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No hay solicitudes de permiso registradas.</td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-dark">
                            @item.IdEmpleadoNavigation?.Nombre @item.IdEmpleadoNavigation?.Apellido
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@item.TipoMotivo</span>
                        </td>
                        <td>@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                        <td>@item.FechaFin.ToString("dd/MM/yyyy")</td>
                        <td><small class="text-muted">@(item.Observacion ?? "-")</small></td>
                        <td>
                            @if (item.Estado == "Aprobado")
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-circle-fill me-1"></i>Aprobado</span>
                            }
                            else if (item.Estado == "Rechazado")
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle"><i class="bi bi-x-circle-fill me-1"></i>Rechazado</span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle"><i class="bi bi-clock-history me-1"></i>Pendiente</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (item.Estado == "Pendiente")
                            {
                                <form asp-area="RRHH" asp-controller="Permisos" asp-action="CambiarEstado" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.IdPermiso" />
                                    <button type="button" value="Aprobado" class="btn btn-sm btn-outline-success me-1 btn-estado-permiso" title="Aprobar Permiso">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                    <button type="button" value="Rechazado" class="btn btn-sm btn-outline-danger btn-estado-permiso" title="Rechazar Permiso">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".btn-estado-permiso").forEach(button => {
                button.addEventListener("click", function () {
                    const form = this.closest("form");
                    const accion = this.value;
                    const esAprobar = accion === 'Aprobado';

                    Swal.fire({
                        title: esAprobar ? '¿Aprobar Permiso?' : '¿Rechazar Permiso?',
                        text: `La solicitud cambiará a estado ${accion.toLowerCase()}.`,
                        icon: esAprobar ? 'question' : 'warning',
                        showCancelButton: true,
                        confirmButtonColor: esAprobar ? '#198754' : '#dc3545',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: esAprobar ? 'Sí, aprobar' : 'Sí, rechazar',
                        cancelButtonText: 'Cancelar',
                        reverseButtons: true,
                        customClass: {
                            popup: 'rounded-4 shadow',
                            confirmButton: `btn ${esAprobar ? 'btn-success' : 'btn-danger'} px-4 mx-1`,
                            cancelButton: 'btn btn-secondary px-4 mx-1'
                        },
                        buttonsStyling: false
                    }).then((result) => {
                        if (result.isConfirmed) {
                            const inputEstado = document.createElement("input");
                            inputEstado.type = "hidden";
                            inputEstado.name = "estado";
                            inputEstado.value = accion;
                            form.appendChild(inputEstado);
                            form.submit();
                        }
                    });
                });
            });
        });
    </script>
}