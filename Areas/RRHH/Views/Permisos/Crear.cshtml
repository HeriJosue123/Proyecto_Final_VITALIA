@model VITALIA.Models.Rrhh.SolicitudPermiso

@{
    ViewData["Title"] = "Solicitar Permiso";
}

<div class="vitalia-banner mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-calendar-plus me-2"></i>Nueva Solicitud de Permiso</h2>
        <p class="text-muted mb-0">Registre ausencias, licencias médicas o vacaciones del personal.</p>
    </div>
    <a asp-area="RRHH" asp-controller="Permisos" asp-action="Index" class="btn btn-light btn-sm">Cancelar</a>
</div>

<div class="vitalia-card-pro p-4" style="max-width: 700px; margin: 0 auto;">
    <form asp-area="RRHH" asp-controller="Permisos" asp-action="Crear" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

        <div class="row g-3">
            <div class="col-md-12">
                <label class="form-label fw-semibold">Empleado</label>
                <select asp-for="IdEmpleado" asp-items="ViewBag.Empleados" class="form-select" required>
                    <option value="">-- Seleccione Empleado --</option>
                </select>
                <span asp-validation-for="IdEmpleado" class="text-danger small"></span>
            </div>
            <div class="col-md-12">
                <label class="form-label fw-semibold">Motivo / Tipo de Licencia</label>
                <select asp-for="TipoMotivo" class="form-select" required>
                    <option value="">-- Seleccione Motivo --</option>
                    <option value="Vacaciones">Vacaciones</option>
                    <option value="Incapacidad Médica">Incapacidad Médica</option>
                    <option value="Permiso Personal">Permiso Personal</option>
                    <option value="Duelo / Luto">Duelo / Luto</option>
                    <option value="Maternidad / Paternidad">Maternidad / Paternidad</option>
                </select>
                <span asp-validation-for="TipoMotivo" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">Fecha de Inicio</label>
                <input asp-for="FechaInicio" type="date" class="form-control" required />
                <span asp-validation-for="FechaInicio" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">Fecha de Fin</label>
                <input asp-for="FechaFin" type="date" class="form-control" required />
                <span asp-validation-for="FechaFin" class="text-danger small"></span>
            </div>
            <div class="col-md-12">
                <label class="form-label fw-semibold">Observaciones / Justificación</label>
                <textarea asp-for="Observacion" class="form-control" rows="3" maxlength="500" placeholder="Detalles de la solicitud..."></textarea>
                <span asp-validation-for="Observacion" class="text-danger small"></span>
            </div>
            <div class="col-12 text-end mt-4">
                <a asp-area="RRHH" asp-controller="Permisos" asp-action="Index" class="btn btn-outline-secondary me-2">Cancelar</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Guardar Solicitud</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}